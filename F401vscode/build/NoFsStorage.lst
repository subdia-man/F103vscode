 307:libs/etl/map.h ****     //*************************************************************************
 308:libs/etl/map.h ****     /// Rotate two nodes at the position provided the to balance the tree
 309:libs/etl/map.h ****     //*************************************************************************
 310:libs/etl/map.h ****     void rotate_2node(Node*& position, uint_least8_t dir)
 311:libs/etl/map.h ****     {
 312:libs/etl/map.h ****       //     A            C             A          B
 313:libs/etl/map.h ****       //   B   C   ->   A   E   OR    B   C  ->  D   A
 314:libs/etl/map.h ****       //      D E      B D           D E            E C
 315:libs/etl/map.h ****       // C (new position) becomes the root
 316:libs/etl/map.h ****       // A (position) takes ownership of D as its children[kRight] child
 317:libs/etl/map.h ****       // C (new position) takes ownership of A as its left child
 318:libs/etl/map.h ****       //                 OR
 319:libs/etl/map.h ****       // B (new position) becomes the root
 320:libs/etl/map.h ****       // A (position) takes ownership of E as its left child
 321:libs/etl/map.h ****       // B (new position) takes ownership of A as its right child
 322:libs/etl/map.h **** 
 323:libs/etl/map.h ****       // Capture new root
 324:libs/etl/map.h ****       Node* new_root = position->children[dir];
 325:libs/etl/map.h ****       // Replace position's previous child with new root's other child
 326:libs/etl/map.h ****       position->children[dir] = new_root->children[1 - dir];
 327:libs/etl/map.h ****       // New root now becomes parent of current position
 328:libs/etl/map.h ****       new_root->children[1 - dir] = position;
 329:libs/etl/map.h ****       // Clear weight factor from current position
 330:libs/etl/map.h ****       position->weight = uint_least8_t(kNeither);
 331:libs/etl/map.h ****       // Newly detached right now becomes current position
 332:libs/etl/map.h ****       position = new_root;
 333:libs/etl/map.h ****       // Clear weight factor from new root
 334:libs/etl/map.h ****       position->weight = uint_least8_t(kNeither);
 335:libs/etl/map.h ****     }
 336:libs/etl/map.h **** 
 337:libs/etl/map.h ****     //*************************************************************************
 338:libs/etl/map.h ****     /// Rotate three nodes at the position provided the to balance the tree
 339:libs/etl/map.h ****     //*************************************************************************
 340:libs/etl/map.h ****     void rotate_3node(Node*& position, uint_least8_t dir, uint_least8_t third)
 341:libs/etl/map.h ****     {
 342:libs/etl/map.h ****       //        --A--             --E--            --A--             --D--
 343:libs/etl/map.h ****       //      _B_    C    ->     B     A    OR    B    _C_   ->     A     C
 344:libs/etl/map.h ****       //     D   E              D F   G C             D   E        B F   G E
 345:libs/etl/map.h ****       //        F G                                  F G
 346:libs/etl/map.h ****       // E (new position) becomes the root
 347:libs/etl/map.h ****       // B (position) takes ownership of F as its left child
 348:libs/etl/map.h ****       // A takes ownership of G as its right child
 349:libs/etl/map.h ****       //                  OR
 350:libs/etl/map.h ****       // D (new position) becomes the root
 351:libs/etl/map.h ****       // A (position) takes ownership of F as its right child
 352:libs/etl/map.h ****       // C takes ownership of G as its left child
 353:libs/etl/map.h **** 
 354:libs/etl/map.h ****       // Capture new root (either E or D depending on dir)
 355:libs/etl/map.h ****       Node* new_root = position->children[dir]->children[1 - dir];
 356:libs/etl/map.h ****       // Set weight factor for B or C based on F or G existing and being a
 357:libs/etl/map.h ****       // different than dir
 358:libs/etl/map.h ****       position->children[dir]->weight = third != uint_least8_t(kNeither) && third != dir ? dir : ui
 359:libs/etl/map.h **** 
ARM GAS  C:\Users\subdia\AppData\Local\Temp\ccrUWOoq.s 			page 95


 360:libs/etl/map.h ****       // Detach new root from its tree (replace with new roots child)
 361:libs/etl/map.h ****       position->children[dir]->children[1 - dir] = new_root->children[dir];
 362:libs/etl/map.h ****       // Attach current left tree to new root
 363:libs/etl/map.h ****       new_root->children[dir] = position->children[dir];
 364:libs/etl/map.h ****       // Set weight factor for A based on F or G
 365:libs/etl/map.h ****       position->weight = third != uint_least8_t(kNeither) && third == dir ? 1 - dir : uint_least8_t
 366:libs/etl/map.h **** 
 367:libs/etl/map.h ****       // Move new root's right tree to current roots left tree
 368:libs/etl/map.h ****       position->children[dir] = new_root->children[1 - dir];
 369:libs/etl/map.h ****       // Attach current root to new roots right tree
 370:libs/etl/map.h ****       new_root->children[1 - dir] = position;
 371:libs/etl/map.h ****       // Replace current position with new root
 372:libs/etl/map.h ****       position = new_root;
 373:libs/etl/map.h ****       // Clear weight factor for new current position
 374:libs/etl/map.h ****       position->weight = uint_least8_t(kNeither);
 375:libs/etl/map.h ****     }
 376:libs/etl/map.h **** 
 377:libs/etl/map.h ****     //*************************************************************************
 378:libs/etl/map.h ****     /// Find the node whose key would go before all the other keys from the
 379:libs/etl/map.h ****     /// position provided
 380:libs/etl/map.h ****     //*************************************************************************
 381:libs/etl/map.h ****     Node* find_limit_node(Node* position, const int8_t dir) const
 382:libs/etl/map.h ****     {
 383:libs/etl/map.h ****       // Something at this position and in the direction specified? keep going
 384:libs/etl/map.h ****       Node* limit_node = position;
 385:libs/etl/map.h ****       while (limit_node && limit_node->children[dir])
 386:libs/etl/map.h ****       {
 387:libs/etl/map.h ****         limit_node = limit_node->children[dir];
 388:libs/etl/map.h ****       }
 389:libs/etl/map.h **** 
 390:libs/etl/map.h ****       // Return the limit node position found
 391:libs/etl/map.h ****       return limit_node;
 392:libs/etl/map.h ****     }
 393:libs/etl/map.h **** 
 394:libs/etl/map.h ****     //*************************************************************************
 395:libs/etl/map.h ****     /// Find the node whose key would go before all the other keys from the
 396:libs/etl/map.h ****     /// position provided
 397:libs/etl/map.h ****     //*************************************************************************
 398:libs/etl/map.h ****     const Node* find_limit_node(const Node* position, const int8_t dir) const
 399:libs/etl/map.h ****     {
 400:libs/etl/map.h ****       // Something at this position and in the direction specified? keep going
 401:libs/etl/map.h ****       const Node* limit_node = position;
 402:libs/etl/map.h ****       while (limit_node && limit_node->children[dir])
 403:libs/etl/map.h ****       {
 404:libs/etl/map.h ****         limit_node = limit_node->children[dir];
 405:libs/etl/map.h ****       }
 406:libs/etl/map.h **** 
 407:libs/etl/map.h ****       // Return the limit node position found
 408:libs/etl/map.h ****       return limit_node;
 409:libs/etl/map.h ****     }
 410:libs/etl/map.h **** 
 411:libs/etl/map.h ****     //*************************************************************************
 412:libs/etl/map.h ****     /// Attach the provided node to the position provided
 413:libs/etl/map.h ****     //*************************************************************************
 414:libs/etl/map.h ****     void attach_node(Node*& position, Node& node)
 415:libs/etl/map.h ****     {
 416:libs/etl/map.h ****       // Mark new node as leaf on attach to tree at position provided
ARM GAS  C:\Users\subdia\AppData\Local\Temp\ccrUWOoq.s 			page 96


 417:libs/etl/map.h ****       node.mark_as_leaf();
 418:libs/etl/map.h **** 
 419:libs/etl/map.h ****       // Add the node here
 420:libs/etl/map.h ****       position = &node;
 421:libs/etl/map.h **** 
 422:libs/etl/map.h ****       // One more.
 423:libs/etl/map.h ****       ++current_size;
 424:libs/etl/map.h ****     }
 425:libs/etl/map.h **** 
 426:libs/etl/map.h ****     //*************************************************************************
 427:libs/etl/map.h ****     /// Detach the node at the position provided
 428:libs/etl/map.h ****     //*************************************************************************
 429:libs/etl/map.h ****     void detach_node(Node*& position, Node*& replacement)
 430:libs/etl/map.h ****     {
 431:libs/etl/map.h ****       // Make temporary copy of actual nodes involved because we might lose
 432:libs/etl/map.h ****       // their references in the process (e.g. position is the same as
 433:libs/etl/map.h ****       // replacement or replacement is a child of position)
 434:libs/etl/map.h ****       Node* detached = position;
 435:libs/etl/map.h ****       Node* swap     = replacement;
 436:libs/etl/map.h **** 
 437:libs/etl/map.h ****       // Update current position to point to swap (replacement) node first
 438:libs/etl/map.h ****       position = swap;
 439:libs/etl/map.h **** 
 440:libs/etl/map.h ****       // Update replacement node to point to child in opposite direction
 441:libs/etl/map.h ****       // otherwise we might lose the other child of the swap node
 442:libs/etl/map.h ****       replacement = swap->children[1 - swap->dir];
 443:libs/etl/map.h **** 
 444:libs/etl/map.h ****       // Point swap node to detached node's children and weight
 445:libs/etl/map.h ****       swap->children[kLeft]  = detached->children[kLeft];
 446:libs/etl/map.h ****       swap->children[kRight] = detached->children[kRight];
 447:libs/etl/map.h ****       swap->weight           = detached->weight;
 448:libs/etl/map.h ****     }
 449:libs/etl/map.h **** 
 450:libs/etl/map.h ****     size_type       current_size; ///< The number of the used nodes.
 451:libs/etl/map.h ****     const size_type CAPACITY;     ///< The maximum size of the map.
 452:libs/etl/map.h ****     Node*           root_node;    ///< The node that acts as the map root.
 453:libs/etl/map.h ****     ETL_DECLARE_DEBUG_COUNT;
 454:libs/etl/map.h ****   };
