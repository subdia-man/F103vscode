 210:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** int8_t NoFsStorage::ReadCfgRecordNextPart(uint8_t* data, size_t size) {
 211:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	if(!_readSession.isOpened) {
 212:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 		return RES_FAIL;
 213:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	}
 214:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	//check if the rest of file bigger than size
 215:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	if(_readSession.toBeReadBytes - _readSession.readBytes < (uint16_t)size) {
 216:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 		size = (_readSession.toBeReadBytes - _readSession.readBytes);
 217:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	}
 218:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	_flashDevice.W25QxxReadBytes(data, _readSession.currentAddress, size);
 219:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	_readSession.readBytes += size;
 220:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	_readSession.currentAddress += size;
 221:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	if(_readSession.readBytes == _readSession.toBeReadBytes) {
 222:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 		CloseReadSession(&_readSession);
 223:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	}
 224:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	return RES_OK;
 225:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** }
 226:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 
 227:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** ReadSession_t NoFsStorage::StartNewReadSession(uint32_t uid) {
 228:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	ReadSession_t session;
 229:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	ResetReadSession(&session);
 230:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	for (uint8_t i = 0; i < _fileStorageInfo.fUIDs.size(); i++) {
 231:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 		if(_fileStorageInfo.fUIDs.at(i) == uid) {
 232:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 			session.currentRecordIndex = i;
 233:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 			session.startAddress = session.currentAddress = _fileStorageInfo.fAddresses.at(i);
 234:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 			session.toBeReadBytes = _fileStorageInfo.fSizes.at(i);
 235:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 			break;
 236:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 		}
 237:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	}
 238:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	session.isOpened = true;
 239:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	return session;
 240:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** }
