 251:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 
 252:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** int8_t NoFsStorage::DeleteRecord(uint32_t uid) {
 253:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	//start new delete session and define file's data: start address, file size, start and end sectors
 254:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	_deleteSession = StartNewDeleteSession(uid);
 255:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	if(_deleteSession.startAddress == 0 || _deleteSession.startSector == 0 || _deleteSession.endSector
 256:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 		_deleteSession.recordSize == 0) {
 257:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 		return RES_FAIL;
 258:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	}
 259:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	//then erase all sectors related to the file being deleted
 260:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	for (uint16_t i = _deleteSession.startSector; i < _deleteSession.endSector; i++) {
 261:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 		_flashDevice.W25QxxEraseSector(i);
 262:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	}
 263:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	//zero all fields at the storage info related to this file
 264:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	_fileStorageInfo.fAddresses.at(_deleteSession.currentRecordIndex) = 0;
 265:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	_fileStorageInfo.fSizes.at(_deleteSession.currentRecordIndex) = 0;
 266:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	_fileStorageInfo.fUIDs.at(_deleteSession.currentRecordIndex) = 0;
 267:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	if (_fileStorageInfo.filesNumber > 0) {
 268:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 		_fileStorageInfo.filesNumber--;
 269:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	}
 270:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	if (_fileStorageInfo.memoryRecordedVolume > 0) {
 271:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 		_fileStorageInfo.memoryRecordedVolume -= _deleteSession.recordSize;
 272:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	}
 273:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	ResetDeleteSession(&_deleteSession);
 274:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	//store renewed storage info
 275:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	WriteStorageInfo(&_fileStorageInfo);
 276:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	return RES_OK;
 277:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** }
 278:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 
 279:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** DeleteRecordSession_t NoFsStorage::StartNewDeleteSession(uint32_t uid) {
 280:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	DeleteRecordSession_t session;
 281:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	ResetDeleteSession(&session);
 282:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	for (uint8_t i = 0; i < _fileStorageInfo.fUIDs.size(); i++) {
 283:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 		if(uid == _fileStorageInfo.fUIDs.at(i)) {
 284:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 			session.currentRecordIndex = i;
 285:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 			break;
 286:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 		}
 287:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	}
 288:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	session.startAddress = _fileStorageInfo.fAddresses.at(session.currentRecordIndex);
 289:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	session.recordSize = _fileStorageInfo.fSizes.at(session.currentRecordIndex);
 290:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	session.startSector = (session.startAddress / _flashDeviceInfo.SectorSize);
 291:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	session.endSector = ((session.startAddress + session.recordSize) / _flashDeviceInfo.SectorSize);
 292:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	if ((session.startAddress + session.recordSize) % _flashDeviceInfo.SectorSize) {
 293:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 		session.endSector++;
 294:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	}
 295:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	session.isOpened = true;
 296:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 	return session;
 297:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** }
 298:Core/Src/CfgFileStorageRoutines/NoFsStorage.cpp **** 
