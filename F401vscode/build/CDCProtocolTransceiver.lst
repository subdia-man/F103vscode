 226:libs/etl/queue.h ****   ///\ingroup queue
 227:libs/etl/queue.h ****   ///\brief This is the base for all queues that contain a particular type.
 228:libs/etl/queue.h ****   ///\details Normally a reference to this type will be taken from a derived
 229:libs/etl/queue.h ****   /// queue. \code
 230:libs/etl/queue.h ****   /// etl::queue<int, 10> myQueue;
 231:libs/etl/queue.h ****   /// etl::iqueue<int>& iQueue = myQueue;
 232:libs/etl/queue.h ****   ///\endcode
 233:libs/etl/queue.h ****   /// \warning This queue cannot be used for concurrent access from multiple
 234:libs/etl/queue.h ****   /// threads. \tparam T The type of value that the queue holds.
 235:libs/etl/queue.h ****   //***************************************************************************
 236:libs/etl/queue.h ****   template <typename T, const size_t MEMORY_MODEL = etl::memory_model::MEMORY_MODEL_LARGE>
 237:libs/etl/queue.h ****   class iqueue : public etl::queue_base<MEMORY_MODEL>
 238:libs/etl/queue.h ****   {
 239:libs/etl/queue.h ****   private:
 240:libs/etl/queue.h **** 
 241:libs/etl/queue.h ****     typedef typename etl::queue_base<MEMORY_MODEL> base_t;
 242:libs/etl/queue.h **** 
 243:libs/etl/queue.h ****   public:
 244:libs/etl/queue.h **** 
 245:libs/etl/queue.h ****     typedef T        value_type;      ///< The type stored in the queue.
 246:libs/etl/queue.h ****     typedef T&       reference;       ///< A reference to the type used in the queue.
 247:libs/etl/queue.h ****     typedef const T& const_reference; ///< A const reference to the type used in the queue.
 248:libs/etl/queue.h **** #if ETL_USING_CPP11
 249:libs/etl/queue.h ****     typedef T&& rvalue_reference; ///< An rvalue reference to the type used in the queue.
