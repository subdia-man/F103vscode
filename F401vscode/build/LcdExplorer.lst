1344:libs/etl/map.h ****     /// Inserts an element into the map if the key does not exist.
1345:libs/etl/map.h ****     /// The mapped value is constructed from args only if insertion takes place.
1346:libs/etl/map.h ****     //*********************************************************************
1347:libs/etl/map.h ****     template <typename... Args>
1348:libs/etl/map.h ****     ETL_OR_STD::pair<iterator, bool> try_emplace(const_key_reference key, Args&&... args)
1349:libs/etl/map.h ****     {
1350:libs/etl/map.h ****       // Check if key already exists
1351:libs/etl/map.h ****       Node* found = find_node(root_node, key);
1352:libs/etl/map.h ****       if (found)
1353:libs/etl/map.h ****       {
1354:libs/etl/map.h ****         return ETL_OR_STD::make_pair(iterator(*this, found), false);
1355:libs/etl/map.h ****       }
1356:libs/etl/map.h **** 
1357:libs/etl/map.h ****       ETL_ASSERT(!full(), ETL_ERROR(map_full));
1358:libs/etl/map.h **** 
1359:libs/etl/map.h ****       // Get next available free node
1360:libs/etl/map.h ****       Data_Node& node = allocate_data_node_emplace(key, etl::forward<Args>(args)...);
1361:libs/etl/map.h **** 
1362:libs/etl/map.h ****       // Obtain the inserted node
1363:libs/etl/map.h ****       Node* inserted_node = insert_node(root_node, node);
1364:libs/etl/map.h **** 
1365:libs/etl/map.h ****       // Insert node into tree and return iterator to new node location in tree
1366:libs/etl/map.h ****       return ETL_OR_STD::make_pair(iterator(*this, inserted_node), true);
1367:libs/etl/map.h ****     }
