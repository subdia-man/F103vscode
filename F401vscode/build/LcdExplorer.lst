 275:libs/etl/utility.h ****   {
 276:libs/etl/utility.h ****     return (etl::is_signed<T>::value == etl::is_signed<U>::value) ? (t == u)
 277:libs/etl/utility.h ****            : etl::is_signed<T>::value                             ? ((t >= T(0)) && (typename etl::
 278:libs/etl/utility.h ****                                                                   : ((u >= U(0)) && (t == typename 
 279:libs/etl/utility.h ****   }
