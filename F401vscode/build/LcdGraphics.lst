  27:Core/Src/LcdGraphics.cpp **** 
  28:Core/Src/LcdGraphics.cpp **** char LcdGraphics::WriteChar(char ch, SSD1306_Font_t Font, SSD1306_COLOR color) {
  29:Core/Src/LcdGraphics.cpp ****     uint32_t i, b, j;
  30:Core/Src/LcdGraphics.cpp ****     
  31:Core/Src/LcdGraphics.cpp ****     // Check if character is valid
  32:Core/Src/LcdGraphics.cpp ****     if (ch < 32 || ch > 126)
  33:Core/Src/LcdGraphics.cpp ****         return 0;
  34:Core/Src/LcdGraphics.cpp ****     
  35:Core/Src/LcdGraphics.cpp ****     // Char width is not equal to font width for proportional font
  36:Core/Src/LcdGraphics.cpp ****     const uint8_t char_width = Font.char_width ? Font.char_width[ch-32] : Font.width;
  37:Core/Src/LcdGraphics.cpp ****     // Check remaining space on current line
  38:Core/Src/LcdGraphics.cpp ****     if (SSD1306_X_SIZE < (SSD1306.CurrentX + char_width) ||
  39:Core/Src/LcdGraphics.cpp ****         SSD1306_Y_SIZE < (SSD1306.CurrentY + Font.height))
  40:Core/Src/LcdGraphics.cpp ****     {
  41:Core/Src/LcdGraphics.cpp ****         // Not enough space on current line
  42:Core/Src/LcdGraphics.cpp ****         return 0;
  43:Core/Src/LcdGraphics.cpp ****     }
  44:Core/Src/LcdGraphics.cpp ****     
  45:Core/Src/LcdGraphics.cpp ****     // Use the font to write
  46:Core/Src/LcdGraphics.cpp ****     for(i = 0; i < Font.height; i++) {
  47:Core/Src/LcdGraphics.cpp ****         b = Font.data[(ch - 32) * Font.height + i];
  48:Core/Src/LcdGraphics.cpp ****         for(j = 0; j < char_width; j++) {
  49:Core/Src/LcdGraphics.cpp ****             if((b << j) & 0x8000)  {
  50:Core/Src/LcdGraphics.cpp ****                 SetPixel(SSD1306.CurrentX + j, (SSD1306.CurrentY + i), (SSD1306_COLOR) color);
  51:Core/Src/LcdGraphics.cpp ****             } else {
  52:Core/Src/LcdGraphics.cpp ****                 SetPixel(SSD1306.CurrentX + j, (SSD1306.CurrentY + i), (SSD1306_COLOR) !color);
  53:Core/Src/LcdGraphics.cpp ****             }
  54:Core/Src/LcdGraphics.cpp ****         }
  55:Core/Src/LcdGraphics.cpp ****     }
  56:Core/Src/LcdGraphics.cpp ****     
ARM GAS  C:\Users\subdia\AppData\Local\Temp\ccQSCeS3.s 			page 4


  57:Core/Src/LcdGraphics.cpp ****     // The current space is now taken
  58:Core/Src/LcdGraphics.cpp ****     SSD1306.CurrentX += char_width;
  59:Core/Src/LcdGraphics.cpp ****     UpdateScreen();
  60:Core/Src/LcdGraphics.cpp ****     // Return written char for validation
  61:Core/Src/LcdGraphics.cpp ****     return ch;
  62:Core/Src/LcdGraphics.cpp **** }
  63:Core/Src/LcdGraphics.cpp **** 
  64:Core/Src/LcdGraphics.cpp **** /* Write full string to screenbuffer */
  65:Core/Src/LcdGraphics.cpp **** char LcdGraphics::WriteString(char* str, SSD1306_Font_t Font, SSD1306_COLOR color) {
  66:Core/Src/LcdGraphics.cpp ****     while (*str) {
  67:Core/Src/LcdGraphics.cpp ****         if (WriteChar(*str, Font, color) != *str) {
  68:Core/Src/LcdGraphics.cpp ****             // Char could not be written
  69:Core/Src/LcdGraphics.cpp ****             return *str;
  70:Core/Src/LcdGraphics.cpp ****         }
  71:Core/Src/LcdGraphics.cpp ****         str++;
  72:Core/Src/LcdGraphics.cpp ****     }
  73:Core/Src/LcdGraphics.cpp ****     return *str;
  74:Core/Src/LcdGraphics.cpp **** }
  75:Core/Src/LcdGraphics.cpp **** 
  76:Core/Src/LcdGraphics.cpp **** void LcdGraphics::DrawHorizontalLine(uint8_t startx, uint8_t endx, uint8_t y, SSD1306_COLOR color) 
  77:Core/Src/LcdGraphics.cpp **** 	for (uint8_t i = startx; i< endx; i++) {
  78:Core/Src/LcdGraphics.cpp **** 		SetPixel(i, y, color);
  79:Core/Src/LcdGraphics.cpp **** 	}
  80:Core/Src/LcdGraphics.cpp **** 	UpdateScreen();
  81:Core/Src/LcdGraphics.cpp **** 	return;
  82:Core/Src/LcdGraphics.cpp **** }
  83:Core/Src/LcdGraphics.cpp **** 
  84:Core/Src/LcdGraphics.cpp **** void LcdGraphics::DrawVerticalLine(uint8_t x, uint8_t starty, uint8_t endy, SSD1306_COLOR color) {
  85:Core/Src/LcdGraphics.cpp **** 	for (uint8_t i = starty; i< endy; i++) {
  86:Core/Src/LcdGraphics.cpp **** 		SetPixel(x, i, color);
  87:Core/Src/LcdGraphics.cpp **** 	}
  88:Core/Src/LcdGraphics.cpp **** 	UpdateScreen();
  89:Core/Src/LcdGraphics.cpp **** 	return;
  90:Core/Src/LcdGraphics.cpp **** }
  91:Core/Src/LcdGraphics.cpp **** 
  92:Core/Src/LcdGraphics.cpp **** void LcdGraphics::DrawLine(uint8_t startx, uint8_t endx, 
  93:Core/Src/LcdGraphics.cpp **** 			  uint8_t starty, uint8_t endy, SSD1306_COLOR color) {
  94:Core/Src/LcdGraphics.cpp **** 
  95:Core/Src/LcdGraphics.cpp **** 	float kornerKff = (abs(starty - endy)/abs(startx - endx));
  96:Core/Src/LcdGraphics.cpp **** 	for (uint8_t i = startx; i < endx; i++) {
  97:Core/Src/LcdGraphics.cpp **** 		uint8_t yk = kornerKff*(i - endx) + endy;
  98:Core/Src/LcdGraphics.cpp **** 		SetPixel(i, yk, color);
  99:Core/Src/LcdGraphics.cpp **** 	}
 100:Core/Src/LcdGraphics.cpp **** 	UpdateScreen();
 101:Core/Src/LcdGraphics.cpp **** 	return;
 102:Core/Src/LcdGraphics.cpp **** }
 103:Core/Src/LcdGraphics.cpp **** 
 104:Core/Src/LcdGraphics.cpp **** void LcdGraphics::DrawRectangle(uint8_t startx, uint8_t endx, uint8_t starty, uint8_t endy, SSD1306
 105:Core/Src/LcdGraphics.cpp ****     DrawHorizontalLine(startx, endx, starty, color);
 106:Core/Src/LcdGraphics.cpp ****     DrawHorizontalLine(startx, endx, endy, color);
 107:Core/Src/LcdGraphics.cpp ****     DrawVerticalLine(startx, starty, endy, color);
 108:Core/Src/LcdGraphics.cpp ****     DrawVerticalLine(endx, starty, endy, color);
 109:Core/Src/LcdGraphics.cpp ****     return;
 110:Core/Src/LcdGraphics.cpp **** }
