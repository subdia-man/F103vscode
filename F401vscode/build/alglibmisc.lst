5901:libs/alglib/src/alglibmisc.cpp ****     mx = ae_maxreal(ae_fabs(*x, _state), ae_fabs(*y, _state), _state);
5902:libs/alglib/src/alglibmisc.cpp ****     mn = ae_minreal(ae_fabs(*x, _state), ae_fabs(*y, _state), _state);
