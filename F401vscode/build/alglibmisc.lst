7619:libs/alglib/src/alglibmisc.cpp **** It is informational function which allows to get  information  about  node
7620:libs/alglib/src/alglibmisc.cpp **** type. Node index is given by integer value, with 0  corresponding  to root
7621:libs/alglib/src/alglibmisc.cpp **** node and other node indexes obtained via exploration.
7622:libs/alglib/src/alglibmisc.cpp **** 
7623:libs/alglib/src/alglibmisc.cpp **** You should not expect that serialization/unserialization will retain  node
7624:libs/alglib/src/alglibmisc.cpp **** indexes. You should keep in  mind  that  future  versions  of  ALGLIB  may
7625:libs/alglib/src/alglibmisc.cpp **** introduce new node types.
7626:libs/alglib/src/alglibmisc.cpp **** 
7627:libs/alglib/src/alglibmisc.cpp **** OUTPUT VALUES:
7628:libs/alglib/src/alglibmisc.cpp ****     NodeType    -   node type:
7629:libs/alglib/src/alglibmisc.cpp ****                     * 0 corresponds to leaf node, which can be explored by
7630:libs/alglib/src/alglibmisc.cpp ****                       kdtreeexploreleaf() function
7631:libs/alglib/src/alglibmisc.cpp ****                     * 1 corresponds to split node, which can  be  explored
7632:libs/alglib/src/alglibmisc.cpp ****                       by kdtreeexploresplit() function
7633:libs/alglib/src/alglibmisc.cpp **** 
7634:libs/alglib/src/alglibmisc.cpp ****   -- ALGLIB --
7635:libs/alglib/src/alglibmisc.cpp ****      Copyright 20.06.2016 by Bochkanov Sergey
7636:libs/alglib/src/alglibmisc.cpp **** *************************************************************************/
7637:libs/alglib/src/alglibmisc.cpp **** void kdtreeexplorenodetype(const kdtree* kdt,
7638:libs/alglib/src/alglibmisc.cpp ****      ae_int_t node,
7639:libs/alglib/src/alglibmisc.cpp ****      ae_int_t* nodetype,
7640:libs/alglib/src/alglibmisc.cpp ****      ae_state *_state)
7641:libs/alglib/src/alglibmisc.cpp **** {
7642:libs/alglib/src/alglibmisc.cpp **** 
7643:libs/alglib/src/alglibmisc.cpp ****     *nodetype = 0;
7644:libs/alglib/src/alglibmisc.cpp **** 
7645:libs/alglib/src/alglibmisc.cpp ****     ae_assert(node>=0, "KDTreeExploreNodeType: incorrect node", _state);
7646:libs/alglib/src/alglibmisc.cpp ****     ae_assert(node<kdt->nodes.cnt, "KDTreeExploreNodeType: incorrect node", _state);
7647:libs/alglib/src/alglibmisc.cpp ****     if( kdt->nodes.ptr.p_int[node]>0 )
7648:libs/alglib/src/alglibmisc.cpp ****     {
7649:libs/alglib/src/alglibmisc.cpp ****         
7650:libs/alglib/src/alglibmisc.cpp ****         /*
7651:libs/alglib/src/alglibmisc.cpp ****          * Leaf node
7652:libs/alglib/src/alglibmisc.cpp ****          */
7653:libs/alglib/src/alglibmisc.cpp ****         *nodetype = 0;
7654:libs/alglib/src/alglibmisc.cpp ****         return;
7655:libs/alglib/src/alglibmisc.cpp ****     }
7656:libs/alglib/src/alglibmisc.cpp ****     if( kdt->nodes.ptr.p_int[node]==0 )
7657:libs/alglib/src/alglibmisc.cpp ****     {
7658:libs/alglib/src/alglibmisc.cpp ****         
7659:libs/alglib/src/alglibmisc.cpp ****         /*
7660:libs/alglib/src/alglibmisc.cpp ****          * Split node
7661:libs/alglib/src/alglibmisc.cpp ****          */
7662:libs/alglib/src/alglibmisc.cpp ****         *nodetype = 1;
7663:libs/alglib/src/alglibmisc.cpp ****         return;
7664:libs/alglib/src/alglibmisc.cpp ****     }
7665:libs/alglib/src/alglibmisc.cpp ****     ae_assert(ae_false, "KDTreeExploreNodeType: integrity check failure", _state);
7666:libs/alglib/src/alglibmisc.cpp **** }
