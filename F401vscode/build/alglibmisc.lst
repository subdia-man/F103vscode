6966:libs/alglib/src/alglibmisc.cpp **** /*************************************************************************
6967:libs/alglib/src/alglibmisc.cpp **** Box query: all points within user-specified box, using thread-local buffer.
6968:libs/alglib/src/alglibmisc.cpp **** 
6969:libs/alglib/src/alglibmisc.cpp **** You can call this function from multiple threads for same kd-tree instance,
6970:libs/alglib/src/alglibmisc.cpp **** assuming that different instances of buffer object are passed to different
6971:libs/alglib/src/alglibmisc.cpp **** threads.
6972:libs/alglib/src/alglibmisc.cpp **** 
6973:libs/alglib/src/alglibmisc.cpp **** INPUT PARAMETERS
6974:libs/alglib/src/alglibmisc.cpp ****     KDT         -   KD-tree
6975:libs/alglib/src/alglibmisc.cpp ****     Buf         -   request buffer  object  created  for  this  particular
6976:libs/alglib/src/alglibmisc.cpp ****                     instance of kd-tree structure with kdtreecreaterequestbuffer()
6977:libs/alglib/src/alglibmisc.cpp ****                     function.
6978:libs/alglib/src/alglibmisc.cpp ****     BoxMin      -   lower bounds, array[0..NX-1].
6979:libs/alglib/src/alglibmisc.cpp ****     BoxMax      -   upper bounds, array[0..NX-1].
6980:libs/alglib/src/alglibmisc.cpp **** 
6981:libs/alglib/src/alglibmisc.cpp **** RESULT
6982:libs/alglib/src/alglibmisc.cpp ****     number of actual neighbors found (in [0,N]).
6983:libs/alglib/src/alglibmisc.cpp **** 
ARM GAS  C:\Users\subdia\AppData\Local\Temp\ccLx3Sbr.s 			page 191


6984:libs/alglib/src/alglibmisc.cpp **** This  subroutine  performs  query  and  stores  its result in the internal
6985:libs/alglib/src/alglibmisc.cpp **** structures  of  the  buffer object. You can use following  subroutines  to
6986:libs/alglib/src/alglibmisc.cpp **** obtain these results (pay attention to "ts" in their names):
6987:libs/alglib/src/alglibmisc.cpp **** * KDTreeTsQueryResultsX() to get X-values
6988:libs/alglib/src/alglibmisc.cpp **** * KDTreeTsQueryResultsXY() to get X- and Y-values
6989:libs/alglib/src/alglibmisc.cpp **** * KDTreeTsQueryResultsTags() to get tag values
6990:libs/alglib/src/alglibmisc.cpp **** * KDTreeTsQueryResultsDistances() returns zeros for this query
6991:libs/alglib/src/alglibmisc.cpp ****     
6992:libs/alglib/src/alglibmisc.cpp **** NOTE: this particular query returns unordered results, because there is no
6993:libs/alglib/src/alglibmisc.cpp ****       meaningful way of  ordering  points.  Furthermore,  no 'distance' is
6994:libs/alglib/src/alglibmisc.cpp ****       associated with points - it is either INSIDE  or OUTSIDE (so request
6995:libs/alglib/src/alglibmisc.cpp ****       for distances will return zeros).
6996:libs/alglib/src/alglibmisc.cpp ****     
6997:libs/alglib/src/alglibmisc.cpp **** IMPORTANT: kd-tree buffer should be used only with  KD-tree  object  which
6998:libs/alglib/src/alglibmisc.cpp ****            was used to initialize buffer. Any attempt to use biffer   with
6999:libs/alglib/src/alglibmisc.cpp ****            different object is dangerous - you  may  get  integrity  check
7000:libs/alglib/src/alglibmisc.cpp ****            failure (exception) because sizes of internal arrays do not fit
7001:libs/alglib/src/alglibmisc.cpp ****            to dimensions of KD-tree structure.
7002:libs/alglib/src/alglibmisc.cpp **** 
7003:libs/alglib/src/alglibmisc.cpp ****   -- ALGLIB --
7004:libs/alglib/src/alglibmisc.cpp ****      Copyright 14.05.2016 by Bochkanov Sergey
7005:libs/alglib/src/alglibmisc.cpp **** *************************************************************************/
7006:libs/alglib/src/alglibmisc.cpp **** ae_int_t kdtreetsquerybox(const kdtree* kdt,
7007:libs/alglib/src/alglibmisc.cpp ****      kdtreerequestbuffer* buf,
7008:libs/alglib/src/alglibmisc.cpp ****      /* Real    */ const ae_vector* boxmin,
7009:libs/alglib/src/alglibmisc.cpp ****      /* Real    */ const ae_vector* boxmax,
7010:libs/alglib/src/alglibmisc.cpp ****      ae_state *_state)
7011:libs/alglib/src/alglibmisc.cpp **** {
7012:libs/alglib/src/alglibmisc.cpp ****     ae_int_t j;
7013:libs/alglib/src/alglibmisc.cpp ****     ae_int_t result;
7014:libs/alglib/src/alglibmisc.cpp **** 
7015:libs/alglib/src/alglibmisc.cpp **** 
7016:libs/alglib/src/alglibmisc.cpp ****     ae_assert(boxmin->cnt>=kdt->nx, "KDTreeTsQueryBox: Length(BoxMin)<NX!", _state);
7017:libs/alglib/src/alglibmisc.cpp ****     ae_assert(boxmax->cnt>=kdt->nx, "KDTreeTsQueryBox: Length(BoxMax)<NX!", _state);
7018:libs/alglib/src/alglibmisc.cpp ****     ae_assert(isfinitevector(boxmin, kdt->nx, _state), "KDTreeTsQueryBox: BoxMin contains infinite 
7019:libs/alglib/src/alglibmisc.cpp ****     ae_assert(isfinitevector(boxmax, kdt->nx, _state), "KDTreeTsQueryBox: BoxMax contains infinite 
7020:libs/alglib/src/alglibmisc.cpp ****     
7021:libs/alglib/src/alglibmisc.cpp ****     /*
7022:libs/alglib/src/alglibmisc.cpp ****      * Check consistency of request buffer
7023:libs/alglib/src/alglibmisc.cpp ****      */
7024:libs/alglib/src/alglibmisc.cpp ****     nearestneighbor_checkrequestbufferconsistency(kdt, buf, _state);
7025:libs/alglib/src/alglibmisc.cpp ****     
7026:libs/alglib/src/alglibmisc.cpp ****     /*
7027:libs/alglib/src/alglibmisc.cpp ****      * Quick exit for degenerate boxes
7028:libs/alglib/src/alglibmisc.cpp ****      */
7029:libs/alglib/src/alglibmisc.cpp ****     for(j=0; j<=kdt->nx-1; j++)
7030:libs/alglib/src/alglibmisc.cpp ****     {
7031:libs/alglib/src/alglibmisc.cpp ****         if( ae_fp_greater(boxmin->ptr.p_double[j],boxmax->ptr.p_double[j]) )
7032:libs/alglib/src/alglibmisc.cpp ****         {
7033:libs/alglib/src/alglibmisc.cpp ****             buf->kcur = 0;
7034:libs/alglib/src/alglibmisc.cpp ****             result = 0;
7035:libs/alglib/src/alglibmisc.cpp ****             return result;
7036:libs/alglib/src/alglibmisc.cpp ****         }
7037:libs/alglib/src/alglibmisc.cpp ****     }
7038:libs/alglib/src/alglibmisc.cpp ****     
7039:libs/alglib/src/alglibmisc.cpp ****     /*
7040:libs/alglib/src/alglibmisc.cpp ****      * Prepare parameters
ARM GAS  C:\Users\subdia\AppData\Local\Temp\ccLx3Sbr.s 			page 192


7041:libs/alglib/src/alglibmisc.cpp ****      */
7042:libs/alglib/src/alglibmisc.cpp ****     for(j=0; j<=kdt->nx-1; j++)
7043:libs/alglib/src/alglibmisc.cpp ****     {
7044:libs/alglib/src/alglibmisc.cpp ****         buf->boxmin.ptr.p_double[j] = boxmin->ptr.p_double[j];
7045:libs/alglib/src/alglibmisc.cpp ****         buf->boxmax.ptr.p_double[j] = boxmax->ptr.p_double[j];
7046:libs/alglib/src/alglibmisc.cpp ****         buf->curboxmin.ptr.p_double[j] = boxmin->ptr.p_double[j];
7047:libs/alglib/src/alglibmisc.cpp ****         buf->curboxmax.ptr.p_double[j] = boxmax->ptr.p_double[j];
7048:libs/alglib/src/alglibmisc.cpp ****     }
7049:libs/alglib/src/alglibmisc.cpp ****     buf->kcur = 0;
7050:libs/alglib/src/alglibmisc.cpp ****     
7051:libs/alglib/src/alglibmisc.cpp ****     /*
7052:libs/alglib/src/alglibmisc.cpp ****      * call recursive search
7053:libs/alglib/src/alglibmisc.cpp ****      */
7054:libs/alglib/src/alglibmisc.cpp ****     nearestneighbor_kdtreequeryboxrec(kdt, buf, 0, _state);
7055:libs/alglib/src/alglibmisc.cpp ****     result = buf->kcur;
7056:libs/alglib/src/alglibmisc.cpp ****     return result;
7057:libs/alglib/src/alglibmisc.cpp **** }
7058:libs/alglib/src/alglibmisc.cpp **** 
