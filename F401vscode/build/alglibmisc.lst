6098:libs/alglib/src/alglibmisc.cpp ****     }
6099:libs/alglib/src/alglibmisc.cpp ****     i = hqrnduniformi(state, n-1, _state);
6100:libs/alglib/src/alglibmisc.cpp ****     mn = x->ptr.p_double[i];
6101:libs/alglib/src/alglibmisc.cpp ****     mx = x->ptr.p_double[i+1];
6102:libs/alglib/src/alglibmisc.cpp ****     ae_assert(ae_fp_greater_eq(mx,mn), "HQRNDDiscrete: X is not sorted by ascending", _state);
6103:libs/alglib/src/alglibmisc.cpp ****     if( ae_fp_neq(mx,mn) )
