6372:libs/alglib/src/alglibmisc.cpp ****      kdtreerequestbuffer* buf,
6373:libs/alglib/src/alglibmisc.cpp ****      ae_state *_state)
6374:libs/alglib/src/alglibmisc.cpp **** {
6375:libs/alglib/src/alglibmisc.cpp **** 
6376:libs/alglib/src/alglibmisc.cpp ****     _kdtreerequestbuffer_clear(buf);
6377:libs/alglib/src/alglibmisc.cpp **** 
6378:libs/alglib/src/alglibmisc.cpp ****     ae_vector_set_length(&buf->x, kdt->nx, _state);
6379:libs/alglib/src/alglibmisc.cpp ****     ae_vector_set_length(&buf->boxmin, kdt->nx, _state);
6380:libs/alglib/src/alglibmisc.cpp ****     ae_vector_set_length(&buf->boxmax, kdt->nx, _state);
6381:libs/alglib/src/alglibmisc.cpp ****     ae_vector_set_length(&buf->idx, kdt->n, _state);
6382:libs/alglib/src/alglibmisc.cpp ****     ae_vector_set_length(&buf->r, kdt->n, _state);
6383:libs/alglib/src/alglibmisc.cpp ****     ae_vector_set_length(&buf->buf, ae_maxint(kdt->n, kdt->nx, _state), _state);
6384:libs/alglib/src/alglibmisc.cpp ****     ae_vector_set_length(&buf->curboxmin, kdt->nx, _state);
6385:libs/alglib/src/alglibmisc.cpp ****     ae_vector_set_length(&buf->curboxmax, kdt->nx, _state);
6386:libs/alglib/src/alglibmisc.cpp ****     buf->kcur = 0;
