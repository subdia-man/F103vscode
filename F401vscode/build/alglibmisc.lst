5590:libs/alglib/src/alglibmisc.cpp ****     _hqrndstate_clear(state);
5591:libs/alglib/src/alglibmisc.cpp **** 
5592:libs/alglib/src/alglibmisc.cpp ****     s0 = ae_randominteger(hqrnd_hqrndm1, _state);
5593:libs/alglib/src/alglibmisc.cpp ****     s1 = ae_randominteger(hqrnd_hqrndm2, _state);
5594:libs/alglib/src/alglibmisc.cpp ****     hqrndseed(s0, s1, state, _state);
5595:libs/alglib/src/alglibmisc.cpp **** }
5596:libs/alglib/src/alglibmisc.cpp **** 
5597:libs/alglib/src/alglibmisc.cpp **** 
5598:libs/alglib/src/alglibmisc.cpp **** /*************************************************************************
5599:libs/alglib/src/alglibmisc.cpp **** HQRNDState initialization with seed values
5600:libs/alglib/src/alglibmisc.cpp **** 
5601:libs/alglib/src/alglibmisc.cpp ****   -- ALGLIB --
5602:libs/alglib/src/alglibmisc.cpp ****      Copyright 02.12.2009 by Bochkanov Sergey
5603:libs/alglib/src/alglibmisc.cpp **** *************************************************************************/
5604:libs/alglib/src/alglibmisc.cpp **** void hqrndseed(ae_int_t s1,
5605:libs/alglib/src/alglibmisc.cpp ****      ae_int_t s2,
5606:libs/alglib/src/alglibmisc.cpp ****      hqrndstate* state,
5607:libs/alglib/src/alglibmisc.cpp ****      ae_state *_state)
5608:libs/alglib/src/alglibmisc.cpp **** {
5609:libs/alglib/src/alglibmisc.cpp **** 
5610:libs/alglib/src/alglibmisc.cpp ****     _hqrndstate_clear(state);
5611:libs/alglib/src/alglibmisc.cpp **** 
5612:libs/alglib/src/alglibmisc.cpp ****     
5613:libs/alglib/src/alglibmisc.cpp ****     /*
5614:libs/alglib/src/alglibmisc.cpp ****      * Protection against negative seeds:
5615:libs/alglib/src/alglibmisc.cpp ****      *
ARM GAS  C:\Users\subdia\AppData\Local\Temp\ccLx3Sbr.s 			page 167


5616:libs/alglib/src/alglibmisc.cpp ****      *     SEED := -(SEED+1)
5617:libs/alglib/src/alglibmisc.cpp ****      *
5618:libs/alglib/src/alglibmisc.cpp ****      * We can use just "-SEED" because there exists such integer number  N
5619:libs/alglib/src/alglibmisc.cpp ****      * that N<0, -N=N<0 too. (This number is equal to 0x800...000).   Need
5620:libs/alglib/src/alglibmisc.cpp ****      * to handle such seed correctly forces us to use  a  bit  complicated
5621:libs/alglib/src/alglibmisc.cpp ****      * formula.
5622:libs/alglib/src/alglibmisc.cpp ****      */
5623:libs/alglib/src/alglibmisc.cpp ****     if( s1<0 )
5624:libs/alglib/src/alglibmisc.cpp ****     {
5625:libs/alglib/src/alglibmisc.cpp ****         s1 = -(s1+1);
5626:libs/alglib/src/alglibmisc.cpp ****     }
5627:libs/alglib/src/alglibmisc.cpp ****     if( s2<0 )
5628:libs/alglib/src/alglibmisc.cpp ****     {
5629:libs/alglib/src/alglibmisc.cpp ****         s2 = -(s2+1);
5630:libs/alglib/src/alglibmisc.cpp ****     }
5631:libs/alglib/src/alglibmisc.cpp ****     state->s1 = s1%(hqrnd_hqrndm1-1)+1;
5632:libs/alglib/src/alglibmisc.cpp ****     state->s2 = s2%(hqrnd_hqrndm2-1)+1;
5633:libs/alglib/src/alglibmisc.cpp ****     state->magicv = hqrnd_hqrndmagic;
5634:libs/alglib/src/alglibmisc.cpp **** }
5635:libs/alglib/src/alglibmisc.cpp **** 
5636:libs/alglib/src/alglibmisc.cpp **** 
5637:libs/alglib/src/alglibmisc.cpp **** /*************************************************************************
5638:libs/alglib/src/alglibmisc.cpp **** This function generates random real number in (0,1),
5639:libs/alglib/src/alglibmisc.cpp **** not including interval boundaries
5640:libs/alglib/src/alglibmisc.cpp **** 
5641:libs/alglib/src/alglibmisc.cpp **** State structure must be initialized with HQRNDRandomize() or HQRNDSeed().
5642:libs/alglib/src/alglibmisc.cpp **** 
5643:libs/alglib/src/alglibmisc.cpp ****   -- ALGLIB --
5644:libs/alglib/src/alglibmisc.cpp ****      Copyright 02.12.2009 by Bochkanov Sergey
5645:libs/alglib/src/alglibmisc.cpp **** *************************************************************************/
5646:libs/alglib/src/alglibmisc.cpp **** double hqrnduniformr(hqrndstate* state, ae_state *_state)
5647:libs/alglib/src/alglibmisc.cpp **** {
5648:libs/alglib/src/alglibmisc.cpp ****     double result;
5649:libs/alglib/src/alglibmisc.cpp **** 
5650:libs/alglib/src/alglibmisc.cpp **** 
5651:libs/alglib/src/alglibmisc.cpp ****     result = (double)(hqrndintegerbase(state, _state)+1)/(double)(hqrnd_hqrndmax+2);
5652:libs/alglib/src/alglibmisc.cpp ****     return result;
5653:libs/alglib/src/alglibmisc.cpp **** }
5654:libs/alglib/src/alglibmisc.cpp **** 
5655:libs/alglib/src/alglibmisc.cpp **** 
5656:libs/alglib/src/alglibmisc.cpp **** /*************************************************************************
5657:libs/alglib/src/alglibmisc.cpp **** This function generates random integer number in [0, N)
5658:libs/alglib/src/alglibmisc.cpp **** 
5659:libs/alglib/src/alglibmisc.cpp **** 1. State structure must be initialized with HQRNDRandomize() or HQRNDSeed()
5660:libs/alglib/src/alglibmisc.cpp **** 2. N can be any positive number except for very large numbers:
5661:libs/alglib/src/alglibmisc.cpp ****    * close to 2^31 on 32-bit systems
5662:libs/alglib/src/alglibmisc.cpp ****    * close to 2^62 on 64-bit systems
5663:libs/alglib/src/alglibmisc.cpp ****    An exception will be generated if N is too large.
5664:libs/alglib/src/alglibmisc.cpp **** 
5665:libs/alglib/src/alglibmisc.cpp ****   -- ALGLIB --
5666:libs/alglib/src/alglibmisc.cpp ****      Copyright 02.12.2009 by Bochkanov Sergey
5667:libs/alglib/src/alglibmisc.cpp **** *************************************************************************/
5668:libs/alglib/src/alglibmisc.cpp **** ae_int_t hqrnduniformi(hqrndstate* state, ae_int_t n, ae_state *_state)
5669:libs/alglib/src/alglibmisc.cpp **** {
5670:libs/alglib/src/alglibmisc.cpp ****     ae_int_t maxcnt;
5671:libs/alglib/src/alglibmisc.cpp ****     ae_int_t mx;
5672:libs/alglib/src/alglibmisc.cpp ****     ae_int_t a;
ARM GAS  C:\Users\subdia\AppData\Local\Temp\ccLx3Sbr.s 			page 168


5673:libs/alglib/src/alglibmisc.cpp ****     ae_int_t b;
5674:libs/alglib/src/alglibmisc.cpp ****     ae_int_t result;
5675:libs/alglib/src/alglibmisc.cpp **** 
5676:libs/alglib/src/alglibmisc.cpp **** 
5677:libs/alglib/src/alglibmisc.cpp ****     ae_assert(n>0, "HQRNDUniformI: N<=0!", _state);
5678:libs/alglib/src/alglibmisc.cpp ****     maxcnt = hqrnd_hqrndmax+1;
5679:libs/alglib/src/alglibmisc.cpp ****     
5680:libs/alglib/src/alglibmisc.cpp ****     /*
5681:libs/alglib/src/alglibmisc.cpp ****      * Two branches: one for N<=MaxCnt, another for N>MaxCnt.
5682:libs/alglib/src/alglibmisc.cpp ****      */
5683:libs/alglib/src/alglibmisc.cpp ****     if( n>maxcnt )
5684:libs/alglib/src/alglibmisc.cpp ****     {
5685:libs/alglib/src/alglibmisc.cpp ****         
5686:libs/alglib/src/alglibmisc.cpp ****         /*
5687:libs/alglib/src/alglibmisc.cpp ****          * N>=MaxCnt.
5688:libs/alglib/src/alglibmisc.cpp ****          *
5689:libs/alglib/src/alglibmisc.cpp ****          * We have two options here:
5690:libs/alglib/src/alglibmisc.cpp ****          * a) N is exactly divisible by MaxCnt
5691:libs/alglib/src/alglibmisc.cpp ****          * b) N is not divisible by MaxCnt
5692:libs/alglib/src/alglibmisc.cpp ****          *
5693:libs/alglib/src/alglibmisc.cpp ****          * In both cases we reduce problem on interval spanning [0,N)
5694:libs/alglib/src/alglibmisc.cpp ****          * to several subproblems on intervals spanning [0,MaxCnt).
5695:libs/alglib/src/alglibmisc.cpp ****          */
5696:libs/alglib/src/alglibmisc.cpp ****         if( n%maxcnt==0 )
5697:libs/alglib/src/alglibmisc.cpp ****         {
5698:libs/alglib/src/alglibmisc.cpp ****             
5699:libs/alglib/src/alglibmisc.cpp ****             /*
5700:libs/alglib/src/alglibmisc.cpp ****              * N is exactly divisible by MaxCnt.
5701:libs/alglib/src/alglibmisc.cpp ****              *
5702:libs/alglib/src/alglibmisc.cpp ****              * [0,N) range is dividided into N/MaxCnt bins,
5703:libs/alglib/src/alglibmisc.cpp ****              * each of them having length equal to MaxCnt.
5704:libs/alglib/src/alglibmisc.cpp ****              *
5705:libs/alglib/src/alglibmisc.cpp ****              * We generate:
5706:libs/alglib/src/alglibmisc.cpp ****              * * random bin number B
5707:libs/alglib/src/alglibmisc.cpp ****              * * random offset within bin A
5708:libs/alglib/src/alglibmisc.cpp ****              * Both random numbers are generated by recursively
5709:libs/alglib/src/alglibmisc.cpp ****              * calling HQRNDUniformI().
5710:libs/alglib/src/alglibmisc.cpp ****              *
5711:libs/alglib/src/alglibmisc.cpp ****              * Result is equal to A+MaxCnt*B.
5712:libs/alglib/src/alglibmisc.cpp ****              */
5713:libs/alglib/src/alglibmisc.cpp ****             ae_assert(n/maxcnt<=maxcnt, "HQRNDUniformI: N is too large", _state);
5714:libs/alglib/src/alglibmisc.cpp ****             a = hqrnduniformi(state, maxcnt, _state);
5715:libs/alglib/src/alglibmisc.cpp ****             b = hqrnduniformi(state, n/maxcnt, _state);
5716:libs/alglib/src/alglibmisc.cpp ****             result = a+maxcnt*b;
5717:libs/alglib/src/alglibmisc.cpp ****         }
5718:libs/alglib/src/alglibmisc.cpp ****         else
5719:libs/alglib/src/alglibmisc.cpp ****         {
5720:libs/alglib/src/alglibmisc.cpp ****             
5721:libs/alglib/src/alglibmisc.cpp ****             /*
5722:libs/alglib/src/alglibmisc.cpp ****              * N is NOT exactly divisible by MaxCnt.
5723:libs/alglib/src/alglibmisc.cpp ****              *
5724:libs/alglib/src/alglibmisc.cpp ****              * [0,N) range is dividided into Ceil(N/MaxCnt) bins,
5725:libs/alglib/src/alglibmisc.cpp ****              * each of them having length equal to MaxCnt.
5726:libs/alglib/src/alglibmisc.cpp ****              *
5727:libs/alglib/src/alglibmisc.cpp ****              * We generate:
5728:libs/alglib/src/alglibmisc.cpp ****              * * random bin number B in [0, Ceil(N/MaxCnt)-1]
5729:libs/alglib/src/alglibmisc.cpp ****              * * random offset within bin A
ARM GAS  C:\Users\subdia\AppData\Local\Temp\ccLx3Sbr.s 			page 169


5730:libs/alglib/src/alglibmisc.cpp ****              * * if both of what is below is true
5731:libs/alglib/src/alglibmisc.cpp ****              *   1) bin number B is that of the last bin
5732:libs/alglib/src/alglibmisc.cpp ****              *   2) A >= N mod MaxCnt
5733:libs/alglib/src/alglibmisc.cpp ****              *   then we repeat generation of A/B.
5734:libs/alglib/src/alglibmisc.cpp ****              *   This stage is essential in order to avoid bias in the result.
5735:libs/alglib/src/alglibmisc.cpp ****              * * otherwise, we return A*MaxCnt+N
5736:libs/alglib/src/alglibmisc.cpp ****              */
5737:libs/alglib/src/alglibmisc.cpp ****             ae_assert(n/maxcnt+1<=maxcnt, "HQRNDUniformI: N is too large", _state);
5738:libs/alglib/src/alglibmisc.cpp ****             result = -1;
5739:libs/alglib/src/alglibmisc.cpp ****             do
5740:libs/alglib/src/alglibmisc.cpp ****             {
5741:libs/alglib/src/alglibmisc.cpp ****                 a = hqrnduniformi(state, maxcnt, _state);
5742:libs/alglib/src/alglibmisc.cpp ****                 b = hqrnduniformi(state, n/maxcnt+1, _state);
5743:libs/alglib/src/alglibmisc.cpp ****                 if( b==n/maxcnt&&a>=n%maxcnt )
5744:libs/alglib/src/alglibmisc.cpp ****                 {
5745:libs/alglib/src/alglibmisc.cpp ****                     continue;
5746:libs/alglib/src/alglibmisc.cpp ****                 }
5747:libs/alglib/src/alglibmisc.cpp ****                 result = a+maxcnt*b;
5748:libs/alglib/src/alglibmisc.cpp ****             }
5749:libs/alglib/src/alglibmisc.cpp ****             while(result<0);
5750:libs/alglib/src/alglibmisc.cpp ****         }
5751:libs/alglib/src/alglibmisc.cpp ****     }
5752:libs/alglib/src/alglibmisc.cpp ****     else
5753:libs/alglib/src/alglibmisc.cpp ****     {
5754:libs/alglib/src/alglibmisc.cpp ****         
5755:libs/alglib/src/alglibmisc.cpp ****         /*
5756:libs/alglib/src/alglibmisc.cpp ****          * N<=MaxCnt
5757:libs/alglib/src/alglibmisc.cpp ****          *
5758:libs/alglib/src/alglibmisc.cpp ****          * Code below is a bit complicated because we can not simply
5759:libs/alglib/src/alglibmisc.cpp ****          * return "HQRNDIntegerBase() mod N" - it will be skewed for
5760:libs/alglib/src/alglibmisc.cpp ****          * large N's in [0.1*HQRNDMax...HQRNDMax].
5761:libs/alglib/src/alglibmisc.cpp ****          */
5762:libs/alglib/src/alglibmisc.cpp ****         mx = maxcnt-maxcnt%n;
5763:libs/alglib/src/alglibmisc.cpp ****         do
5764:libs/alglib/src/alglibmisc.cpp ****         {
5765:libs/alglib/src/alglibmisc.cpp ****             result = hqrndintegerbase(state, _state);
5766:libs/alglib/src/alglibmisc.cpp ****         }
5767:libs/alglib/src/alglibmisc.cpp ****         while(result>=mx);
5768:libs/alglib/src/alglibmisc.cpp ****         result = result%n;
5769:libs/alglib/src/alglibmisc.cpp ****     }
5770:libs/alglib/src/alglibmisc.cpp ****     return result;
5771:libs/alglib/src/alglibmisc.cpp **** }
5772:libs/alglib/src/alglibmisc.cpp **** 
5773:libs/alglib/src/alglibmisc.cpp **** 
5774:libs/alglib/src/alglibmisc.cpp **** /*************************************************************************
5775:libs/alglib/src/alglibmisc.cpp **** Random number generator: normal numbers
5776:libs/alglib/src/alglibmisc.cpp **** 
5777:libs/alglib/src/alglibmisc.cpp **** This function generates one random number from normal distribution.
5778:libs/alglib/src/alglibmisc.cpp **** Its performance is equal to that of HQRNDNormal2()
5779:libs/alglib/src/alglibmisc.cpp **** 
5780:libs/alglib/src/alglibmisc.cpp **** State structure must be initialized with HQRNDRandomize() or HQRNDSeed().
5781:libs/alglib/src/alglibmisc.cpp **** 
5782:libs/alglib/src/alglibmisc.cpp ****   -- ALGLIB --
5783:libs/alglib/src/alglibmisc.cpp ****      Copyright 02.12.2009 by Bochkanov Sergey
5784:libs/alglib/src/alglibmisc.cpp **** *************************************************************************/
5785:libs/alglib/src/alglibmisc.cpp **** double hqrndnormal(hqrndstate* state, ae_state *_state)
5786:libs/alglib/src/alglibmisc.cpp **** {
ARM GAS  C:\Users\subdia\AppData\Local\Temp\ccLx3Sbr.s 			page 170


5787:libs/alglib/src/alglibmisc.cpp ****     double v1;
5788:libs/alglib/src/alglibmisc.cpp ****     double v2;
5789:libs/alglib/src/alglibmisc.cpp ****     double result;
5790:libs/alglib/src/alglibmisc.cpp **** 
5791:libs/alglib/src/alglibmisc.cpp **** 
5792:libs/alglib/src/alglibmisc.cpp ****     hqrndnormal2(state, &v1, &v2, _state);
5793:libs/alglib/src/alglibmisc.cpp ****     result = v1;
5794:libs/alglib/src/alglibmisc.cpp ****     return result;
5795:libs/alglib/src/alglibmisc.cpp **** }
5796:libs/alglib/src/alglibmisc.cpp **** 
5797:libs/alglib/src/alglibmisc.cpp **** 
5798:libs/alglib/src/alglibmisc.cpp **** /*************************************************************************
5799:libs/alglib/src/alglibmisc.cpp **** Random number generator: vector with random entries (normal distribution)
5800:libs/alglib/src/alglibmisc.cpp **** 
5801:libs/alglib/src/alglibmisc.cpp **** This function generates N random numbers from normal distribution.
5802:libs/alglib/src/alglibmisc.cpp **** 
5803:libs/alglib/src/alglibmisc.cpp **** State structure must be initialized with HQRNDRandomize() or HQRNDSeed().
5804:libs/alglib/src/alglibmisc.cpp **** 
5805:libs/alglib/src/alglibmisc.cpp ****   -- ALGLIB --
5806:libs/alglib/src/alglibmisc.cpp ****      Copyright 02.12.2009 by Bochkanov Sergey
5807:libs/alglib/src/alglibmisc.cpp **** *************************************************************************/
5808:libs/alglib/src/alglibmisc.cpp **** void hqrndnormalv(hqrndstate* state,
5809:libs/alglib/src/alglibmisc.cpp ****      ae_int_t n,
5810:libs/alglib/src/alglibmisc.cpp ****      /* Real    */ ae_vector* x,
5811:libs/alglib/src/alglibmisc.cpp ****      ae_state *_state)
5812:libs/alglib/src/alglibmisc.cpp **** {
5813:libs/alglib/src/alglibmisc.cpp ****     ae_int_t i;
5814:libs/alglib/src/alglibmisc.cpp ****     ae_int_t n2;
5815:libs/alglib/src/alglibmisc.cpp ****     double v1;
5816:libs/alglib/src/alglibmisc.cpp ****     double v2;
5817:libs/alglib/src/alglibmisc.cpp **** 
5818:libs/alglib/src/alglibmisc.cpp ****     ae_vector_clear(x);
5819:libs/alglib/src/alglibmisc.cpp **** 
5820:libs/alglib/src/alglibmisc.cpp ****     n2 = n/2;
5821:libs/alglib/src/alglibmisc.cpp ****     rallocv(n, x, _state);
5822:libs/alglib/src/alglibmisc.cpp ****     for(i=0; i<=n2-1; i++)
5823:libs/alglib/src/alglibmisc.cpp ****     {
5824:libs/alglib/src/alglibmisc.cpp ****         hqrndnormal2(state, &v1, &v2, _state);
5825:libs/alglib/src/alglibmisc.cpp ****         x->ptr.p_double[2*i+0] = v1;
5826:libs/alglib/src/alglibmisc.cpp ****         x->ptr.p_double[2*i+1] = v2;
5827:libs/alglib/src/alglibmisc.cpp ****     }
5828:libs/alglib/src/alglibmisc.cpp ****     if( n%2!=0 )
5829:libs/alglib/src/alglibmisc.cpp ****     {
5830:libs/alglib/src/alglibmisc.cpp ****         hqrndnormal2(state, &v1, &v2, _state);
5831:libs/alglib/src/alglibmisc.cpp ****         x->ptr.p_double[n-1] = v1;
5832:libs/alglib/src/alglibmisc.cpp ****     }
5833:libs/alglib/src/alglibmisc.cpp **** }
5834:libs/alglib/src/alglibmisc.cpp **** 
5835:libs/alglib/src/alglibmisc.cpp **** 
5836:libs/alglib/src/alglibmisc.cpp **** /*************************************************************************
5837:libs/alglib/src/alglibmisc.cpp **** Random number generator: matrix with random entries (normal distribution)
5838:libs/alglib/src/alglibmisc.cpp **** 
5839:libs/alglib/src/alglibmisc.cpp **** This function generates MxN random matrix.
5840:libs/alglib/src/alglibmisc.cpp **** 
5841:libs/alglib/src/alglibmisc.cpp **** State structure must be initialized with HQRNDRandomize() or HQRNDSeed().
5842:libs/alglib/src/alglibmisc.cpp **** 
5843:libs/alglib/src/alglibmisc.cpp ****   -- ALGLIB --
ARM GAS  C:\Users\subdia\AppData\Local\Temp\ccLx3Sbr.s 			page 171


5844:libs/alglib/src/alglibmisc.cpp ****      Copyright 02.12.2009 by Bochkanov Sergey
5845:libs/alglib/src/alglibmisc.cpp **** *************************************************************************/
5846:libs/alglib/src/alglibmisc.cpp **** void hqrndnormalm(hqrndstate* state,
5847:libs/alglib/src/alglibmisc.cpp ****      ae_int_t m,
5848:libs/alglib/src/alglibmisc.cpp ****      ae_int_t n,
5849:libs/alglib/src/alglibmisc.cpp ****      /* Real    */ ae_matrix* x,
5850:libs/alglib/src/alglibmisc.cpp ****      ae_state *_state)
5851:libs/alglib/src/alglibmisc.cpp **** {
5852:libs/alglib/src/alglibmisc.cpp ****     ae_int_t i;
5853:libs/alglib/src/alglibmisc.cpp ****     ae_int_t j;
5854:libs/alglib/src/alglibmisc.cpp ****     ae_int_t n2;
5855:libs/alglib/src/alglibmisc.cpp ****     double v1;
5856:libs/alglib/src/alglibmisc.cpp ****     double v2;
5857:libs/alglib/src/alglibmisc.cpp **** 
5858:libs/alglib/src/alglibmisc.cpp ****     ae_matrix_clear(x);
5859:libs/alglib/src/alglibmisc.cpp **** 
5860:libs/alglib/src/alglibmisc.cpp ****     n2 = n/2;
5861:libs/alglib/src/alglibmisc.cpp ****     ae_matrix_set_length(x, m, n, _state);
5862:libs/alglib/src/alglibmisc.cpp ****     for(i=0; i<=m-1; i++)
5863:libs/alglib/src/alglibmisc.cpp ****     {
5864:libs/alglib/src/alglibmisc.cpp ****         for(j=0; j<=n2-1; j++)
5865:libs/alglib/src/alglibmisc.cpp ****         {
5866:libs/alglib/src/alglibmisc.cpp ****             hqrndnormal2(state, &v1, &v2, _state);
5867:libs/alglib/src/alglibmisc.cpp ****             x->ptr.pp_double[i][2*j+0] = v1;
5868:libs/alglib/src/alglibmisc.cpp ****             x->ptr.pp_double[i][2*j+1] = v2;
5869:libs/alglib/src/alglibmisc.cpp ****         }
5870:libs/alglib/src/alglibmisc.cpp ****         if( n%2!=0 )
5871:libs/alglib/src/alglibmisc.cpp ****         {
5872:libs/alglib/src/alglibmisc.cpp ****             hqrndnormal2(state, &v1, &v2, _state);
5873:libs/alglib/src/alglibmisc.cpp ****             x->ptr.pp_double[i][n-1] = v1;
5874:libs/alglib/src/alglibmisc.cpp ****         }
