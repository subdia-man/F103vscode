2321:libs/alglib/src/alglibmisc.cpp **** {
2322:libs/alglib/src/alglibmisc.cpp ****     jmp_buf _break_jump;
2323:libs/alglib/src/alglibmisc.cpp ****     alglib_impl::ae_state _alglib_env_state;
2324:libs/alglib/src/alglibmisc.cpp ****     alglib_impl::ae_state_init(&_alglib_env_state);
2325:libs/alglib/src/alglibmisc.cpp ****     if( setjmp(_break_jump) )
2326:libs/alglib/src/alglibmisc.cpp ****     {
2327:libs/alglib/src/alglibmisc.cpp **** #if !defined(AE_NO_EXCEPTIONS)
2328:libs/alglib/src/alglibmisc.cpp ****         _ALGLIB_CPP_EXCEPTION(_alglib_env_state.error_msg);
2329:libs/alglib/src/alglibmisc.cpp **** #else
2330:libs/alglib/src/alglibmisc.cpp ****         _ALGLIB_SET_ERROR_FLAG(_alglib_env_state.error_msg);
2331:libs/alglib/src/alglibmisc.cpp ****         return;
2332:libs/alglib/src/alglibmisc.cpp **** #endif
2333:libs/alglib/src/alglibmisc.cpp ****     }
2334:libs/alglib/src/alglibmisc.cpp ****     ae_state_set_break_jump(&_alglib_env_state, &_break_jump);
2335:libs/alglib/src/alglibmisc.cpp ****     if( _xparams.flags!=(alglib_impl::ae_uint64_t)0x0 )
2336:libs/alglib/src/alglibmisc.cpp ****         ae_state_set_flags(&_alglib_env_state, _xparams.flags);
2337:libs/alglib/src/alglibmisc.cpp ****     alglib_impl::kdtreecreaterequestbuffer(kdt.c_ptr(), buf.c_ptr(), &_alglib_env_state);
2338:libs/alglib/src/alglibmisc.cpp ****     alglib_impl::ae_state_clear(&_alglib_env_state);
2339:libs/alglib/src/alglibmisc.cpp ****     return;
