6441:libs/alglib/src/alglibmisc.cpp **** /*************************************************************************
6442:libs/alglib/src/alglibmisc.cpp **** K-NN query: K nearest neighbors, using external thread-local buffer.
6443:libs/alglib/src/alglibmisc.cpp **** 
6444:libs/alglib/src/alglibmisc.cpp **** You can call this function from multiple threads for same kd-tree instance,
6445:libs/alglib/src/alglibmisc.cpp **** assuming that different instances of buffer object are passed to different
6446:libs/alglib/src/alglibmisc.cpp **** threads.
6447:libs/alglib/src/alglibmisc.cpp **** 
6448:libs/alglib/src/alglibmisc.cpp **** INPUT PARAMETERS
6449:libs/alglib/src/alglibmisc.cpp ****     KDT         -   kd-tree
6450:libs/alglib/src/alglibmisc.cpp ****     Buf         -   request buffer  object  created  for  this  particular
6451:libs/alglib/src/alglibmisc.cpp ****                     instance of kd-tree structure with kdtreecreaterequestbuffer()
6452:libs/alglib/src/alglibmisc.cpp ****                     function.
6453:libs/alglib/src/alglibmisc.cpp ****     X           -   point, array[0..NX-1].
6454:libs/alglib/src/alglibmisc.cpp ****     K           -   number of neighbors to return, K>=1
6455:libs/alglib/src/alglibmisc.cpp ****     SelfMatch   -   whether self-matches are allowed:
6456:libs/alglib/src/alglibmisc.cpp ****                     * if True, nearest neighbor may be the point itself
6457:libs/alglib/src/alglibmisc.cpp ****                       (if it exists in original dataset)
6458:libs/alglib/src/alglibmisc.cpp ****                     * if False, then only points with non-zero distance
6459:libs/alglib/src/alglibmisc.cpp ****                       are returned
6460:libs/alglib/src/alglibmisc.cpp ****                     * if not given, considered True
6461:libs/alglib/src/alglibmisc.cpp **** 
6462:libs/alglib/src/alglibmisc.cpp **** RESULT
6463:libs/alglib/src/alglibmisc.cpp ****     number of actual neighbors found (either K or N, if K>N).
6464:libs/alglib/src/alglibmisc.cpp **** 
6465:libs/alglib/src/alglibmisc.cpp **** This  subroutine  performs  query  and  stores  its result in the internal
6466:libs/alglib/src/alglibmisc.cpp **** structures  of  the  buffer object. You can use following  subroutines  to
6467:libs/alglib/src/alglibmisc.cpp **** obtain these results (pay attention to "buf" in their names):
6468:libs/alglib/src/alglibmisc.cpp **** * KDTreeTsQueryResultsX() to get X-values
6469:libs/alglib/src/alglibmisc.cpp **** * KDTreeTsQueryResultsXY() to get X- and Y-values
6470:libs/alglib/src/alglibmisc.cpp **** * KDTreeTsQueryResultsTags() to get tag values
ARM GAS  C:\Users\subdia\AppData\Local\Temp\ccLx3Sbr.s 			page 182


6471:libs/alglib/src/alglibmisc.cpp **** * KDTreeTsQueryResultsDistances() to get distances
6472:libs/alglib/src/alglibmisc.cpp ****     
6473:libs/alglib/src/alglibmisc.cpp **** IMPORTANT: kd-tree buffer should be used only with  KD-tree  object  which
6474:libs/alglib/src/alglibmisc.cpp ****            was used to initialize buffer. Any attempt to use biffer   with
6475:libs/alglib/src/alglibmisc.cpp ****            different object is dangerous - you  may  get  integrity  check
6476:libs/alglib/src/alglibmisc.cpp ****            failure (exception) because sizes of internal arrays do not fit
6477:libs/alglib/src/alglibmisc.cpp ****            to dimensions of KD-tree structure.
6478:libs/alglib/src/alglibmisc.cpp **** 
6479:libs/alglib/src/alglibmisc.cpp ****   -- ALGLIB --
6480:libs/alglib/src/alglibmisc.cpp ****      Copyright 18.03.2016 by Bochkanov Sergey
6481:libs/alglib/src/alglibmisc.cpp **** *************************************************************************/
6482:libs/alglib/src/alglibmisc.cpp **** ae_int_t kdtreetsqueryknn(const kdtree* kdt,
6483:libs/alglib/src/alglibmisc.cpp ****      kdtreerequestbuffer* buf,
6484:libs/alglib/src/alglibmisc.cpp ****      /* Real    */ const ae_vector* x,
6485:libs/alglib/src/alglibmisc.cpp ****      ae_int_t k,
6486:libs/alglib/src/alglibmisc.cpp ****      ae_bool selfmatch,
6487:libs/alglib/src/alglibmisc.cpp ****      ae_state *_state)
6488:libs/alglib/src/alglibmisc.cpp **** {
6489:libs/alglib/src/alglibmisc.cpp ****     ae_int_t result;
6490:libs/alglib/src/alglibmisc.cpp **** 
6491:libs/alglib/src/alglibmisc.cpp **** 
6492:libs/alglib/src/alglibmisc.cpp ****     ae_assert(k>=1, "KDTreeTsQueryKNN: K<1!", _state);
6493:libs/alglib/src/alglibmisc.cpp ****     ae_assert(x->cnt>=kdt->nx, "KDTreeTsQueryKNN: Length(X)<NX!", _state);
6494:libs/alglib/src/alglibmisc.cpp ****     ae_assert(isfinitevector(x, kdt->nx, _state), "KDTreeTsQueryKNN: X contains infinite or NaN val
6495:libs/alglib/src/alglibmisc.cpp ****     result = kdtreetsqueryaknn(kdt, buf, x, k, selfmatch, 0.0, _state);
6496:libs/alglib/src/alglibmisc.cpp ****     return result;
6497:libs/alglib/src/alglibmisc.cpp **** }
