2342:libs/alglib/src/alglibmisc.cpp **** /*************************************************************************
2343:libs/alglib/src/alglibmisc.cpp **** K-NN query: K nearest neighbors
2344:libs/alglib/src/alglibmisc.cpp **** 
2345:libs/alglib/src/alglibmisc.cpp **** IMPORTANT: this function can not be used in multithreaded code because  it
2346:libs/alglib/src/alglibmisc.cpp ****            uses internal temporary buffer of kd-tree object, which can not
2347:libs/alglib/src/alglibmisc.cpp ****            be shared between multiple threads.  If  you  want  to  perform
2348:libs/alglib/src/alglibmisc.cpp ****            parallel requests, use function  which  uses  external  request
2349:libs/alglib/src/alglibmisc.cpp ****            buffer: KDTreeTsQueryKNN() ("Ts" stands for "thread-safe").
2350:libs/alglib/src/alglibmisc.cpp **** 
2351:libs/alglib/src/alglibmisc.cpp **** INPUT PARAMETERS
2352:libs/alglib/src/alglibmisc.cpp ****     KDT         -   KD-tree
2353:libs/alglib/src/alglibmisc.cpp ****     X           -   point, array[0..NX-1].
2354:libs/alglib/src/alglibmisc.cpp ****     K           -   number of neighbors to return, K>=1
2355:libs/alglib/src/alglibmisc.cpp ****     SelfMatch   -   whether self-matches are allowed:
2356:libs/alglib/src/alglibmisc.cpp ****                     * if True, nearest neighbor may be the point itself
2357:libs/alglib/src/alglibmisc.cpp ****                       (if it exists in original dataset)
2358:libs/alglib/src/alglibmisc.cpp ****                     * if False, then only points with non-zero distance
2359:libs/alglib/src/alglibmisc.cpp ****                       are returned
2360:libs/alglib/src/alglibmisc.cpp ****                     * if not given, considered True
2361:libs/alglib/src/alglibmisc.cpp **** 
2362:libs/alglib/src/alglibmisc.cpp **** RESULT
2363:libs/alglib/src/alglibmisc.cpp ****     number of actual neighbors found (either K or N, if K>N).
2364:libs/alglib/src/alglibmisc.cpp **** 
2365:libs/alglib/src/alglibmisc.cpp **** This  subroutine  performs  query  and  stores  its result in the internal
2366:libs/alglib/src/alglibmisc.cpp **** structures of the KD-tree. You can use  following  subroutines  to  obtain
ARM GAS  C:\Users\subdia\AppData\Local\Temp\ccLx3Sbr.s 			page 110


2367:libs/alglib/src/alglibmisc.cpp **** these results:
2368:libs/alglib/src/alglibmisc.cpp **** * KDTreeQueryResultsX() to get X-values
2369:libs/alglib/src/alglibmisc.cpp **** * KDTreeQueryResultsXY() to get X- and Y-values
2370:libs/alglib/src/alglibmisc.cpp **** * KDTreeQueryResultsTags() to get tag values
2371:libs/alglib/src/alglibmisc.cpp **** * KDTreeQueryResultsDistances() to get distances
2372:libs/alglib/src/alglibmisc.cpp **** 
2373:libs/alglib/src/alglibmisc.cpp ****   -- ALGLIB --
2374:libs/alglib/src/alglibmisc.cpp ****      Copyright 28.02.2010 by Bochkanov Sergey
2375:libs/alglib/src/alglibmisc.cpp **** *************************************************************************/
2376:libs/alglib/src/alglibmisc.cpp **** ae_int_t kdtreequeryknn(kdtree &kdt, const real_1d_array &x, const ae_int_t k, const bool selfmatch
2377:libs/alglib/src/alglibmisc.cpp **** {
2378:libs/alglib/src/alglibmisc.cpp ****     jmp_buf _break_jump;
2379:libs/alglib/src/alglibmisc.cpp ****     alglib_impl::ae_state _alglib_env_state;
2380:libs/alglib/src/alglibmisc.cpp ****     alglib_impl::ae_state_init(&_alglib_env_state);
2381:libs/alglib/src/alglibmisc.cpp ****     if( setjmp(_break_jump) )
2382:libs/alglib/src/alglibmisc.cpp ****     {
2383:libs/alglib/src/alglibmisc.cpp **** #if !defined(AE_NO_EXCEPTIONS)
2384:libs/alglib/src/alglibmisc.cpp ****         _ALGLIB_CPP_EXCEPTION(_alglib_env_state.error_msg);
2385:libs/alglib/src/alglibmisc.cpp **** #else
2386:libs/alglib/src/alglibmisc.cpp ****         _ALGLIB_SET_ERROR_FLAG(_alglib_env_state.error_msg);
2387:libs/alglib/src/alglibmisc.cpp ****         return 0;
2388:libs/alglib/src/alglibmisc.cpp **** #endif
2389:libs/alglib/src/alglibmisc.cpp ****     }
2390:libs/alglib/src/alglibmisc.cpp ****     ae_state_set_break_jump(&_alglib_env_state, &_break_jump);
2391:libs/alglib/src/alglibmisc.cpp ****     if( _xparams.flags!=(alglib_impl::ae_uint64_t)0x0 )
2392:libs/alglib/src/alglibmisc.cpp ****         ae_state_set_flags(&_alglib_env_state, _xparams.flags);
2393:libs/alglib/src/alglibmisc.cpp ****     alglib_impl::ae_int_t result = alglib_impl::kdtreequeryknn(kdt.c_ptr(), x.c_ptr(), k, selfmatch
2394:libs/alglib/src/alglibmisc.cpp ****     alglib_impl::ae_state_clear(&_alglib_env_state);
2395:libs/alglib/src/alglibmisc.cpp ****     return ae_int_t(result);
2396:libs/alglib/src/alglibmisc.cpp **** }
