6032:libs/alglib/src/alglibmisc.cpp **** This function generates  random number from discrete distribution given by
6033:libs/alglib/src/alglibmisc.cpp **** finite sample X.
6034:libs/alglib/src/alglibmisc.cpp **** 
6035:libs/alglib/src/alglibmisc.cpp **** INPUT PARAMETERS
6036:libs/alglib/src/alglibmisc.cpp ****     State   -   high quality random number generator, must be
6037:libs/alglib/src/alglibmisc.cpp ****                 initialized with HQRNDRandomize() or HQRNDSeed().
6038:libs/alglib/src/alglibmisc.cpp ****         X   -   finite sample
6039:libs/alglib/src/alglibmisc.cpp ****         N   -   number of elements to use, N>=1
6040:libs/alglib/src/alglibmisc.cpp **** 
6041:libs/alglib/src/alglibmisc.cpp **** RESULT
6042:libs/alglib/src/alglibmisc.cpp ****     this function returns one of the X[i] for random i=0..N-1
6043:libs/alglib/src/alglibmisc.cpp **** 
6044:libs/alglib/src/alglibmisc.cpp ****   -- ALGLIB --
6045:libs/alglib/src/alglibmisc.cpp ****      Copyright 08.11.2011 by Bochkanov Sergey
6046:libs/alglib/src/alglibmisc.cpp **** *************************************************************************/
6047:libs/alglib/src/alglibmisc.cpp **** double hqrnddiscrete(hqrndstate* state,
6048:libs/alglib/src/alglibmisc.cpp ****      /* Real    */ const ae_vector* x,
6049:libs/alglib/src/alglibmisc.cpp ****      ae_int_t n,
6050:libs/alglib/src/alglibmisc.cpp ****      ae_state *_state)
6051:libs/alglib/src/alglibmisc.cpp **** {
6052:libs/alglib/src/alglibmisc.cpp ****     double result;
6053:libs/alglib/src/alglibmisc.cpp **** 
6054:libs/alglib/src/alglibmisc.cpp **** 
6055:libs/alglib/src/alglibmisc.cpp ****     ae_assert(n>0, "HQRNDDiscrete: N<=0", _state);
6056:libs/alglib/src/alglibmisc.cpp ****     ae_assert(n<=x->cnt, "HQRNDDiscrete: Length(X)<N", _state);
6057:libs/alglib/src/alglibmisc.cpp ****     result = x->ptr.p_double[hqrnduniformi(state, n, _state)];
6058:libs/alglib/src/alglibmisc.cpp ****     return result;
