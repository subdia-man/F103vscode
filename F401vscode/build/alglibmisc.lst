7449:libs/alglib/src/alglibmisc.cpp **** void kdtreetsqueryresultsdistances(const kdtree* kdt,
7450:libs/alglib/src/alglibmisc.cpp ****      const kdtreerequestbuffer* buf,
7451:libs/alglib/src/alglibmisc.cpp ****      /* Real    */ ae_vector* r,
7452:libs/alglib/src/alglibmisc.cpp ****      ae_state *_state)
7453:libs/alglib/src/alglibmisc.cpp **** {
7454:libs/alglib/src/alglibmisc.cpp ****     ae_int_t i;
7455:libs/alglib/src/alglibmisc.cpp ****     ae_int_t k;
7456:libs/alglib/src/alglibmisc.cpp **** 
7457:libs/alglib/src/alglibmisc.cpp **** 
7458:libs/alglib/src/alglibmisc.cpp ****     if( buf->kcur==0 )
7459:libs/alglib/src/alglibmisc.cpp ****     {
7460:libs/alglib/src/alglibmisc.cpp ****         return;
7461:libs/alglib/src/alglibmisc.cpp ****     }
7462:libs/alglib/src/alglibmisc.cpp ****     if( r->cnt<buf->kcur )
7463:libs/alglib/src/alglibmisc.cpp ****     {
7464:libs/alglib/src/alglibmisc.cpp ****         ae_vector_set_length(r, buf->kcur, _state);
7465:libs/alglib/src/alglibmisc.cpp ****     }
7466:libs/alglib/src/alglibmisc.cpp ****     k = buf->kcur;
7467:libs/alglib/src/alglibmisc.cpp ****     
7468:libs/alglib/src/alglibmisc.cpp ****     /*
7469:libs/alglib/src/alglibmisc.cpp ****      * unload norms
7470:libs/alglib/src/alglibmisc.cpp ****      *
7471:libs/alglib/src/alglibmisc.cpp ****      * Abs() call is used to handle cases with negative norms
7472:libs/alglib/src/alglibmisc.cpp ****      * (generated during KFN requests)
7473:libs/alglib/src/alglibmisc.cpp ****      */
7474:libs/alglib/src/alglibmisc.cpp ****     if( kdt->normtype==0 )
7475:libs/alglib/src/alglibmisc.cpp ****     {
7476:libs/alglib/src/alglibmisc.cpp ****         for(i=0; i<=k-1; i++)
7477:libs/alglib/src/alglibmisc.cpp ****         {
7478:libs/alglib/src/alglibmisc.cpp ****             r->ptr.p_double[i] = ae_fabs(buf->r.ptr.p_double[i], _state);
7479:libs/alglib/src/alglibmisc.cpp ****         }
7480:libs/alglib/src/alglibmisc.cpp ****     }
7481:libs/alglib/src/alglibmisc.cpp ****     if( kdt->normtype==1 )
7482:libs/alglib/src/alglibmisc.cpp ****     {
7483:libs/alglib/src/alglibmisc.cpp ****         for(i=0; i<=k-1; i++)
7484:libs/alglib/src/alglibmisc.cpp ****         {
