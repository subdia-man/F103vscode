5995:libs/alglib/src/alglibmisc.cpp **** ae_int_t hqrndintegerbase(hqrndstate* state, ae_state *_state)
5996:libs/alglib/src/alglibmisc.cpp **** {
5997:libs/alglib/src/alglibmisc.cpp ****     ae_int_t k;
