7875:libs/alglib/src/alglibmisc.cpp **** 
7876:libs/alglib/src/alglibmisc.cpp **** /*************************************************************************
7877:libs/alglib/src/alglibmisc.cpp **** This function returns an approximate cost (measured in CPU  cycles)  of  a
7878:libs/alglib/src/alglibmisc.cpp **** R-NN query with some fixed R.
7879:libs/alglib/src/alglibmisc.cpp **** 
7880:libs/alglib/src/alglibmisc.cpp **** A VERY CRUDE APPROXIMATION IS RETURNED, ONLY AN ORDER OF MAGNITUDE CORRECT
7881:libs/alglib/src/alglibmisc.cpp **** 
7882:libs/alglib/src/alglibmisc.cpp **** This approximation can be used in a multithreaded code which decides whether
7883:libs/alglib/src/alglibmisc.cpp **** it makes sense to activate multithreading or not.
7884:libs/alglib/src/alglibmisc.cpp **** 
7885:libs/alglib/src/alglibmisc.cpp **** Internally this function is implemented by performing some small (about 50)
7886:libs/alglib/src/alglibmisc.cpp **** amount of random queries and computing an average number of R-neighbors of
7887:libs/alglib/src/alglibmisc.cpp **** a node. This number is multiplied by log2(NPoints), and then  by  a  crude
7888:libs/alglib/src/alglibmisc.cpp **** estimate of how many CPU cycles is required to perform a split during kd-tree
7889:libs/alglib/src/alglibmisc.cpp **** search.
7890:libs/alglib/src/alglibmisc.cpp **** 
7891:libs/alglib/src/alglibmisc.cpp **** This function is deterministic, i.e. it always uses a fixed seed to initialize
7892:libs/alglib/src/alglibmisc.cpp **** its internal RNG.
7893:libs/alglib/src/alglibmisc.cpp **** 
7894:libs/alglib/src/alglibmisc.cpp **** IMPORTANT: this function can not be used in multithreaded code because  it
7895:libs/alglib/src/alglibmisc.cpp ****            uses internal temporary buffer of kd-tree object, which can not
ARM GAS  C:\Users\subdia\AppData\Local\Temp\ccLx3Sbr.s 			page 207


7896:libs/alglib/src/alglibmisc.cpp ****            be shared between multiple threads.
7897:libs/alglib/src/alglibmisc.cpp ****            
7898:libs/alglib/src/alglibmisc.cpp ****            See kdtreeapproxrnnquerycost() for a thread-safe alternative.
7899:libs/alglib/src/alglibmisc.cpp **** 
7900:libs/alglib/src/alglibmisc.cpp **** INPUT PARAMETERS
7901:libs/alglib/src/alglibmisc.cpp ****     KDT         -   KD-tree
7902:libs/alglib/src/alglibmisc.cpp ****     R           -   radius of sphere (in corresponding norm), R>0
7903:libs/alglib/src/alglibmisc.cpp **** 
7904:libs/alglib/src/alglibmisc.cpp **** RESULT
7905:libs/alglib/src/alglibmisc.cpp ****     double precision number, approximate query cost
7906:libs/alglib/src/alglibmisc.cpp **** 
7907:libs/alglib/src/alglibmisc.cpp ****   -- ALGLIB --
7908:libs/alglib/src/alglibmisc.cpp ****      Copyright 24.11.2023 by Bochkanov Sergey
7909:libs/alglib/src/alglibmisc.cpp **** *************************************************************************/
7910:libs/alglib/src/alglibmisc.cpp **** double kdtreeapproxrnnquerycost(kdtree* kdt, double r, ae_state *_state)
7911:libs/alglib/src/alglibmisc.cpp **** {
7912:libs/alglib/src/alglibmisc.cpp ****     double result;
7913:libs/alglib/src/alglibmisc.cpp **** 
7914:libs/alglib/src/alglibmisc.cpp **** 
7915:libs/alglib/src/alglibmisc.cpp ****     result = kdtreetsapproxrnnquerycost(kdt, &kdt->innerbuf, r, _state);
7916:libs/alglib/src/alglibmisc.cpp ****     return result;
7917:libs/alglib/src/alglibmisc.cpp **** }
7918:libs/alglib/src/alglibmisc.cpp **** 
7919:libs/alglib/src/alglibmisc.cpp **** 
7920:libs/alglib/src/alglibmisc.cpp **** /*************************************************************************
7921:libs/alglib/src/alglibmisc.cpp **** This function returns an approximate cost (measured in CPU  cycles)  of  a
7922:libs/alglib/src/alglibmisc.cpp **** R-NN query with some fixed R.
7923:libs/alglib/src/alglibmisc.cpp **** 
7924:libs/alglib/src/alglibmisc.cpp **** A thread-safe version of kdtreeapproxrnnquerycost() using a request buffer.
7925:libs/alglib/src/alglibmisc.cpp **** 
7926:libs/alglib/src/alglibmisc.cpp ****   -- ALGLIB --
7927:libs/alglib/src/alglibmisc.cpp ****      Copyright 24.11.2023 by Bochkanov Sergey
7928:libs/alglib/src/alglibmisc.cpp **** *************************************************************************/
7929:libs/alglib/src/alglibmisc.cpp **** double kdtreetsapproxrnnquerycost(const kdtree* kdt,
7930:libs/alglib/src/alglibmisc.cpp ****      kdtreerequestbuffer* buf,
7931:libs/alglib/src/alglibmisc.cpp ****      double r,
7932:libs/alglib/src/alglibmisc.cpp ****      ae_state *_state)
7933:libs/alglib/src/alglibmisc.cpp **** {
7934:libs/alglib/src/alglibmisc.cpp ****     ae_frame _frame_block;
7935:libs/alglib/src/alglibmisc.cpp ****     ae_int_t i;
7936:libs/alglib/src/alglibmisc.cpp ****     ae_int_t j;
7937:libs/alglib/src/alglibmisc.cpp ****     ae_int_t k;
7938:libs/alglib/src/alglibmisc.cpp ****     ae_int_t cnt;
7939:libs/alglib/src/alglibmisc.cpp ****     ae_int_t nx;
7940:libs/alglib/src/alglibmisc.cpp ****     double log2n;
7941:libs/alglib/src/alglibmisc.cpp ****     double avgrnn;
7942:libs/alglib/src/alglibmisc.cpp ****     hqrndstate rs;
7943:libs/alglib/src/alglibmisc.cpp ****     double result;
7944:libs/alglib/src/alglibmisc.cpp **** 
7945:libs/alglib/src/alglibmisc.cpp ****     ae_frame_make(_state, &_frame_block);
7946:libs/alglib/src/alglibmisc.cpp ****     memset(&rs, 0, sizeof(rs));
7947:libs/alglib/src/alglibmisc.cpp ****     _hqrndstate_init(&rs, _state, ae_true);
7948:libs/alglib/src/alglibmisc.cpp **** 
7949:libs/alglib/src/alglibmisc.cpp ****     ae_assert(ae_isfinite(r, _state)&&ae_fp_greater(r,(double)(0)), "KDTreeApproxRNNQueryCost: inco
7950:libs/alglib/src/alglibmisc.cpp ****     hqrndseed(46532, 66356, &rs, _state);
7951:libs/alglib/src/alglibmisc.cpp ****     nx = kdt->nx;
7952:libs/alglib/src/alglibmisc.cpp ****     cnt = ae_minint(50, kdt->n, _state);
ARM GAS  C:\Users\subdia\AppData\Local\Temp\ccLx3Sbr.s 			page 208


7953:libs/alglib/src/alglibmisc.cpp ****     log2n = ae_log((double)(1+kdt->n), _state)/ae_log((double)(2), _state);
7954:libs/alglib/src/alglibmisc.cpp ****     avgrnn = (double)(0);
7955:libs/alglib/src/alglibmisc.cpp ****     rallocv(nx, &buf->xqc, _state);
7956:libs/alglib/src/alglibmisc.cpp ****     for(i=0; i<=cnt-1; i++)
7957:libs/alglib/src/alglibmisc.cpp ****     {
7958:libs/alglib/src/alglibmisc.cpp ****         k = hqrnduniformi(&rs, kdt->n, _state);
7959:libs/alglib/src/alglibmisc.cpp ****         for(j=0; j<=nx-1; j++)
7960:libs/alglib/src/alglibmisc.cpp ****         {
7961:libs/alglib/src/alglibmisc.cpp ****             buf->xqc.ptr.p_double[j] = kdt->xy.ptr.pp_double[k][nx+j];
7962:libs/alglib/src/alglibmisc.cpp ****         }
7963:libs/alglib/src/alglibmisc.cpp ****         avgrnn = avgrnn+(double)nearestneighbor_tsqueryrnn(kdt, buf, &buf->xqc, r, ae_true, ae_fals
7964:libs/alglib/src/alglibmisc.cpp ****     }
7965:libs/alglib/src/alglibmisc.cpp ****     result = avgrnn*log2n*(double)15;
7966:libs/alglib/src/alglibmisc.cpp ****     ae_frame_leave(_state);
7967:libs/alglib/src/alglibmisc.cpp ****     return result;
7968:libs/alglib/src/alglibmisc.cpp **** }
7969:libs/alglib/src/alglibmisc.cpp **** 
7970:libs/alglib/src/alglibmisc.cpp **** 
7971:libs/alglib/src/alglibmisc.cpp **** /*************************************************************************
7972:libs/alglib/src/alglibmisc.cpp **** R-NN query: all points within  R-sphere  centered  at  X,  using  external
7973:libs/alglib/src/alglibmisc.cpp **** thread-local buffer, sorted by distance between point and X (by ascending)
7974:libs/alglib/src/alglibmisc.cpp **** 
7975:libs/alglib/src/alglibmisc.cpp **** You can call this function from multiple threads for same kd-tree instance,
7976:libs/alglib/src/alglibmisc.cpp **** assuming that different instances of buffer object are passed to different
7977:libs/alglib/src/alglibmisc.cpp **** threads.
7978:libs/alglib/src/alglibmisc.cpp **** 
7979:libs/alglib/src/alglibmisc.cpp **** NOTE: it is also possible to perform undordered queries performed by means
7980:libs/alglib/src/alglibmisc.cpp ****       of kdtreequeryrnnu() and kdtreetsqueryrnnu() functions. Such queries
7981:libs/alglib/src/alglibmisc.cpp ****       are faster because we do not have to use heap structure for sorting.
7982:libs/alglib/src/alglibmisc.cpp **** 
7983:libs/alglib/src/alglibmisc.cpp **** INPUT PARAMETERS
7984:libs/alglib/src/alglibmisc.cpp ****     KDT         -   KD-tree
7985:libs/alglib/src/alglibmisc.cpp ****     Buf         -   request buffer  object  created  for  this  particular
7986:libs/alglib/src/alglibmisc.cpp ****                     instance of kd-tree structure with kdtreecreaterequestbuffer()
7987:libs/alglib/src/alglibmisc.cpp ****                     function.
7988:libs/alglib/src/alglibmisc.cpp ****     X           -   point, array[0..NX-1].
7989:libs/alglib/src/alglibmisc.cpp ****     R           -   radius of sphere (in corresponding norm), R>0
7990:libs/alglib/src/alglibmisc.cpp ****     SelfMatch   -   whether self-matches are allowed:
7991:libs/alglib/src/alglibmisc.cpp ****                     * if True, nearest neighbor may be the point itself
7992:libs/alglib/src/alglibmisc.cpp ****                       (if it exists in original dataset)
7993:libs/alglib/src/alglibmisc.cpp ****                     * if False, then only points with non-zero distance
7994:libs/alglib/src/alglibmisc.cpp ****                       are returned
7995:libs/alglib/src/alglibmisc.cpp ****                     * if not given, considered True
7996:libs/alglib/src/alglibmisc.cpp **** 
7997:libs/alglib/src/alglibmisc.cpp **** RESULT
7998:libs/alglib/src/alglibmisc.cpp ****     number of neighbors found, >=0
7999:libs/alglib/src/alglibmisc.cpp **** 
8000:libs/alglib/src/alglibmisc.cpp **** This  subroutine  performs  query  and  stores  its result in the internal
8001:libs/alglib/src/alglibmisc.cpp **** structures  of  the  buffer object. You can use following  subroutines  to
8002:libs/alglib/src/alglibmisc.cpp **** obtain these results (pay attention to "buf" in their names):
8003:libs/alglib/src/alglibmisc.cpp **** * KDTreeTsQueryResultsX() to get X-values
8004:libs/alglib/src/alglibmisc.cpp **** * KDTreeTsQueryResultsXY() to get X- and Y-values
8005:libs/alglib/src/alglibmisc.cpp **** * KDTreeTsQueryResultsTags() to get tag values
8006:libs/alglib/src/alglibmisc.cpp **** * KDTreeTsQueryResultsDistances() to get distances
8007:libs/alglib/src/alglibmisc.cpp ****     
8008:libs/alglib/src/alglibmisc.cpp **** IMPORTANT: kd-tree buffer should be used only with  KD-tree  object  which
8009:libs/alglib/src/alglibmisc.cpp ****            was used to initialize buffer. Any attempt to use biffer   with
ARM GAS  C:\Users\subdia\AppData\Local\Temp\ccLx3Sbr.s 			page 209


8010:libs/alglib/src/alglibmisc.cpp ****            different object is dangerous - you  may  get  integrity  check
8011:libs/alglib/src/alglibmisc.cpp ****            failure (exception) because sizes of internal arrays do not fit
8012:libs/alglib/src/alglibmisc.cpp ****            to dimensions of KD-tree structure.
8013:libs/alglib/src/alglibmisc.cpp **** 
8014:libs/alglib/src/alglibmisc.cpp ****   -- ALGLIB --
8015:libs/alglib/src/alglibmisc.cpp ****      Copyright 18.03.2016 by Bochkanov Sergey
8016:libs/alglib/src/alglibmisc.cpp **** *************************************************************************/
8017:libs/alglib/src/alglibmisc.cpp **** static ae_int_t nearestneighbor_tsqueryrnn(const kdtree* kdt,
8018:libs/alglib/src/alglibmisc.cpp ****      kdtreerequestbuffer* buf,
8019:libs/alglib/src/alglibmisc.cpp ****      /* Real    */ const ae_vector* x,
8020:libs/alglib/src/alglibmisc.cpp ****      double r,
8021:libs/alglib/src/alglibmisc.cpp ****      ae_bool selfmatch,
