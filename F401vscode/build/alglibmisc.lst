5910:libs/alglib/src/alglibmisc.cpp **** Random number generator: normal numbers
5911:libs/alglib/src/alglibmisc.cpp **** 
5912:libs/alglib/src/alglibmisc.cpp **** This function generates two independent random numbers from normal
5913:libs/alglib/src/alglibmisc.cpp **** distribution. Its performance is equal to that of HQRNDNormal()
5914:libs/alglib/src/alglibmisc.cpp **** 
5915:libs/alglib/src/alglibmisc.cpp **** State structure must be initialized with HQRNDRandomize() or HQRNDSeed().
5916:libs/alglib/src/alglibmisc.cpp **** 
5917:libs/alglib/src/alglibmisc.cpp ****   -- ALGLIB --
5918:libs/alglib/src/alglibmisc.cpp ****      Copyright 02.12.2009 by Bochkanov Sergey
5919:libs/alglib/src/alglibmisc.cpp **** *************************************************************************/
5920:libs/alglib/src/alglibmisc.cpp **** void hqrndnormal2(hqrndstate* state,
5921:libs/alglib/src/alglibmisc.cpp ****      double* x1,
5922:libs/alglib/src/alglibmisc.cpp ****      double* x2,
5923:libs/alglib/src/alglibmisc.cpp ****      ae_state *_state)
5924:libs/alglib/src/alglibmisc.cpp **** {
5925:libs/alglib/src/alglibmisc.cpp ****     double u;
5926:libs/alglib/src/alglibmisc.cpp ****     double v;
5927:libs/alglib/src/alglibmisc.cpp ****     double s;
5928:libs/alglib/src/alglibmisc.cpp **** 
5929:libs/alglib/src/alglibmisc.cpp ****     *x1 = 0.0;
5930:libs/alglib/src/alglibmisc.cpp ****     *x2 = 0.0;
5931:libs/alglib/src/alglibmisc.cpp **** 
5932:libs/alglib/src/alglibmisc.cpp ****     for(;;)
5933:libs/alglib/src/alglibmisc.cpp ****     {
5934:libs/alglib/src/alglibmisc.cpp ****         u = (double)2*hqrnduniformr(state, _state)-(double)1;
5935:libs/alglib/src/alglibmisc.cpp ****         v = (double)2*hqrnduniformr(state, _state)-(double)1;
5936:libs/alglib/src/alglibmisc.cpp ****         s = ae_sqr(u, _state)+ae_sqr(v, _state);
5937:libs/alglib/src/alglibmisc.cpp ****         if( ae_fp_greater(s,(double)(0))&&ae_fp_less(s,(double)(1)) )
5938:libs/alglib/src/alglibmisc.cpp ****         {
5939:libs/alglib/src/alglibmisc.cpp ****             
5940:libs/alglib/src/alglibmisc.cpp ****             /*
5941:libs/alglib/src/alglibmisc.cpp ****              * two Sqrt's instead of one to
5942:libs/alglib/src/alglibmisc.cpp ****              * avoid overflow when S is too small
5943:libs/alglib/src/alglibmisc.cpp ****              */
5944:libs/alglib/src/alglibmisc.cpp ****             s = ae_sqrt(-(double)2*ae_log(s, _state), _state)/ae_sqrt(s, _state);
5945:libs/alglib/src/alglibmisc.cpp ****             *x1 = u*s;
5946:libs/alglib/src/alglibmisc.cpp ****             *x2 = v*s;
5947:libs/alglib/src/alglibmisc.cpp ****             return;
5948:libs/alglib/src/alglibmisc.cpp ****         }
5949:libs/alglib/src/alglibmisc.cpp ****     }
5950:libs/alglib/src/alglibmisc.cpp **** }
