6081:libs/alglib/src/alglibmisc.cpp **** double hqrndcontinuous(hqrndstate* state,
6082:libs/alglib/src/alglibmisc.cpp ****      /* Real    */ const ae_vector* x,
6083:libs/alglib/src/alglibmisc.cpp ****      ae_int_t n,
6084:libs/alglib/src/alglibmisc.cpp ****      ae_state *_state)
6085:libs/alglib/src/alglibmisc.cpp **** {
6086:libs/alglib/src/alglibmisc.cpp ****     double mx;
6087:libs/alglib/src/alglibmisc.cpp ****     double mn;
6088:libs/alglib/src/alglibmisc.cpp ****     ae_int_t i;
6089:libs/alglib/src/alglibmisc.cpp ****     double result;
6090:libs/alglib/src/alglibmisc.cpp **** 
6091:libs/alglib/src/alglibmisc.cpp **** 
6092:libs/alglib/src/alglibmisc.cpp ****     ae_assert(n>0, "HQRNDContinuous: N<=0", _state);
6093:libs/alglib/src/alglibmisc.cpp ****     ae_assert(n<=x->cnt, "HQRNDContinuous: Length(X)<N", _state);
6094:libs/alglib/src/alglibmisc.cpp ****     if( n==1 )
