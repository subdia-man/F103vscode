 666:libs/alglib/src/ap.h **** 
 667:libs/alglib/src/ap.h **** /************************************************************************
 668:libs/alglib/src/ap.h **** Serializer:
 669:libs/alglib/src/ap.h **** 
 670:libs/alglib/src/ap.h **** * ae_stream_writer type is a function pointer for stream  writer  method;
 671:libs/alglib/src/ap.h ****   this pointer is used by X-core for out-of-core serialization  (say,  to
 672:libs/alglib/src/ap.h ****   serialize ALGLIB structure directly to managed C# stream).
 673:libs/alglib/src/ap.h ****   
 674:libs/alglib/src/ap.h ****   This function accepts two parameters: pointer to  ANSI  (7-bit)  string
 675:libs/alglib/src/ap.h ****   and pointer-sized integer passed to serializer  during  initialization.
 676:libs/alglib/src/ap.h ****   String being passed is a part of the data stream; aux paramerer may  be
 677:libs/alglib/src/ap.h ****   arbitrary value intended to be used by actual implementation of  stream
 678:libs/alglib/src/ap.h ****   writer. String parameter may include spaces and  linefeed  symbols,  it
 679:libs/alglib/src/ap.h ****   should be written to stream as is.
 680:libs/alglib/src/ap.h ****   
 681:libs/alglib/src/ap.h ****   Return value must be zero for success or non-zero for failure.
 682:libs/alglib/src/ap.h ****   
 683:libs/alglib/src/ap.h **** * ae_stream_reader type is a function pointer for stream  reader  method;
 684:libs/alglib/src/ap.h ****   this pointer is used by X-core for out-of-core unserialization (say, to
 685:libs/alglib/src/ap.h ****   unserialize ALGLIB structure directly from managed C# stream).
 686:libs/alglib/src/ap.h ****   
 687:libs/alglib/src/ap.h ****   This function accepts three parameters: pointer-sized integer passed to
 688:libs/alglib/src/ap.h ****   serializer  during  initialization; number  of  symbols  to  read  from
 689:libs/alglib/src/ap.h ****   stream; pointer to buffer used to store next  token  read  from  stream
 690:libs/alglib/src/ap.h ****   (ANSI encoding is used, buffer is large enough to store all symbols and
 691:libs/alglib/src/ap.h ****   trailing zero symbol).
 692:libs/alglib/src/ap.h ****   
 693:libs/alglib/src/ap.h ****   Number of symbols to read is always positive.
 694:libs/alglib/src/ap.h ****   
 695:libs/alglib/src/ap.h ****   After being called by X-core, this function must:
 696:libs/alglib/src/ap.h ****   * skip all space and linefeed characters from the current  position  at
 697:libs/alglib/src/ap.h ****     the stream and until first non-space non-linefeed character is found
 698:libs/alglib/src/ap.h ****   * read exactly cnt symbols  from  stream  to  buffer;  check  that  all
 699:libs/alglib/src/ap.h ****     symbols being read are non-space non-linefeed ones
 700:libs/alglib/src/ap.h ****   * append trailing zero symbol to buffer
 701:libs/alglib/src/ap.h ****   * return value must be zero on success, non-zero if  even  one  of  the
 702:libs/alglib/src/ap.h ****     conditions above fails. When reader returns non-zero value,  contents
 703:libs/alglib/src/ap.h ****     of buf is not used.
 704:libs/alglib/src/ap.h **** ************************************************************************/
 705:libs/alglib/src/ap.h **** typedef char(*ae_stream_writer)(const char *p_string, ae_int_t aux);
 706:libs/alglib/src/ap.h **** typedef char(*ae_stream_reader)(ae_int_t aux, ae_int_t cnt, char *p_buf);
 707:libs/alglib/src/ap.h **** 
