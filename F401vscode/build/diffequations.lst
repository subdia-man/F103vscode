 906:libs/alglib/src/ap.h ****     ae_bool fixed_capacity;
 907:libs/alglib/src/ap.h ****     
 908:libs/alglib/src/ap.h ****     /* pointers to objects */
 909:libs/alglib/src/ap.h ****     void **pp_obj_ptr;
