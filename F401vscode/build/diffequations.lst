 961:libs/alglib/src/ap.h **** typedef struct ae_shared_pool
 962:libs/alglib/src/ap.h **** {
 963:libs/alglib/src/ap.h ****     /* lock object which protects pool */
 964:libs/alglib/src/ap.h ****     ae_lock pool_lock;
