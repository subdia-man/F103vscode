 714:libs/alglib/src/ap.h ****     ae_int_t bytes_written;
 715:libs/alglib/src/ap.h **** 
 716:libs/alglib/src/ap.h **** #ifdef AE_USE_CPP_SERIALIZATION
 717:libs/alglib/src/ap.h ****     std::string     *out_cppstr;
 718:libs/alglib/src/ap.h **** #endif
 719:libs/alglib/src/ap.h ****     char            *out_str; /* pointer to the current position at the output buffer; advanced wit
 720:libs/alglib/src/ap.h ****     const char      *in_str;  /* pointer to the current position at the input  buffer; advanced wit
 721:libs/alglib/src/ap.h ****     ae_int_t         stream_aux;
 722:libs/alglib/src/ap.h ****     ae_stream_writer stream_writer;
 723:libs/alglib/src/ap.h ****     ae_stream_reader stream_reader;
