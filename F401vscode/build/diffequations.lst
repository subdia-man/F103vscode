2179:libs/alglib/src/ap.h **** /*************************************************************************
2180:libs/alglib/src/ap.h **** This function creates an EMPTY sparse matrix stored in the CRS format.
2181:libs/alglib/src/ap.h **** 
2182:libs/alglib/src/ap.h **** The empty matrix is a degenerate 0*N-dimensional matrix which can be used
2183:libs/alglib/src/ap.h **** ONLY for:
2184:libs/alglib/src/ap.h **** * appending rows with sparseappendcompressedrow()
2185:libs/alglib/src/ap.h **** * appending non-degenerate CRS matrices with sparseappendmatrix()
2186:libs/alglib/src/ap.h **** Before the first row is appended, the matrix is in a special intermediate
2187:libs/alglib/src/ap.h **** state. After the first append it becomes a standard CRS matrix.
2188:libs/alglib/src/ap.h **** 
2189:libs/alglib/src/ap.h **** The main purpose of this function is to simplify step-by-step initialization
2190:libs/alglib/src/ap.h **** of CRS matrices.
2191:libs/alglib/src/ap.h **** 
2192:libs/alglib/src/ap.h **** INPUT PARAMETERS
2193:libs/alglib/src/ap.h ****     N           -   number of columns in a matrix, N>=1
ARM GAS  C:\Users\subdia\AppData\Local\Temp\cc6CrUBc.s 			page 40


2194:libs/alglib/src/ap.h **** 
2195:libs/alglib/src/ap.h **** OUTPUT PARAMETERS
2196:libs/alglib/src/ap.h ****     S           -   sparse 0*N matrix in a partially initialized state
2197:libs/alglib/src/ap.h **** 
2198:libs/alglib/src/ap.h **** NOTE: this function completely  overwrites  S  with  new  sparse  matrix.
2199:libs/alglib/src/ap.h ****       Previously allocated storage is NOT reused. If you  want  to  reuse
2200:libs/alglib/src/ap.h ****       already allocated memory, call SparseCreateCRSEmptyBuf function.
2201:libs/alglib/src/ap.h **** 
2202:libs/alglib/src/ap.h ****   -- ALGLIB PROJECT --
2203:libs/alglib/src/ap.h ****      Copyright 20.02.2024 by Bochkanov Sergey
2204:libs/alglib/src/ap.h **** *************************************************************************/
2205:libs/alglib/src/ap.h **** void sparsecreatecrsempty(const ae_int_t n, sparsematrix &s, const xparams _xparams = alglib::xdefa
2206:libs/alglib/src/ap.h **** 
2207:libs/alglib/src/ap.h **** 
2208:libs/alglib/src/ap.h **** 
2209:libs/alglib/src/ap.h **** 
2210:libs/alglib/src/ap.h **** /*************************************************************************
2211:libs/alglib/src/ap.h **** This function creates an EMPTY sparse matrix stored in the CRS format. It
2212:libs/alglib/src/ap.h **** is a buffered version of the function which  reuses  previosly  allocated
2213:libs/alglib/src/ap.h **** space as much as possible.
2214:libs/alglib/src/ap.h **** 
2215:libs/alglib/src/ap.h **** INPUT PARAMETERS
2216:libs/alglib/src/ap.h ****     N           -   number of columns in a matrix, N>=1
