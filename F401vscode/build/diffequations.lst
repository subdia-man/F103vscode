 969:libs/alglib/src/ap.h ****     /*
 970:libs/alglib/src/ap.h ****      * list of recycled OBJECTS:
 971:libs/alglib/src/ap.h ****      * 1. entries in this list store pointers to recycled objects
 972:libs/alglib/src/ap.h ****      * 2. every time we retrieve object, we retrieve first entry from this list,
 973:libs/alglib/src/ap.h ****      *    move it to recycled_entries and return its obj field to caller/
 974:libs/alglib/src/ap.h ****      */
