 553:libs/alglib/src/ap.h **** /************************************************************************
 554:libs/alglib/src/ap.h **** dynamic block which may be automatically deallocated during stack unwinding
 555:libs/alglib/src/ap.h **** 
 556:libs/alglib/src/ap.h **** p_next          next block in the stack unwinding list.
 557:libs/alglib/src/ap.h ****                 NULL means that this block is not in the list
 558:libs/alglib/src/ap.h **** deallocator     deallocator function which should be used to deallocate block.
 559:libs/alglib/src/ap.h ****                 NULL for "special" blocks (frame/stack boundaries)
 560:libs/alglib/src/ap.h **** ptr             pointer which should be passed to the deallocator.
 561:libs/alglib/src/ap.h ****                 may be null (for zero-size block), DYN_BOTTOM or DYN_FRAME
 562:libs/alglib/src/ap.h ****                 for "special" blocks (frame/stack boundaries).
 563:libs/alglib/src/ap.h **** 
 564:libs/alglib/src/ap.h **** valgrind_hint   is a special field which stores a special hint pointer for
 565:libs/alglib/src/ap.h ****                 Valgrind and other similar memory checking tools.  ALGLIB
 566:libs/alglib/src/ap.h ****                 manually aligns pointers obtained via malloc, so ptr usually
 567:libs/alglib/src/ap.h ****                 points to location past the beginning  of  the  actuallly
 568:libs/alglib/src/ap.h ****                 allocated memory. In such cases memory testing tools  may
 569:libs/alglib/src/ap.h ****                 report "(possibly) lost" memory.
 570:libs/alglib/src/ap.h ****                 
 571:libs/alglib/src/ap.h ****                 This "hint" field stores  pointer  actually  returned  by
 572:libs/alglib/src/ap.h ****                 malloc (or NULL, if for some reason  we  do  not  support
 573:libs/alglib/src/ap.h ****                 this feature). This field is used merely as  a  hint  for
 574:libs/alglib/src/ap.h ****                 Valgrind - it should NOT be used for anything else.
 575:libs/alglib/src/ap.h **** 
 576:libs/alglib/src/ap.h **** ************************************************************************/
 577:libs/alglib/src/ap.h **** typedef struct ae_dyn_block
 578:libs/alglib/src/ap.h **** {
 579:libs/alglib/src/ap.h ****     struct ae_dyn_block * volatile p_next;
 580:libs/alglib/src/ap.h ****     ae_destructor deallocator;
 581:libs/alglib/src/ap.h ****     void * volatile ptr;
 582:libs/alglib/src/ap.h ****     void* valgrind_hint;
 583:libs/alglib/src/ap.h **** } ae_dyn_block;
 584:libs/alglib/src/ap.h **** 
 585:libs/alglib/src/ap.h **** 
