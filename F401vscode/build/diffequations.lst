 433:libs/alglib/src/ap.h **** x-string (zero-terminated):
 434:libs/alglib/src/ap.h ****     owner       ACT_DROP_ON_REALLOC or ACT_XFREE_ON_REALLOC. Determines what to do on realloc().
 435:libs/alglib/src/ap.h ****                 If vector is owned by caller, X-interface  will  just set
 436:libs/alglib/src/ap.h ****                 ptr to NULL before realloc(). If it is  owned  by  X,  it
 437:libs/alglib/src/ap.h ****                 will call ae_free/x_free/aligned_free family functions.
 438:libs/alglib/src/ap.h **** 
 439:libs/alglib/src/ap.h ****     last_action ACT_UNCHANGED, ACT_SAME_LOCATION, ACT_NEW_LOCATION
 440:libs/alglib/src/ap.h ****                 contents is either: unchanged, stored at the same location,
 441:libs/alglib/src/ap.h ****                 stored at the new location.
 442:libs/alglib/src/ap.h ****                 this field is set on return from X.
 443:libs/alglib/src/ap.h **** 
 444:libs/alglib/src/ap.h ****     ptr         pointer to the actual data
 445:libs/alglib/src/ap.h **** 
 446:libs/alglib/src/ap.h **** Members of this structure are ae_int64_t to avoid alignment problems.
 447:libs/alglib/src/ap.h **** ************************************************************************/
 448:libs/alglib/src/ap.h **** typedef struct
 449:libs/alglib/src/ap.h **** {
