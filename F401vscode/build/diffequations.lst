 607:libs/alglib/src/diffequations.cpp **** /*************************************************************************
 608:libs/alglib/src/diffequations.cpp **** Cash-Karp adaptive ODE solver.
 609:libs/alglib/src/diffequations.cpp **** 
 610:libs/alglib/src/diffequations.cpp **** This subroutine solves ODE  Y'=f(Y,x)  with  initial  conditions  Y(xs)=Ys
 611:libs/alglib/src/diffequations.cpp **** (here Y may be single variable or vector of N variables).
 612:libs/alglib/src/diffequations.cpp **** 
 613:libs/alglib/src/diffequations.cpp **** INPUT PARAMETERS:
 614:libs/alglib/src/diffequations.cpp ****     Y       -   initial conditions, array[0..N-1].
 615:libs/alglib/src/diffequations.cpp ****                 contains values of Y[] at X[0]
 616:libs/alglib/src/diffequations.cpp ****     N       -   system size
 617:libs/alglib/src/diffequations.cpp ****     X       -   points at which Y should be tabulated, array[0..M-1]
 618:libs/alglib/src/diffequations.cpp ****                 integrations starts at X[0], ends at X[M-1],  intermediate
 619:libs/alglib/src/diffequations.cpp ****                 values at X[i] are returned too.
 620:libs/alglib/src/diffequations.cpp ****                 SHOULD BE ORDERED BY ASCENDING OR BY DESCENDING!
 621:libs/alglib/src/diffequations.cpp ****     M       -   number of intermediate points + first point + last point:
 622:libs/alglib/src/diffequations.cpp ****                 * M>2 means that you need both Y(X[M-1]) and M-2 values at
 623:libs/alglib/src/diffequations.cpp ****                   intermediate points
 624:libs/alglib/src/diffequations.cpp ****                 * M=2 means that you want just to integrate from  X[0]  to
 625:libs/alglib/src/diffequations.cpp ****                   X[1] and don't interested in intermediate values.
 626:libs/alglib/src/diffequations.cpp ****                 * M=1 means that you don't want to integrate :)
 627:libs/alglib/src/diffequations.cpp ****                   it is degenerate case, but it will be handled correctly.
 628:libs/alglib/src/diffequations.cpp ****                 * M<1 means error
 629:libs/alglib/src/diffequations.cpp ****     Eps     -   tolerance (absolute/relative error on each  step  will  be
 630:libs/alglib/src/diffequations.cpp ****                 less than Eps). When passing:
 631:libs/alglib/src/diffequations.cpp ****                 * Eps>0, it means desired ABSOLUTE error
 632:libs/alglib/src/diffequations.cpp ****                 * Eps<0, it means desired RELATIVE error.  Relative errors
 633:libs/alglib/src/diffequations.cpp ****                   are calculated with respect to maximum values of  Y seen
 634:libs/alglib/src/diffequations.cpp ****                   so far. Be careful to use this criterion  when  starting
 635:libs/alglib/src/diffequations.cpp ****                   from Y[] that are close to zero.
 636:libs/alglib/src/diffequations.cpp ****     H       -   initial  step  lenth,  it  will  be adjusted automatically
 637:libs/alglib/src/diffequations.cpp ****                 after the first  step.  If  H=0,  step  will  be  selected
 638:libs/alglib/src/diffequations.cpp ****                 automatically  (usualy  it  will  be  equal  to  0.001  of
 639:libs/alglib/src/diffequations.cpp ****                 min(x[i]-x[j])).
 640:libs/alglib/src/diffequations.cpp **** 
 641:libs/alglib/src/diffequations.cpp **** OUTPUT PARAMETERS
 642:libs/alglib/src/diffequations.cpp ****     State   -   structure which stores algorithm state between  subsequent
 643:libs/alglib/src/diffequations.cpp ****                 calls of OdeSolverIteration. Used for reverse communication.
 644:libs/alglib/src/diffequations.cpp ****                 This structure should be passed  to the OdeSolverIteration
 645:libs/alglib/src/diffequations.cpp ****                 subroutine.
 646:libs/alglib/src/diffequations.cpp **** 
ARM GAS  C:\Users\subdia\AppData\Local\Temp\cc6CrUBc.s 			page 84


 647:libs/alglib/src/diffequations.cpp **** SEE ALSO
 648:libs/alglib/src/diffequations.cpp ****     AutoGKSmoothW, AutoGKSingular, AutoGKIteration, AutoGKResults.
 649:libs/alglib/src/diffequations.cpp **** 
 650:libs/alglib/src/diffequations.cpp **** 
 651:libs/alglib/src/diffequations.cpp ****   -- ALGLIB --
 652:libs/alglib/src/diffequations.cpp ****      Copyright 01.09.2009 by Bochkanov Sergey
 653:libs/alglib/src/diffequations.cpp **** *************************************************************************/
 654:libs/alglib/src/diffequations.cpp **** void odesolverrkck(/* Real    */ const ae_vector* y,
 655:libs/alglib/src/diffequations.cpp ****      ae_int_t n,
 656:libs/alglib/src/diffequations.cpp ****      /* Real    */ const ae_vector* x,
 657:libs/alglib/src/diffequations.cpp ****      ae_int_t m,
 658:libs/alglib/src/diffequations.cpp ****      double eps,
 659:libs/alglib/src/diffequations.cpp ****      double h,
 660:libs/alglib/src/diffequations.cpp ****      odesolverstate* state,
 661:libs/alglib/src/diffequations.cpp ****      ae_state *_state)
 662:libs/alglib/src/diffequations.cpp **** {
 663:libs/alglib/src/diffequations.cpp **** 
 664:libs/alglib/src/diffequations.cpp ****     _odesolverstate_clear(state);
 665:libs/alglib/src/diffequations.cpp **** 
 666:libs/alglib/src/diffequations.cpp ****     ae_assert(n>=1, "ODESolverRKCK: N<1!", _state);
 667:libs/alglib/src/diffequations.cpp ****     ae_assert(m>=1, "ODESolverRKCK: M<1!", _state);
 668:libs/alglib/src/diffequations.cpp ****     ae_assert(y->cnt>=n, "ODESolverRKCK: Length(Y)<N!", _state);
 669:libs/alglib/src/diffequations.cpp ****     ae_assert(x->cnt>=m, "ODESolverRKCK: Length(X)<M!", _state);
 670:libs/alglib/src/diffequations.cpp ****     ae_assert(isfinitevector(y, n, _state), "ODESolverRKCK: Y contains infinite or NaN values!", _s
 671:libs/alglib/src/diffequations.cpp ****     ae_assert(isfinitevector(x, m, _state), "ODESolverRKCK: Y contains infinite or NaN values!", _s
 672:libs/alglib/src/diffequations.cpp ****     ae_assert(ae_isfinite(eps, _state), "ODESolverRKCK: Eps is not finite!", _state);
 673:libs/alglib/src/diffequations.cpp ****     ae_assert(ae_fp_neq(eps,(double)(0)), "ODESolverRKCK: Eps is zero!", _state);
 674:libs/alglib/src/diffequations.cpp ****     ae_assert(ae_isfinite(h, _state), "ODESolverRKCK: H is not finite!", _state);
 675:libs/alglib/src/diffequations.cpp ****     odesolver_odesolverinit(0, y, n, x, m, eps, h, state, _state);
 676:libs/alglib/src/diffequations.cpp **** }
