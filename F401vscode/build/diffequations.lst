1475:libs/alglib/src/ap.h **** /************************************************************************
1476:libs/alglib/src/ap.h **** Allocation counters, inactive by default.
1477:libs/alglib/src/ap.h **** Turned on when needed for debugging purposes.
1478:libs/alglib/src/ap.h **** 
1479:libs/alglib/src/ap.h **** _alloc_counter is incremented by 1 on malloc(), decremented on free().
1480:libs/alglib/src/ap.h **** _alloc_counter_total is only incremented by 1.
1481:libs/alglib/src/ap.h **** ************************************************************************/
1482:libs/alglib/src/ap.h **** extern ae_int_t   _alloc_counter;
1483:libs/alglib/src/ap.h **** extern ae_int_t   _alloc_counter_total;
1484:libs/alglib/src/ap.h **** extern ae_bool    _use_alloc_counter;
1485:libs/alglib/src/ap.h **** 
1486:libs/alglib/src/ap.h **** 
1487:libs/alglib/src/ap.h **** /************************************************************************
1488:libs/alglib/src/ap.h **** Malloc debugging:
1489:libs/alglib/src/ap.h **** 
1490:libs/alglib/src/ap.h **** * _force_malloc_failure - set this flag to ae_true in  order  to  enforce
1491:libs/alglib/src/ap.h ****   failure of ALGLIB malloc(). Useful to debug handling of  errors  during
1492:libs/alglib/src/ap.h ****   memory allocation. As long as this flag is set, ALGLIB malloc will fail.
1493:libs/alglib/src/ap.h **** * _malloc_failure_after - set it to non-zero value in  order  to  enforce
1494:libs/alglib/src/ap.h ****   malloc failure as soon as _alloc_counter_total increases above value of
1495:libs/alglib/src/ap.h ****   this variable. This value has no effect if  _use_alloc_counter  is  not
1496:libs/alglib/src/ap.h ****   set.
1497:libs/alglib/src/ap.h **** ************************************************************************/
1498:libs/alglib/src/ap.h **** extern ae_bool    _force_malloc_failure;
1499:libs/alglib/src/ap.h **** extern ae_int_t   _malloc_failure_after;
