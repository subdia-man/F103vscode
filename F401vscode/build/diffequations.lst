 860:libs/alglib/src/ap.h **** /*************************************************************************
 861:libs/alglib/src/ap.h **** Lock.
 862:libs/alglib/src/ap.h **** 
 863:libs/alglib/src/ap.h **** This structure provides OS-independent non-reentrant lock:
 864:libs/alglib/src/ap.h **** * under Windows/Posix systems it uses system-provided locks
 865:libs/alglib/src/ap.h **** * under Boost it uses OS-independent lock provided by Boost package
 866:libs/alglib/src/ap.h **** * when no OS is defined, it uses "fake lock" (just stub which is not thread-safe):
 867:libs/alglib/src/ap.h ****   a) "fake lock" can be in locked or free mode
 868:libs/alglib/src/ap.h ****   b) "fake lock" can be used only from one thread - one which created lock
 869:libs/alglib/src/ap.h ****   c) when thread acquires free lock, it immediately returns
 870:libs/alglib/src/ap.h ****   d) when thread acquires busy lock, program is terminated
 871:libs/alglib/src/ap.h ****      (because lock is already acquired and no one else can free it)
 872:libs/alglib/src/ap.h **** *************************************************************************/
 873:libs/alglib/src/ap.h **** typedef struct
 874:libs/alglib/src/ap.h **** {
 875:libs/alglib/src/ap.h ****     /*
 876:libs/alglib/src/ap.h ****      * Pointer to _lock structure. This pointer has type void* in order to
 877:libs/alglib/src/ap.h ****      * make header file OS-independent (lock declaration depends on OS).
 878:libs/alglib/src/ap.h ****      */
 879:libs/alglib/src/ap.h ****     void *lock_ptr;
 880:libs/alglib/src/ap.h ****     
 881:libs/alglib/src/ap.h ****     /*
 882:libs/alglib/src/ap.h ****      * For eternal=false this field manages pointer to _lock structure.
ARM GAS  C:\Users\subdia\AppData\Local\Temp\cc6CrUBc.s 			page 17


 883:libs/alglib/src/ap.h ****      *
 884:libs/alglib/src/ap.h ****      * ae_dyn_block structure is responsible for automatic deletion of
 885:libs/alglib/src/ap.h ****      * the memory allocated for the pointer when its frame is destroyed.
 886:libs/alglib/src/ap.h ****      */
 887:libs/alglib/src/ap.h ****     ae_dyn_block db;
 888:libs/alglib/src/ap.h ****     
 889:libs/alglib/src/ap.h ****     /*
 890:libs/alglib/src/ap.h ****      * Whether we have eternal lock object (used by thread pool) or
 891:libs/alglib/src/ap.h ****      * transient lock. Eternal locks are allocated without using ae_dyn_block
 892:libs/alglib/src/ap.h ****      * structure and do not allow deallocation.
 893:libs/alglib/src/ap.h ****      */
 894:libs/alglib/src/ap.h ****     ae_bool eternal;
 895:libs/alglib/src/ap.h **** } ae_lock;
