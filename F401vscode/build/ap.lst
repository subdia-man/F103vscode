8442:libs/alglib/src/ap.cpp ****                 s += state->querydata.ptr.p_double[qidx*state->queryvars+k]*(1+k+sin(1+k));
8443:libs/alglib/src/ap.cpp ****             state->replyfi.ptr.p_double[qidx] = s*s;
