2472:libs/alglib/src/ap.cpp ****         
2473:libs/alglib/src/ap.cpp ****         p_row = (char*)src->x_ptr.p_ptr;
2474:libs/alglib/src/ap.cpp ****         rowsize = dst->stride*ae_sizeof(dst->datatype);
2475:libs/alglib/src/ap.cpp ****         pp_ptr  = (void**)dst->data.ptr;
2476:libs/alglib/src/ap.cpp ****         dst->ptr.pp_void = pp_ptr;
2477:libs/alglib/src/ap.cpp ****         for(i=0; i<dst->rows; i++, p_row+=rowsize)
2478:libs/alglib/src/ap.cpp ****             pp_ptr[i] = p_row;
2479:libs/alglib/src/ap.cpp ****     }
2480:libs/alglib/src/ap.cpp **** }
