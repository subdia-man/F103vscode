1411:libs/alglib/src/ap.cpp **** /************************************************************************
1412:libs/alglib/src/ap.cpp **** Allocate memory with automatic alignment.
1413:libs/alglib/src/ap.cpp **** 
1414:libs/alglib/src/ap.cpp **** Returns NULL when zero size is specified.
1415:libs/alglib/src/ap.cpp **** 
1416:libs/alglib/src/ap.cpp **** Error handling:
1417:libs/alglib/src/ap.cpp **** * if state is NULL, returns NULL on allocation error
1418:libs/alglib/src/ap.cpp **** * if state is not NULL, calls ae_break() on allocation error
1419:libs/alglib/src/ap.cpp **** ************************************************************************/
1420:libs/alglib/src/ap.cpp **** void* ae_malloc(size_t size, ae_state *state)
1421:libs/alglib/src/ap.cpp **** {
1422:libs/alglib/src/ap.cpp ****     void *result;
1423:libs/alglib/src/ap.cpp ****     if( size==(size_t)0 )
1424:libs/alglib/src/ap.cpp ****         return NULL;
1425:libs/alglib/src/ap.cpp ****     result = aligned_malloc(size,AE_DATA_ALIGN);
1426:libs/alglib/src/ap.cpp ****     if( result==NULL && state!=NULL)
1427:libs/alglib/src/ap.cpp ****         ae_break(state, ERR_OUT_OF_MEMORY, "ae_malloc(): out of memory");
1428:libs/alglib/src/ap.cpp ****     return result;
1429:libs/alglib/src/ap.cpp **** }
1430:libs/alglib/src/ap.cpp **** 
1431:libs/alglib/src/ap.cpp **** /************************************************************************
