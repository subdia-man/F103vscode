2426:libs/alglib/src/ap.cpp ****                     in longjmp call).
2427:libs/alglib/src/ap.cpp **** make_automatic      if true, matrix will be registered in the current frame
2428:libs/alglib/src/ap.cpp ****                     of the state structure;
2429:libs/alglib/src/ap.cpp **** 
2430:libs/alglib/src/ap.cpp **** dst is assumed to be uninitialized, its fields are ignored.
2431:libs/alglib/src/ap.cpp **** ************************************************************************/
2432:libs/alglib/src/ap.cpp **** void ae_matrix_init_attach_to_x(ae_matrix *dst, x_matrix *src, ae_state *state, ae_bool make_automa
2433:libs/alglib/src/ap.cpp **** {
