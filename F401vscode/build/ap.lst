 531:libs/alglib/src/ap.cpp **** 
 532:libs/alglib/src/ap.cpp **** /************************************************************************
 533:libs/alglib/src/ap.cpp **** This function returns index of a current worker thread  that  calls  user
 534:libs/alglib/src/ap.cpp **** callback during parallel numerical differentiation or batch evaluation:
 535:libs/alglib/src/ap.cpp **** 
 536:libs/alglib/src/ap.cpp **** * a value between 0 and max-1 is returned when callback  parallelism  is
 537:libs/alglib/src/ap.cpp ****   enabled (here max depends on the current smp configuration)  and  when
 538:libs/alglib/src/ap.cpp ****   this function is called from a user callback
 539:libs/alglib/src/ap.cpp ****   
 540:libs/alglib/src/ap.cpp **** * 0 is returned when callback parallelism is NOT enabled, or when  called
 541:libs/alglib/src/ap.cpp ****   from outside of a callback.
 542:libs/alglib/src/ap.cpp **** 
ARM GAS  C:\Users\subdia\AppData\Local\Temp\ccz6Svo7.s 			page 11


 543:libs/alglib/src/ap.cpp **** This function is available only in C11/C++11 or later because  it  relies
 544:libs/alglib/src/ap.cpp **** on availability of a portable _Thread_local/thread_local specifier.
 545:libs/alglib/src/ap.cpp **** ************************************************************************/
 546:libs/alglib/src/ap.cpp **** #if defined(_ALGLIB_HAS_THREADLOCAL)
 547:libs/alglib/src/ap.cpp **** ae_int_t ae_get_callback_worker_idx()
 548:libs/alglib/src/ap.cpp **** {
 549:libs/alglib/src/ap.cpp ****     return _cbck_worker_idx;
 550:libs/alglib/src/ap.cpp **** }
 551:libs/alglib/src/ap.cpp **** #endif
 552:libs/alglib/src/ap.cpp **** 
 553:libs/alglib/src/ap.cpp **** 
 554:libs/alglib/src/ap.cpp **** /************************************************************************
 555:libs/alglib/src/ap.cpp **** This function sets index of a  current  worker  thread  that  calls  user
 556:libs/alglib/src/ap.cpp **** callback during parallel numerical differentiation or batch evaluation.
 557:libs/alglib/src/ap.cpp **** 
 558:libs/alglib/src/ap.cpp **** It should be called by the worker once before calling a user callback.
 559:libs/alglib/src/ap.cpp **** 
 560:libs/alglib/src/ap.cpp **** This function is available only in C11/C++11 or later because  it  relies
 561:libs/alglib/src/ap.cpp **** on availability of a portable _Thread_local/thread_local specifier.
 562:libs/alglib/src/ap.cpp **** ************************************************************************/
 563:libs/alglib/src/ap.cpp **** #if defined(_ALGLIB_HAS_THREADLOCAL)
 564:libs/alglib/src/ap.cpp **** void ae_set_callback_worker_idx(ae_int_t idx)
 565:libs/alglib/src/ap.cpp **** {
 566:libs/alglib/src/ap.cpp ****     _cbck_worker_idx = idx;
 567:libs/alglib/src/ap.cpp **** }
 568:libs/alglib/src/ap.cpp **** #endif
 569:libs/alglib/src/ap.cpp **** 
