 505:libs/alglib/src/ap.cpp **** /************************************************************************
 506:libs/alglib/src/ap.cpp **** This function sets default (global) threading model:
 507:libs/alglib/src/ap.cpp **** * serial execution
 508:libs/alglib/src/ap.cpp **** * multithreading, if cores_to_use allows it
 509:libs/alglib/src/ap.cpp **** * serial callbacks
 510:libs/alglib/src/ap.cpp **** * parallel callbacks
 511:libs/alglib/src/ap.cpp **** and vendor backend settings
 512:libs/alglib/src/ap.cpp **** 
 513:libs/alglib/src/ap.cpp **** ************************************************************************/
 514:libs/alglib/src/ap.cpp **** void ae_set_global_flags(ae_uint64_t flg_value)
 515:libs/alglib/src/ap.cpp **** {
 516:libs/alglib/src/ap.cpp ****     AE_CRITICAL_ASSERT((flg_value&_ALGLIB_FLG_THREADING_MASK_WRK)==_ALGLIB_FLG_THREADING_SERIAL ||
 517:libs/alglib/src/ap.cpp ****                        (flg_value&_ALGLIB_FLG_THREADING_MASK_WRK)==_ALGLIB_FLG_THREADING_PARALLEL |
 518:libs/alglib/src/ap.cpp ****                        (flg_value&_ALGLIB_FLG_THREADING_MASK_WRK)==_ALGLIB_FLG_USE_GLOBAL);
 519:libs/alglib/src/ap.cpp ****     AE_CRITICAL_ASSERT((flg_value&_ALGLIB_FLG_THREADING_MASK_CBK)==_ALGLIB_FLG_THREADING_SERIAL_CAL
 520:libs/alglib/src/ap.cpp ****                        (flg_value&_ALGLIB_FLG_THREADING_MASK_CBK)==_ALGLIB_FLG_THREADING_PARALLEL_C
 521:libs/alglib/src/ap.cpp ****                        (flg_value&_ALGLIB_FLG_THREADING_MASK_CBK)==_ALGLIB_FLG_USE_GLOBAL);
 522:libs/alglib/src/ap.cpp ****     AE_CRITICAL_ASSERT((flg_value&_ALGLIB_FLG_BACKEND_MASK_LINALG)==_ALGLIB_FLG_BACKEND_LINALG ||
 523:libs/alglib/src/ap.cpp ****                        (flg_value&_ALGLIB_FLG_BACKEND_MASK_LINALG)==_ALGLIB_FLG_BACKEND_NOLINALG ||
 524:libs/alglib/src/ap.cpp ****                        (flg_value&_ALGLIB_FLG_BACKEND_MASK_LINALG)==_ALGLIB_FLG_USE_GLOBAL);
 525:libs/alglib/src/ap.cpp ****     AE_CRITICAL_ASSERT((flg_value&_ALGLIB_FLG_BACKEND_MASK_DSS)==_ALGLIB_FLG_BACKEND_DSS ||
 526:libs/alglib/src/ap.cpp ****                        (flg_value&_ALGLIB_FLG_BACKEND_MASK_DSS)==_ALGLIB_FLG_BACKEND_NODSS ||
 527:libs/alglib/src/ap.cpp ****                        (flg_value&_ALGLIB_FLG_BACKEND_MASK_DSS)==_ALGLIB_FLG_USE_GLOBAL);
 528:libs/alglib/src/ap.cpp ****     ae_really_weak_store_u64(&_alglib_global_flags, flg_value);
 529:libs/alglib/src/ap.cpp **** }
