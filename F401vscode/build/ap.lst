12545:libs/alglib/src/ap.cpp ****          * pa0 and pa1 are pointing to rows I+1 and I+2.
12546:libs/alglib/src/ap.cpp ****          * move to I+2 and I+3.
12547:libs/alglib/src/ap.cpp ****          */
12548:libs/alglib/src/ap.cpp ****         pa0 += alglib_r_block;
12549:libs/alglib/src/ap.cpp ****         pa1 += alglib_r_block;
12550:libs/alglib/src/ap.cpp ****         pb = x;
12551:libs/alglib/src/ap.cpp ****         y+=2*stride;
12552:libs/alglib/src/ap.cpp ****     }
12553:libs/alglib/src/ap.cpp **** }
12554:libs/alglib/src/ap.cpp **** 
12555:libs/alglib/src/ap.cpp **** 
12556:libs/alglib/src/ap.cpp **** /*************************************************************************
12557:libs/alglib/src/ap.cpp **** This function calculates MxN real matrix-vector product:
12558:libs/alglib/src/ap.cpp **** 
12559:libs/alglib/src/ap.cpp ****     y := beta*y + alpha*A*x
12560:libs/alglib/src/ap.cpp **** 
12561:libs/alglib/src/ap.cpp **** using generic C code. It calls _ialglib_mv_32 if both M=32 and N=32.
12562:libs/alglib/src/ap.cpp **** 
12563:libs/alglib/src/ap.cpp **** If beta is zero, we do not use previous values of y (they are  overwritten
12564:libs/alglib/src/ap.cpp **** by alpha*A*x without ever being read).  If alpha is zero, no matrix-vector
12565:libs/alglib/src/ap.cpp **** product is calculated (only beta is updated); however, this update  is not
12566:libs/alglib/src/ap.cpp **** efficient  and  this  function  should  NOT  be used for multiplication of 
12567:libs/alglib/src/ap.cpp **** vector and scalar.
12568:libs/alglib/src/ap.cpp **** 
12569:libs/alglib/src/ap.cpp **** IMPORTANT:
12570:libs/alglib/src/ap.cpp **** * 0<=M<=alglib_r_block, 0<=N<=alglib_r_block
12571:libs/alglib/src/ap.cpp **** * A must be stored in row-major order with stride equal to alglib_r_block
12572:libs/alglib/src/ap.cpp **** *************************************************************************/
