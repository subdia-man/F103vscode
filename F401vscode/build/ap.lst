2447:libs/alglib/src/ap.cpp ****     ae_assert(cols==src->cols,      "ae_matrix_init_attach_to_x(): 32/64 overflow", state);
2448:libs/alglib/src/ap.cpp ****     ae_assert(rows>=0 && cols>=0,   "ae_matrix_init_attach_to_x(): negative length", state);
2449:libs/alglib/src/ap.cpp ****     
2450:libs/alglib/src/ap.cpp ****     /* if one of rows/cols is zero, another MUST be too */
2451:libs/alglib/src/ap.cpp ****     if( rows==0 || cols==0 )
2452:libs/alglib/src/ap.cpp ****     {
2453:libs/alglib/src/ap.cpp ****         rows = 0;
2454:libs/alglib/src/ap.cpp ****         cols = 0;
2455:libs/alglib/src/ap.cpp ****     }
2456:libs/alglib/src/ap.cpp **** 
2457:libs/alglib/src/ap.cpp ****     /* init, being ready for allocation error */
2458:libs/alglib/src/ap.cpp ****     dst->is_attached = ae_true;
2459:libs/alglib/src/ap.cpp ****     dst->rows = 0;
2460:libs/alglib/src/ap.cpp ****     dst->cols = 0;
2461:libs/alglib/src/ap.cpp ****     dst->stride = cols;
2462:libs/alglib/src/ap.cpp ****     dst->datatype = (ae_datatype)src->datatype;
2463:libs/alglib/src/ap.cpp ****     dst->ptr.pp_void = NULL;
2464:libs/alglib/src/ap.cpp ****     ae_db_init(&dst->data, rows*(ae_int_t)sizeof(void*), state, make_automatic);
2465:libs/alglib/src/ap.cpp ****     dst->rows = rows;
2466:libs/alglib/src/ap.cpp ****     dst->cols = cols;
2467:libs/alglib/src/ap.cpp ****     if( dst->rows>0 && dst->cols>0 )
2468:libs/alglib/src/ap.cpp ****     {
2469:libs/alglib/src/ap.cpp ****         ae_int_t i, rowsize;
2470:libs/alglib/src/ap.cpp ****         char *p_row;
