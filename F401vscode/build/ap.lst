6222:libs/alglib/src/ap.cpp **** /************************************************************************
6223:libs/alglib/src/ap.cpp **** This function clears internal list of  recycled  objects,  but  does  not
6224:libs/alglib/src/ap.cpp **** change seed object managed by the pool.
6225:libs/alglib/src/ap.cpp **** 
6226:libs/alglib/src/ap.cpp **** pool                pool
6227:libs/alglib/src/ap.cpp **** state               ALGLIB environment state
6228:libs/alglib/src/ap.cpp **** 
6229:libs/alglib/src/ap.cpp **** NOTE: this function is NOT thread-safe. It does not acquire pool lock, so
6230:libs/alglib/src/ap.cpp ****       you should NOT call it when lock can be used by another thread.
6231:libs/alglib/src/ap.cpp **** ************************************************************************/
6232:libs/alglib/src/ap.cpp **** void ae_shared_pool_clear_recycled(
6233:libs/alglib/src/ap.cpp ****     ae_shared_pool  *pool,
6234:libs/alglib/src/ap.cpp ****     ae_state        *state)
6235:libs/alglib/src/ap.cpp **** {
6236:libs/alglib/src/ap.cpp ****     ae_shared_pool_entry *ptr, *tmp;
6237:libs/alglib/src/ap.cpp ****     
6238:libs/alglib/src/ap.cpp ****     /*
6239:libs/alglib/src/ap.cpp ****      * acquire pool lock, extract list of recycled objects and immediately release lock
6240:libs/alglib/src/ap.cpp ****      * it is unlikely to happen, but if we crash during memory deallocation, it is better
6241:libs/alglib/src/ap.cpp ****      * to have pool lock released at this moment.
6242:libs/alglib/src/ap.cpp ****      */
6243:libs/alglib/src/ap.cpp ****     ae_acquire_lock(&pool->pool_lock);
6244:libs/alglib/src/ap.cpp ****     ptr=pool->recycled_objects;
6245:libs/alglib/src/ap.cpp ****     pool->recycled_objects = NULL;
6246:libs/alglib/src/ap.cpp ****     ae_release_lock(&pool->pool_lock);
6247:libs/alglib/src/ap.cpp ****     
6248:libs/alglib/src/ap.cpp ****     /* clear recycled objects */
6249:libs/alglib/src/ap.cpp ****     while( ptr!=NULL )
6250:libs/alglib/src/ap.cpp ****     {
6251:libs/alglib/src/ap.cpp ****         tmp = (ae_shared_pool_entry*)ptr->next_entry;
6252:libs/alglib/src/ap.cpp ****         pool->destroy(ptr->obj);
6253:libs/alglib/src/ap.cpp ****         ae_free(ptr->obj);
ARM GAS  C:\Users\subdia\AppData\Local\Temp\ccz6Svo7.s 			page 129


6254:libs/alglib/src/ap.cpp ****         ae_free(ptr);
6255:libs/alglib/src/ap.cpp ****         ptr = tmp;
6256:libs/alglib/src/ap.cpp ****     }
6257:libs/alglib/src/ap.cpp **** }
6258:libs/alglib/src/ap.cpp **** 
6259:libs/alglib/src/ap.cpp **** 
6260:libs/alglib/src/ap.cpp **** /************************************************************************
6261:libs/alglib/src/ap.cpp **** This function allows to enumerate recycled elements of the  shared  pool.
6262:libs/alglib/src/ap.cpp **** It stores pointer to the first recycled object in the smart pointer.
6263:libs/alglib/src/ap.cpp **** 
6264:libs/alglib/src/ap.cpp **** IMPORTANT:
6265:libs/alglib/src/ap.cpp **** * in case target pointer owns non-NULL  value,  it  is deallocated before
6266:libs/alglib/src/ap.cpp ****   storing value retrieved from pool.
6267:libs/alglib/src/ap.cpp **** * recycled object IS NOT removed from pool
6268:libs/alglib/src/ap.cpp **** * target pointer DOES NOT become owner of the new value
6269:libs/alglib/src/ap.cpp **** * this function IS NOT thread-safe
6270:libs/alglib/src/ap.cpp **** * you SHOULD NOT modify shared pool during enumeration (although you  can
6271:libs/alglib/src/ap.cpp ****   modify state of the objects retrieved from pool)
6272:libs/alglib/src/ap.cpp **** * in case there is no recycled objects in the pool, NULL is stored to pptr
6273:libs/alglib/src/ap.cpp **** * in case pool is not seeded, NULL is stored to pptr
6274:libs/alglib/src/ap.cpp **** 
6275:libs/alglib/src/ap.cpp **** pool                pool
6276:libs/alglib/src/ap.cpp **** pptr                pointer to ae_smart_ptr structure
6277:libs/alglib/src/ap.cpp **** state               ALGLIB environment state
6278:libs/alglib/src/ap.cpp **** ************************************************************************/
6279:libs/alglib/src/ap.cpp **** void ae_shared_pool_first_recycled(
6280:libs/alglib/src/ap.cpp ****     ae_shared_pool  *pool,
6281:libs/alglib/src/ap.cpp ****     ae_smart_ptr    *pptr,
6282:libs/alglib/src/ap.cpp ****     ae_state        *state)
6283:libs/alglib/src/ap.cpp **** {   
6284:libs/alglib/src/ap.cpp ****     /* modify internal enumeration counter */
6285:libs/alglib/src/ap.cpp ****     pool->enumeration_counter = pool->recycled_objects;
6286:libs/alglib/src/ap.cpp ****     
6287:libs/alglib/src/ap.cpp ****     /* exit on empty list */
6288:libs/alglib/src/ap.cpp ****     if( pool->enumeration_counter==NULL )
6289:libs/alglib/src/ap.cpp ****     {
6290:libs/alglib/src/ap.cpp ****         ae_smart_ptr_assign(pptr, NULL, ae_false, ae_false, 0, NULL, NULL);
6291:libs/alglib/src/ap.cpp ****         return;
6292:libs/alglib/src/ap.cpp ****     }
6293:libs/alglib/src/ap.cpp ****     
6294:libs/alglib/src/ap.cpp ****     /* assign object to smart pointer */
6295:libs/alglib/src/ap.cpp ****     ae_smart_ptr_assign(pptr, pool->enumeration_counter->obj, ae_false, ae_false, 0, NULL, NULL);
6296:libs/alglib/src/ap.cpp **** }
6297:libs/alglib/src/ap.cpp **** 
6298:libs/alglib/src/ap.cpp **** 
6299:libs/alglib/src/ap.cpp **** /************************************************************************
6300:libs/alglib/src/ap.cpp **** This function allows to enumerate recycled elements of the  shared  pool.
6301:libs/alglib/src/ap.cpp **** It stores pointer to the next recycled object in the smart pointer.
