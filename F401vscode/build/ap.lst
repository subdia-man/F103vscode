2768:libs/alglib/src/ap.h ****     
2769:libs/alglib/src/ap.h ****     //
2770:libs/alglib/src/ap.h ****     // Creates a copy of another vector (can be reference to one of the derived classes)
2771:libs/alglib/src/ap.h ****     //
2772:libs/alglib/src/ap.h ****     // NOTE: this function also checks that source ae_vector* has
2773:libs/alglib/src/ap.h ****     //       required datatype. An exception is generated otherwise.
2774:libs/alglib/src/ap.h ****     //
2775:libs/alglib/src/ap.h ****     ae_vector_wrapper(const ae_vector_wrapper &rhs, alglib_impl::ae_datatype datatype);
2776:libs/alglib/src/ap.h ****     
2777:libs/alglib/src/ap.h ****     //
2778:libs/alglib/src/ap.h ****     // Well, it is destructor...
2779:libs/alglib/src/ap.h ****     //
2780:libs/alglib/src/ap.h ****     virtual ~ae_vector_wrapper();
2781:libs/alglib/src/ap.h **** 
2782:libs/alglib/src/ap.h ****     //
2783:libs/alglib/src/ap.h ****     // For wrapper object allocated with allocate_own() this function
2784:libs/alglib/src/ap.h ****     // changes length, completely dropping previous contents.
2785:libs/alglib/src/ap.h ****     //
2786:libs/alglib/src/ap.h ****     // It does not work (throws exception) for frozen proxy objects.
2787:libs/alglib/src/ap.h ****     //
2788:libs/alglib/src/ap.h ****     void setlength(ae_int_t iLen);
2789:libs/alglib/src/ap.h ****     
2790:libs/alglib/src/ap.h ****     //
