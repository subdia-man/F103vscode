2543:libs/alglib/src/ap.cpp ****     dst->cols = 0;
2544:libs/alglib/src/ap.cpp ****     dst->stride = 0;
2545:libs/alglib/src/ap.cpp ****     ae_db_free(&dst->data);
2546:libs/alglib/src/ap.cpp ****     dst->ptr.p_ptr = 0;
2547:libs/alglib/src/ap.cpp ****     dst->is_attached = ae_false;
2548:libs/alglib/src/ap.cpp **** }
