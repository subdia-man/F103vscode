3353:libs/alglib/src/ap.cpp ****     
3354:libs/alglib/src/ap.cpp ****     /* append ptr */
3355:libs/alglib/src/ap.cpp ****     if( ptr->ptr!=NULL )
3356:libs/alglib/src/ap.cpp ****     {
3357:libs/alglib/src/ap.cpp ****         /* move to array */
3358:libs/alglib/src/ap.cpp ****         arr->pp_obj_ptr[cnt] = ptr->ptr;
3359:libs/alglib/src/ap.cpp ****         arr->pp_obj_sizes[cnt] = ptr->size_of_object;
3360:libs/alglib/src/ap.cpp ****         arr->pp_copy[cnt] = ptr->copy_constructor;
3361:libs/alglib/src/ap.cpp ****         arr->pp_destroy[cnt] = ptr->destructor;
