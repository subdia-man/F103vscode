1455:libs/alglib/src/ap.cpp **** Sets pointers to the matrix rows.
1456:libs/alglib/src/ap.cpp **** 
1457:libs/alglib/src/ap.cpp **** * dst must be correctly initialized matrix
1458:libs/alglib/src/ap.cpp **** * dst->data.ptr points to the beginning of memory block  allocated  for  
1459:libs/alglib/src/ap.cpp ****   row pointers.
1460:libs/alglib/src/ap.cpp **** * dst->ptr - undefined (initialized during algorithm processing)
1461:libs/alglib/src/ap.cpp **** * storage parameter points to the beginning of actual storage
1462:libs/alglib/src/ap.cpp **** ************************************************************************/
1463:libs/alglib/src/ap.cpp **** void ae_matrix_update_row_pointers(ae_matrix *dst, void *storage)
1464:libs/alglib/src/ap.cpp **** {
1465:libs/alglib/src/ap.cpp ****     char *p_base;
