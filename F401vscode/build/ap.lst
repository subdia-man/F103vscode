4383:libs/alglib/src/ap.cpp **** /*
4384:libs/alglib/src/ap.cpp ****  * this function checks difference between offdiagonal blocks BL and BU
4385:libs/alglib/src/ap.cpp ****  * (see below). Block BL is specified by offsets (offset0,offset1)  and
4386:libs/alglib/src/ap.cpp ****  * sizes (len0,len1).
4387:libs/alglib/src/ap.cpp ****  *
4388:libs/alglib/src/ap.cpp ****  *     [ .          ]
4389:libs/alglib/src/ap.cpp ****  *     [   A0  BU   ]
4390:libs/alglib/src/ap.cpp ****  * A = [   BL  A1   ]
4391:libs/alglib/src/ap.cpp ****  *     [          . ]
4392:libs/alglib/src/ap.cpp ****  *
4393:libs/alglib/src/ap.cpp ****  *  this subroutine updates current values of:
4394:libs/alglib/src/ap.cpp ****  *  a) mx       maximum value of A[i,j] found so far
4395:libs/alglib/src/ap.cpp ****  *  b) err      componentwise difference between elements of BL and BU^T
4396:libs/alglib/src/ap.cpp ****  *
4397:libs/alglib/src/ap.cpp ****  */
4398:libs/alglib/src/ap.cpp **** static void is_symmetric_rec_off_stat(x_matrix *a, ae_int_t offset0, ae_int_t offset1, ae_int_t len
