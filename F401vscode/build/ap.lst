15023:libs/alglib/src/ap.cpp **** {
15024:libs/alglib/src/ap.cpp ****     ae_int_t n2, j, stride2;
15025:libs/alglib/src/ap.cpp ****     
15026:libs/alglib/src/ap.cpp ****     /*
