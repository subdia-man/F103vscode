18571:libs/alglib/src/ap.cpp ****         }
18572:libs/alglib/src/ap.cpp ****         simdbuf->ptr.p_double[i*simdwidth] = v;
18573:libs/alglib/src/ap.cpp ****     }
18574:libs/alglib/src/ap.cpp **** }
