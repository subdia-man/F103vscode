3592:libs/alglib/src/ap.cpp **** Assertion
3593:libs/alglib/src/ap.cpp **** 
3594:libs/alglib/src/ap.cpp **** For  non-NULL  state  it  allows  to  gracefully  leave  ALGLIB  session,
3595:libs/alglib/src/ap.cpp **** removing all frames and deallocating registered dynamic data structure.
3596:libs/alglib/src/ap.cpp **** 
3597:libs/alglib/src/ap.cpp **** For NULL state it just abort()'s program.
3598:libs/alglib/src/ap.cpp **** 
3599:libs/alglib/src/ap.cpp **** IMPORTANT: this function ALWAYS evaluates its argument.  It  can  not  be
3600:libs/alglib/src/ap.cpp ****            replaced by macro which does nothing. So, you may place actual
3601:libs/alglib/src/ap.cpp ****            function calls at cond, and these will always be performed.
3602:libs/alglib/src/ap.cpp **** ************************************************************************/
3603:libs/alglib/src/ap.cpp **** void ae_assert(ae_bool cond, const char *msg, ae_state *state)
3604:libs/alglib/src/ap.cpp **** {
3605:libs/alglib/src/ap.cpp ****     if( !cond )
3606:libs/alglib/src/ap.cpp ****         ae_break(state, ERR_ASSERTION_FAILED, msg);
3607:libs/alglib/src/ap.cpp **** }
