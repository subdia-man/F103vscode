6152:libs/alglib/src/ap.cpp **** /************************************************************************
6153:libs/alglib/src/ap.cpp **** This function recycles object owned by smart  pointer  by  moving  it  to
6154:libs/alglib/src/ap.cpp **** internal storage of the shared pool.
6155:libs/alglib/src/ap.cpp **** 
6156:libs/alglib/src/ap.cpp **** Source pointer must own the object. After function is over, it owns NULL
6157:libs/alglib/src/ap.cpp **** pointer.
6158:libs/alglib/src/ap.cpp **** 
6159:libs/alglib/src/ap.cpp **** pool                pool
6160:libs/alglib/src/ap.cpp **** pptr                pointer to ae_smart_ptr structure
6161:libs/alglib/src/ap.cpp **** state               ALGLIB environment state
6162:libs/alglib/src/ap.cpp **** 
6163:libs/alglib/src/ap.cpp **** NOTE: this function IS thread-safe.  It  acquires  pool  lock  during its
6164:libs/alglib/src/ap.cpp ****       operation and can be used simultaneously from several threads.
6165:libs/alglib/src/ap.cpp **** ************************************************************************/
6166:libs/alglib/src/ap.cpp **** void ae_shared_pool_recycle(
6167:libs/alglib/src/ap.cpp ****     ae_shared_pool  *pool,
6168:libs/alglib/src/ap.cpp ****     ae_smart_ptr    *pptr,
6169:libs/alglib/src/ap.cpp ****     ae_state        *state)
6170:libs/alglib/src/ap.cpp **** {
6171:libs/alglib/src/ap.cpp ****     ae_shared_pool_entry *new_entry;
6172:libs/alglib/src/ap.cpp ****     
6173:libs/alglib/src/ap.cpp ****     /* state!=NULL, allocation errors are handled by throwing exception from ae_malloc() */
6174:libs/alglib/src/ap.cpp ****     AE_CRITICAL_ASSERT(state!=NULL);
6175:libs/alglib/src/ap.cpp ****     
6176:libs/alglib/src/ap.cpp ****     /* assert that pool was seeded */
6177:libs/alglib/src/ap.cpp ****     ae_assert(
6178:libs/alglib/src/ap.cpp ****         pool->seed_object!=NULL,
6179:libs/alglib/src/ap.cpp ****         "ALGLIB: shared pool is not seeded, PoolRecycle() failed",
6180:libs/alglib/src/ap.cpp ****         state);
6181:libs/alglib/src/ap.cpp ****     
6182:libs/alglib/src/ap.cpp ****     /* assert that pointer non-null and owns the object */
6183:libs/alglib/src/ap.cpp ****     ae_assert(pptr->is_owner,  "ALGLIB: pptr in ae_shared_pool_recycle() does not own its pointer",
6184:libs/alglib/src/ap.cpp ****     ae_assert(pptr->ptr!=NULL, "ALGLIB: pptr in ae_shared_pool_recycle() is NULL", state);
6185:libs/alglib/src/ap.cpp ****     
6186:libs/alglib/src/ap.cpp ****     /* acquire lock */
6187:libs/alglib/src/ap.cpp ****     ae_acquire_lock(&pool->pool_lock);
6188:libs/alglib/src/ap.cpp ****     
6189:libs/alglib/src/ap.cpp ****     /* acquire shared pool entry (reuse one from recycled_entries or allocate new one) */
6190:libs/alglib/src/ap.cpp ****     if( pool->recycled_entries!=NULL )
6191:libs/alglib/src/ap.cpp ****     {
6192:libs/alglib/src/ap.cpp ****         /* reuse previously allocated entry */
6193:libs/alglib/src/ap.cpp ****         new_entry = pool->recycled_entries;
6194:libs/alglib/src/ap.cpp ****         pool->recycled_entries = (ae_shared_pool_entry*)new_entry->next_entry;
6195:libs/alglib/src/ap.cpp ****     }
6196:libs/alglib/src/ap.cpp ****     else
ARM GAS  C:\Users\subdia\AppData\Local\Temp\ccz6Svo7.s 			page 128


6197:libs/alglib/src/ap.cpp ****     {
6198:libs/alglib/src/ap.cpp ****         /*
6199:libs/alglib/src/ap.cpp ****          * Allocate memory for new entry.
6200:libs/alglib/src/ap.cpp ****          *
6201:libs/alglib/src/ap.cpp ****          * NOTE: we release pool lock during allocation because ae_malloc() may raise
6202:libs/alglib/src/ap.cpp ****          *       exception and we do not want our pool to be left in the locked state.
6203:libs/alglib/src/ap.cpp ****          */
6204:libs/alglib/src/ap.cpp ****         ae_release_lock(&pool->pool_lock);
6205:libs/alglib/src/ap.cpp ****         new_entry =  (ae_shared_pool_entry*)ae_malloc(sizeof(ae_shared_pool_entry), state);
6206:libs/alglib/src/ap.cpp ****         ae_acquire_lock(&pool->pool_lock);
6207:libs/alglib/src/ap.cpp ****     }
6208:libs/alglib/src/ap.cpp ****     
6209:libs/alglib/src/ap.cpp ****     /* add object to the list of recycled objects */
6210:libs/alglib/src/ap.cpp ****     new_entry->obj = pptr->ptr;
6211:libs/alglib/src/ap.cpp ****     new_entry->next_entry = pool->recycled_objects;
6212:libs/alglib/src/ap.cpp ****     pool->recycled_objects = new_entry;
6213:libs/alglib/src/ap.cpp ****     
6214:libs/alglib/src/ap.cpp ****     /* release lock object */
6215:libs/alglib/src/ap.cpp ****     ae_release_lock(&pool->pool_lock);
6216:libs/alglib/src/ap.cpp ****     
6217:libs/alglib/src/ap.cpp ****     /* release source pointer */
6218:libs/alglib/src/ap.cpp ****     ae_smart_ptr_release(pptr);
6219:libs/alglib/src/ap.cpp **** }
