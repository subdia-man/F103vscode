4364:libs/alglib/src/ap.cpp **** static double x_safepythag2(double x, double y)
4365:libs/alglib/src/ap.cpp **** {
4366:libs/alglib/src/ap.cpp ****     double w;
4367:libs/alglib/src/ap.cpp ****     double xabs;
4368:libs/alglib/src/ap.cpp ****     double yabs;
4369:libs/alglib/src/ap.cpp ****     double z;
