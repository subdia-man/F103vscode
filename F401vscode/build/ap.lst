12524:libs/alglib/src/ap.cpp ****             v0 += pa0[2]*pb[2];
12525:libs/alglib/src/ap.cpp ****             v1 += pa1[2]*pb[2];
12526:libs/alglib/src/ap.cpp ****             v0 += pa0[3]*pb[3];
12527:libs/alglib/src/ap.cpp ****             v1 += pa1[3]*pb[3];
12528:libs/alglib/src/ap.cpp ****             v0 += pa0[4]*pb[4];
12529:libs/alglib/src/ap.cpp ****             v1 += pa1[4]*pb[4];
12530:libs/alglib/src/ap.cpp ****             v0 += pa0[5]*pb[5];
12531:libs/alglib/src/ap.cpp ****             v1 += pa1[5]*pb[5];
12532:libs/alglib/src/ap.cpp ****             v0 += pa0[6]*pb[6];
12533:libs/alglib/src/ap.cpp ****             v1 += pa1[6]*pb[6];
12534:libs/alglib/src/ap.cpp ****             v0 += pa0[7]*pb[7];
