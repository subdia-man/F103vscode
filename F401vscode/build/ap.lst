5593:libs/alglib/src/ap.cpp **** #else
5594:libs/alglib/src/ap.cpp ****     #if AE_OS==AE_WINDOWS
5595:libs/alglib/src/ap.cpp ****         #if defined(_WIN32_WINNT) && (_WIN32_WINNT>=0x0501)
5596:libs/alglib/src/ap.cpp ****             if( !SwitchToThread() )
