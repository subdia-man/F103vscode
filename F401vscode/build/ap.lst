1469:libs/alglib/src/ap.cpp ****     {
1470:libs/alglib/src/ap.cpp ****         p_base = (char*)storage;
1471:libs/alglib/src/ap.cpp ****         pp_ptr = (void**)dst->data.ptr;
1472:libs/alglib/src/ap.cpp ****         dst->ptr.pp_void = pp_ptr;
1473:libs/alglib/src/ap.cpp ****         for(i=0; i<dst->rows; i++, p_base+=dst->stride*ae_sizeof(dst->datatype))
1474:libs/alglib/src/ap.cpp ****             pp_ptr[i] = p_base;
1475:libs/alglib/src/ap.cpp ****     }
1476:libs/alglib/src/ap.cpp ****     else
