13063:libs/alglib/src/ap.cpp **** /*************************************************************************
13064:libs/alglib/src/ap.cpp **** This subroutine calculates fast MxN complex matrix-vector product:
13065:libs/alglib/src/ap.cpp **** 
13066:libs/alglib/src/ap.cpp ****     y := beta*y + alpha*A*x
13067:libs/alglib/src/ap.cpp **** 
13068:libs/alglib/src/ap.cpp **** using generic C code, where A, x, y, alpha and beta are complex.
13069:libs/alglib/src/ap.cpp **** 
13070:libs/alglib/src/ap.cpp **** If beta is zero, we do not use previous values of y (they are  overwritten
13071:libs/alglib/src/ap.cpp **** by alpha*A*x without ever being read). However, when  alpha  is  zero,  we 
13072:libs/alglib/src/ap.cpp **** still calculate A*x and  multiply  it  by  alpha  (this distinction can be
13073:libs/alglib/src/ap.cpp **** important when A or x contain infinities/NANs).
13074:libs/alglib/src/ap.cpp **** 
13075:libs/alglib/src/ap.cpp **** IMPORTANT:
13076:libs/alglib/src/ap.cpp **** * 0<=M<=alglib_c_block, 0<=N<=alglib_c_block
13077:libs/alglib/src/ap.cpp **** * A must be stored in row-major order, as sequence of double precision
13078:libs/alglib/src/ap.cpp ****   pairs. Stride is alglib_c_block (it is measured in pairs of doubles, not
13079:libs/alglib/src/ap.cpp ****   in doubles).
13080:libs/alglib/src/ap.cpp **** * Y may be referenced by cy (pointer to ae_complex) or
13081:libs/alglib/src/ap.cpp ****   dy (pointer to array of double precision pair) depending on what type of 
13082:libs/alglib/src/ap.cpp ****   output you wish. Pass pointer to Y as one of these parameters,
13083:libs/alglib/src/ap.cpp ****   AND SET OTHER PARAMETER TO NULL.
13084:libs/alglib/src/ap.cpp **** * both A and x must be aligned; y may be non-aligned.
13085:libs/alglib/src/ap.cpp **** *************************************************************************/
13086:libs/alglib/src/ap.cpp **** void _ialglib_cmv(ae_int_t m, ae_int_t n, const double *a, const double *x, ae_complex *cy, double 
13087:libs/alglib/src/ap.cpp **** {
13088:libs/alglib/src/ap.cpp ****     ae_int_t i, j;
13089:libs/alglib/src/ap.cpp ****     const double *pa, *parow, *pb;
13090:libs/alglib/src/ap.cpp **** 
13091:libs/alglib/src/ap.cpp ****     parow = a;
13092:libs/alglib/src/ap.cpp ****     for(i=0; i<m; i++)
