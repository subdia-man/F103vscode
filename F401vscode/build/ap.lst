18212:libs/alglib/src/ap.cpp **** /*************************************************************************
18213:libs/alglib/src/ap.cpp **** This subroutine solves linear system op(A)*x=b where:
18214:libs/alglib/src/ap.cpp **** * A is NxN upper/lower triangular/unitriangular matrix
18215:libs/alglib/src/ap.cpp **** * X and B are Nx1 vectors
18216:libs/alglib/src/ap.cpp **** * "op" may be identity transformation or transposition
18217:libs/alglib/src/ap.cpp **** 
18218:libs/alglib/src/ap.cpp **** Solution replaces X.
18219:libs/alglib/src/ap.cpp **** 
18220:libs/alglib/src/ap.cpp **** IMPORTANT: * no overflow/underflow/denegeracy tests is performed.
18221:libs/alglib/src/ap.cpp ****            * no integrity checks for operand sizes, out-of-bounds accesses
18222:libs/alglib/src/ap.cpp ****              and so on is performed
18223:libs/alglib/src/ap.cpp **** 
18224:libs/alglib/src/ap.cpp **** INPUT PARAMETERS
18225:libs/alglib/src/ap.cpp ****     N   -   matrix size, N>=0
18226:libs/alglib/src/ap.cpp ****     A       -   matrix, actial matrix is stored in A[IA:IA+N-1,JA:JA+N-1]
18227:libs/alglib/src/ap.cpp ****     IA      -   submatrix offset
18228:libs/alglib/src/ap.cpp ****     JA      -   submatrix offset
18229:libs/alglib/src/ap.cpp ****     IsUpper -   whether matrix is upper triangular
18230:libs/alglib/src/ap.cpp ****     IsUnit  -   whether matrix is unitriangular
18231:libs/alglib/src/ap.cpp ****     OpType  -   transformation type:
18232:libs/alglib/src/ap.cpp ****                 * 0 - no transformation
18233:libs/alglib/src/ap.cpp ****                 * 1 - transposition
18234:libs/alglib/src/ap.cpp ****     X       -   right part, actual vector is stored in X[IX:IX+N-1]
18235:libs/alglib/src/ap.cpp ****     IX      -   offset
18236:libs/alglib/src/ap.cpp ****     
18237:libs/alglib/src/ap.cpp **** OUTPUT PARAMETERS
18238:libs/alglib/src/ap.cpp ****     X       -   solution replaces elements X[IX:IX+N-1]
18239:libs/alglib/src/ap.cpp **** 
18240:libs/alglib/src/ap.cpp ****   -- ALGLIB routine --
18241:libs/alglib/src/ap.cpp ****      (c) 07.09.2021 Bochkanov Sergey
18242:libs/alglib/src/ap.cpp **** *************************************************************************/
18243:libs/alglib/src/ap.cpp **** void rtrsvx(ae_int_t n,
18244:libs/alglib/src/ap.cpp ****      /* Real    */ const ae_matrix* a,
18245:libs/alglib/src/ap.cpp ****      ae_int_t ia,
18246:libs/alglib/src/ap.cpp ****      ae_int_t ja,
18247:libs/alglib/src/ap.cpp ****      ae_bool isupper,
18248:libs/alglib/src/ap.cpp ****      ae_bool isunit,
18249:libs/alglib/src/ap.cpp ****      ae_int_t optype,
18250:libs/alglib/src/ap.cpp ****      /* Real    */ ae_vector* x,
18251:libs/alglib/src/ap.cpp ****      ae_int_t ix,
18252:libs/alglib/src/ap.cpp ****      ae_state *_state)
18253:libs/alglib/src/ap.cpp **** {
18254:libs/alglib/src/ap.cpp ****     ae_int_t i;
18255:libs/alglib/src/ap.cpp ****     ae_int_t j;
18256:libs/alglib/src/ap.cpp ****     double v;
18257:libs/alglib/src/ap.cpp **** 
18258:libs/alglib/src/ap.cpp **** 
18259:libs/alglib/src/ap.cpp ****     if( n<=0 )
18260:libs/alglib/src/ap.cpp ****     {
18261:libs/alglib/src/ap.cpp ****         return;
18262:libs/alglib/src/ap.cpp ****     }
18263:libs/alglib/src/ap.cpp ****     if( optype==0&&isupper )
ARM GAS  C:\Users\subdia\AppData\Local\Temp\ccz6Svo7.s 			page 407


18264:libs/alglib/src/ap.cpp ****     {
18265:libs/alglib/src/ap.cpp ****         for(i=n-1; i>=0; i--)
18266:libs/alglib/src/ap.cpp ****         {
18267:libs/alglib/src/ap.cpp ****             v = x->ptr.p_double[ix+i];
18268:libs/alglib/src/ap.cpp ****             for(j=i+1; j<=n-1; j++)
18269:libs/alglib/src/ap.cpp ****             {
18270:libs/alglib/src/ap.cpp ****                 v = v-a->ptr.pp_double[ia+i][ja+j]*x->ptr.p_double[ix+j];
18271:libs/alglib/src/ap.cpp ****             }
18272:libs/alglib/src/ap.cpp ****             if( !isunit )
18273:libs/alglib/src/ap.cpp ****             {
18274:libs/alglib/src/ap.cpp ****                 v = v/a->ptr.pp_double[ia+i][ja+i];
18275:libs/alglib/src/ap.cpp ****             }
18276:libs/alglib/src/ap.cpp ****             x->ptr.p_double[ix+i] = v;
18277:libs/alglib/src/ap.cpp ****         }
18278:libs/alglib/src/ap.cpp ****         return;
18279:libs/alglib/src/ap.cpp ****     }
18280:libs/alglib/src/ap.cpp ****     if( optype==0&&!isupper )
18281:libs/alglib/src/ap.cpp ****     {
18282:libs/alglib/src/ap.cpp ****         for(i=0; i<=n-1; i++)
18283:libs/alglib/src/ap.cpp ****         {
18284:libs/alglib/src/ap.cpp ****             v = x->ptr.p_double[ix+i];
18285:libs/alglib/src/ap.cpp ****             for(j=0; j<=i-1; j++)
18286:libs/alglib/src/ap.cpp ****             {
18287:libs/alglib/src/ap.cpp ****                 v = v-a->ptr.pp_double[ia+i][ja+j]*x->ptr.p_double[ix+j];
18288:libs/alglib/src/ap.cpp ****             }
18289:libs/alglib/src/ap.cpp ****             if( !isunit )
