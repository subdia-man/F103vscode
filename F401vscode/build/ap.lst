8755:libs/alglib/src/ap.cpp ****         return std::string(x>0.0 ? "" : "-")+buf_x;
8756:libs/alglib/src/ap.cpp ****     if( strcmp(buf_x,buf_zero)==0 && strcmp(buf_y,buf_zero)!=0 )
8757:libs/alglib/src/ap.cpp ****         return std::string(y>0.0 ? "" : "-")+buf_y+"i";
