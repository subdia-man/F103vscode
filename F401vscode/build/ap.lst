5543:libs/alglib/src/ap.cpp ****     ae_foursixbits2threebytes(sixbits+4, u.bytes+3);
5544:libs/alglib/src/ap.cpp ****     ae_foursixbits2threebytes(sixbits+8, u.bytes+6);
