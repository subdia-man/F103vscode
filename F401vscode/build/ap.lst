17894:libs/alglib/src/ap.cpp **** /*************************************************************************
17895:libs/alglib/src/ap.cpp **** Matrix-vector product: y := alpha*op(A)*x + beta*y
17896:libs/alglib/src/ap.cpp **** 
17897:libs/alglib/src/ap.cpp **** NOTE: this  function  expects  Y  to  be  large enough to store result. No
17898:libs/alglib/src/ap.cpp ****       automatic preallocation happens for  smaller  arrays.  No  integrity
17899:libs/alglib/src/ap.cpp ****       checks is performed for sizes of A, x, y.
17900:libs/alglib/src/ap.cpp **** 
17901:libs/alglib/src/ap.cpp **** INPUT PARAMETERS:
17902:libs/alglib/src/ap.cpp ****     M   -   number of rows of op(A)
17903:libs/alglib/src/ap.cpp ****     N   -   number of columns of op(A)
17904:libs/alglib/src/ap.cpp ****     Alpha-  coefficient
17905:libs/alglib/src/ap.cpp ****     A   -   source matrix
17906:libs/alglib/src/ap.cpp ****     OpA -   operation type:
17907:libs/alglib/src/ap.cpp ****             * OpA=0     =>  op(A) = A
17908:libs/alglib/src/ap.cpp ****             * OpA=1     =>  op(A) = A^T
17909:libs/alglib/src/ap.cpp ****     X   -   input vector, has at least N elements
17910:libs/alglib/src/ap.cpp ****     Beta-   coefficient
17911:libs/alglib/src/ap.cpp ****     Y   -   preallocated output array, has at least M elements
17912:libs/alglib/src/ap.cpp **** 
17913:libs/alglib/src/ap.cpp **** OUTPUT PARAMETERS:
17914:libs/alglib/src/ap.cpp ****     Y   -   vector which stores result
17915:libs/alglib/src/ap.cpp **** 
17916:libs/alglib/src/ap.cpp **** HANDLING OF SPECIAL CASES:
17917:libs/alglib/src/ap.cpp ****     * if M=0, then subroutine does nothing. It does not even touch arrays.
17918:libs/alglib/src/ap.cpp ****     * if N=0 or Alpha=0.0, then:
17919:libs/alglib/src/ap.cpp ****       * if Beta=0, then Y is filled by zeros. A and X are  not  referenced
17920:libs/alglib/src/ap.cpp ****         at all. Initial values of Y are ignored (we do not  multiply  Y by
17921:libs/alglib/src/ap.cpp ****         zero, we just rewrite it by zeros)
ARM GAS  C:\Users\subdia\AppData\Local\Temp\ccz6Svo7.s 			page 401


17922:libs/alglib/src/ap.cpp ****       * if Beta<>0, then Y is replaced by Beta*Y
17923:libs/alglib/src/ap.cpp ****     * if M>0, N>0, Alpha<>0, but  Beta=0,  then  Y  is  replaced  by  A*x;
17924:libs/alglib/src/ap.cpp ****        initial state of Y is ignored (rewritten by  A*x,  without  initial
17925:libs/alglib/src/ap.cpp ****        multiplication by zeros).
17926:libs/alglib/src/ap.cpp **** 
17927:libs/alglib/src/ap.cpp **** 
17928:libs/alglib/src/ap.cpp ****   -- ALGLIB routine --
17929:libs/alglib/src/ap.cpp **** 
17930:libs/alglib/src/ap.cpp ****      01.09.2021
17931:libs/alglib/src/ap.cpp ****      Bochkanov Sergey
17932:libs/alglib/src/ap.cpp **** *************************************************************************/
17933:libs/alglib/src/ap.cpp **** void rgemv(ae_int_t m,
17934:libs/alglib/src/ap.cpp ****      ae_int_t n,
17935:libs/alglib/src/ap.cpp ****      double alpha,
17936:libs/alglib/src/ap.cpp ****      /* Real    */ const ae_matrix* a,
17937:libs/alglib/src/ap.cpp ****      ae_int_t opa,
17938:libs/alglib/src/ap.cpp ****      /* Real    */ const ae_vector* x,
17939:libs/alglib/src/ap.cpp ****      double beta,
17940:libs/alglib/src/ap.cpp ****      /* Real    */ ae_vector* y,
17941:libs/alglib/src/ap.cpp ****      ae_state *_state)
17942:libs/alglib/src/ap.cpp **** {
17943:libs/alglib/src/ap.cpp ****     ae_int_t i;
17944:libs/alglib/src/ap.cpp ****     ae_int_t j;
17945:libs/alglib/src/ap.cpp ****     double v;
17946:libs/alglib/src/ap.cpp **** 
17947:libs/alglib/src/ap.cpp **** 
17948:libs/alglib/src/ap.cpp ****     
17949:libs/alglib/src/ap.cpp ****     /*
17950:libs/alglib/src/ap.cpp ****      * Properly premultiply Y by Beta.
17951:libs/alglib/src/ap.cpp ****      *
17952:libs/alglib/src/ap.cpp ****      * Quick exit for M=0, N=0 or Alpha=0.
17953:libs/alglib/src/ap.cpp ****      * After this block we have M>0, N>0, Alpha<>0.
17954:libs/alglib/src/ap.cpp ****      */
17955:libs/alglib/src/ap.cpp ****     if( m<=0 )
17956:libs/alglib/src/ap.cpp ****     {
17957:libs/alglib/src/ap.cpp ****         return;
17958:libs/alglib/src/ap.cpp ****     }
17959:libs/alglib/src/ap.cpp ****     if( ae_fp_neq(beta,(double)(0)) )
17960:libs/alglib/src/ap.cpp ****     {
17961:libs/alglib/src/ap.cpp ****         rmulv(m, beta, y, _state);
17962:libs/alglib/src/ap.cpp ****     }
17963:libs/alglib/src/ap.cpp ****     else
17964:libs/alglib/src/ap.cpp ****     {
17965:libs/alglib/src/ap.cpp ****         rsetv(m, 0.0, y, _state);
17966:libs/alglib/src/ap.cpp ****     }
17967:libs/alglib/src/ap.cpp ****     if( n<=0||ae_fp_eq(alpha,0.0) )
17968:libs/alglib/src/ap.cpp ****     {
17969:libs/alglib/src/ap.cpp ****         return;
17970:libs/alglib/src/ap.cpp ****     }
17971:libs/alglib/src/ap.cpp ****     
17972:libs/alglib/src/ap.cpp ****     /*
17973:libs/alglib/src/ap.cpp ****      * Straight or transposed?
17974:libs/alglib/src/ap.cpp ****      */
17975:libs/alglib/src/ap.cpp ****     if( opa==0 )
17976:libs/alglib/src/ap.cpp ****     {
17977:libs/alglib/src/ap.cpp ****         /*
17978:libs/alglib/src/ap.cpp ****          * Try SIMD code
ARM GAS  C:\Users\subdia\AppData\Local\Temp\ccz6Svo7.s 			page 402


17979:libs/alglib/src/ap.cpp ****          */
