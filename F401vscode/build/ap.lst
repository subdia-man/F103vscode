3906:libs/alglib/src/ap.cpp ****     
3907:libs/alglib/src/ap.cpp ****     /* copy tag to buffer, lowercase it */
3908:libs/alglib/src/ap.cpp ****     memset(buf, 0, ALGLIB_TRACE_BUFFER_LEN);
3909:libs/alglib/src/ap.cpp ****     strcat(buf, ",");
3910:libs/alglib/src/ap.cpp ****     strncat(buf, tag, ALGLIB_TRACE_TAGS_LEN);
3911:libs/alglib/src/ap.cpp ****     strcat(buf, "?");
3912:libs/alglib/src/ap.cpp ****     for(int i=0; buf[i]!=0; i++)
3913:libs/alglib/src/ap.cpp ****         buf[i] = (char)tolower((int)buf[i]);
3914:libs/alglib/src/ap.cpp ****             
3915:libs/alglib/src/ap.cpp ****     /* contains tag (followed by comma, which means exact match) */
3916:libs/alglib/src/ap.cpp ****     buf[strlen(buf)-1] = ',';
3917:libs/alglib/src/ap.cpp ****     if( strstr(alglib_trace_tags,buf)!=NULL )
3918:libs/alglib/src/ap.cpp ****         return ae_true;
3919:libs/alglib/src/ap.cpp ****             
3920:libs/alglib/src/ap.cpp ****     /* contains tag (followed by dot, which means match with child) */
3921:libs/alglib/src/ap.cpp ****     buf[strlen(buf)-1] = '.';
3922:libs/alglib/src/ap.cpp ****     if( strstr(alglib_trace_tags,buf)!=NULL )
3923:libs/alglib/src/ap.cpp ****         return ae_true;
3924:libs/alglib/src/ap.cpp ****             
3925:libs/alglib/src/ap.cpp ****     /* nothing */
3926:libs/alglib/src/ap.cpp ****     return ae_false;
3927:libs/alglib/src/ap.cpp **** }
