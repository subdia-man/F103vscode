3337:libs/alglib/src/ap.cpp ****     }
3338:libs/alglib/src/ap.cpp ****     
3339:libs/alglib/src/ap.cpp ****     /* reallocate if needed */
3340:libs/alglib/src/ap.cpp ****     if( cnt==arr->capacity )
3341:libs/alglib/src/ap.cpp ****     {
