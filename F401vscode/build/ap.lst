18539:libs/alglib/src/ap.cpp ****     {
18540:libs/alglib/src/ap.cpp ****         /*
18541:libs/alglib/src/ap.cpp ****          * blocksize is 1, stride is 1
18542:libs/alglib/src/ap.cpp ****          */
18543:libs/alglib/src/ap.cpp ****         double vx = x->ptr.p_double[cols0];
18544:libs/alglib/src/ap.cpp ****         double *p_mat_row  = rowstorage->ptr.p_double+offss+1*1;
18545:libs/alglib/src/ap.cpp ****         double *p_simd_buf = simdbuf->ptr.p_double;
18546:libs/alglib/src/ap.cpp ****         ae_int_t *p_rowidx = superrowidx->ptr.p_int+rbase;
