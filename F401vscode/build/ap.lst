3167:libs/alglib/src/ap.h ****     //
3168:libs/alglib/src/ap.h ****     // If is_frozen_proxy==true and if:
3169:libs/alglib/src/ap.h ****     // * ptr==&inner_vec, it means that wrapper works with its own ae_vector
3170:libs/alglib/src/ap.h ****     //   structure, but this structure points to externally allocated memory.
3171:libs/alglib/src/ap.h ****     //   This memory is NOT owned by ae_vector object.
3172:libs/alglib/src/ap.h ****     // * ptr!=&inner_vec, it means that wrapper works with externally allocated
3173:libs/alglib/src/ap.h ****     //   and managed ae_vector structure. Both memory pointed by ae_vector and
3174:libs/alglib/src/ap.h ****     //   ae_vector structure itself are not owned by wrapper object.
3175:libs/alglib/src/ap.h ****     //
3176:libs/alglib/src/ap.h ****     bool                   is_frozen_proxy;
3177:libs/alglib/src/ap.h **** };
