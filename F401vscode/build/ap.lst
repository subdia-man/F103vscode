2752:libs/alglib/src/ap.h ****     //
2753:libs/alglib/src/ap.h ****     // Creates object attached to external ae_vector structure.
2754:libs/alglib/src/ap.h ****     //
2755:libs/alglib/src/ap.h ****     // NOTE: this function also checks that source ae_vector* has
2756:libs/alglib/src/ap.h ****     //       required datatype. An exception is generated otherwise.
2757:libs/alglib/src/ap.h ****     //
2758:libs/alglib/src/ap.h ****     // When created in this mode, instance does not perform any dynamic allocations and does not
2759:libs/alglib/src/ap.h ****     // need non-trivial destruction.
2760:libs/alglib/src/ap.h ****     //
2761:libs/alglib/src/ap.h ****     //
