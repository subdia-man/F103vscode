3391:libs/alglib/src/ap.cpp **** /************************************************************************
3392:libs/alglib/src/ap.cpp **** This function copies contents of ae_vector (SRC) to x_vector (DST).
ARM GAS  C:\Users\subdia\AppData\Local\Temp\ccz6Svo7.s 			page 61


3393:libs/alglib/src/ap.cpp **** 
3394:libs/alglib/src/ap.cpp **** This function should not be called for  DST  which  is  attached  to  SRC
3395:libs/alglib/src/ap.cpp **** (opposite situation, when SRC is attached to DST, is possible).
3396:libs/alglib/src/ap.cpp **** 
3397:libs/alglib/src/ap.cpp **** Depending on situation, following actions are performed 
3398:libs/alglib/src/ap.cpp **** * for SRC attached to DST, this function performs no actions (no need  to
3399:libs/alglib/src/ap.cpp ****   do anything)
3400:libs/alglib/src/ap.cpp **** * for independent vectors of different sizes it allocates storage in  DST
3401:libs/alglib/src/ap.cpp ****   and copy contents of SRC  to  DST.  DST->last_action field  is  set  to
3402:libs/alglib/src/ap.cpp ****   ACT_NEW_LOCATION, and DST->owner is set to ACT_XFREE_ON_REALLOC   .
3403:libs/alglib/src/ap.cpp **** * for  independent  vectors   of  same  sizes  it does not perform memory
3404:libs/alglib/src/ap.cpp ****   (re)allocation.  It  just  copies  SRC  to  already   existing   place.
3405:libs/alglib/src/ap.cpp ****   DST->last_action   is   set   to    ACT_SAME_LOCATION  (unless  it  was
3406:libs/alglib/src/ap.cpp ****   ACT_NEW_LOCATION), DST->owner is unmodified.
3407:libs/alglib/src/ap.cpp **** 
3408:libs/alglib/src/ap.cpp **** dst                 destination vector
3409:libs/alglib/src/ap.cpp **** src                 source, vector in x-format
3410:libs/alglib/src/ap.cpp **** state               ALGLIB environment state
3411:libs/alglib/src/ap.cpp **** 
3412:libs/alglib/src/ap.cpp **** NOTES:
3413:libs/alglib/src/ap.cpp **** * dst is assumed to be initialized. Its contents is freed before  copying
3414:libs/alglib/src/ap.cpp ****   data  from src  (if  size / type  are  different)  or  overwritten  (if
3415:libs/alglib/src/ap.cpp ****   possible given destination size).
3416:libs/alglib/src/ap.cpp **** ************************************************************************/
3417:libs/alglib/src/ap.cpp **** void ae_x_set_vector(x_vector *dst, ae_vector *src, ae_state *state)
3418:libs/alglib/src/ap.cpp **** {
3419:libs/alglib/src/ap.cpp ****     if( src->ptr.p_ptr == dst->x_ptr.p_ptr )
3420:libs/alglib/src/ap.cpp ****     {
3421:libs/alglib/src/ap.cpp ****         /* src->ptr points to the beginning of dst, attached matrices, no need to copy */
3422:libs/alglib/src/ap.cpp ****         return;
3423:libs/alglib/src/ap.cpp ****     }
3424:libs/alglib/src/ap.cpp ****     if( dst->cnt!=src->cnt || dst->datatype!=src->datatype )
3425:libs/alglib/src/ap.cpp ****     {
3426:libs/alglib/src/ap.cpp ****         if( dst->owner==ACT_XFREE_ON_REALLOC )
3427:libs/alglib/src/ap.cpp ****             ae_free(dst->x_ptr.p_ptr);
3428:libs/alglib/src/ap.cpp ****         dst->x_ptr.p_ptr = ae_malloc((size_t)(src->cnt*ae_sizeof(src->datatype)), state);
3429:libs/alglib/src/ap.cpp ****         if( src->cnt!=0 && dst->x_ptr.p_ptr==NULL )
3430:libs/alglib/src/ap.cpp ****             ae_break(state, ERR_OUT_OF_MEMORY, "ae_malloc(): out of memory");
3431:libs/alglib/src/ap.cpp ****         dst->last_action = ACT_NEW_LOCATION;
3432:libs/alglib/src/ap.cpp ****         dst->cnt = src->cnt;
3433:libs/alglib/src/ap.cpp ****         dst->datatype = src->datatype;
3434:libs/alglib/src/ap.cpp ****         dst->owner = ACT_XFREE_ON_REALLOC;
3435:libs/alglib/src/ap.cpp ****     }
3436:libs/alglib/src/ap.cpp ****     else
3437:libs/alglib/src/ap.cpp ****     {
3438:libs/alglib/src/ap.cpp ****         if( dst->last_action==ACT_UNCHANGED )
3439:libs/alglib/src/ap.cpp ****             dst->last_action = ACT_SAME_LOCATION;
3440:libs/alglib/src/ap.cpp ****         else if( dst->last_action==ACT_SAME_LOCATION )
3441:libs/alglib/src/ap.cpp ****             dst->last_action = ACT_SAME_LOCATION;
3442:libs/alglib/src/ap.cpp ****         else if( dst->last_action==ACT_NEW_LOCATION )
3443:libs/alglib/src/ap.cpp ****             dst->last_action = ACT_NEW_LOCATION;
3444:libs/alglib/src/ap.cpp ****         else
3445:libs/alglib/src/ap.cpp ****             ae_assert(ae_false, "ALGLIB: internal error in ae_x_set_vector()", state);
3446:libs/alglib/src/ap.cpp ****     }
3447:libs/alglib/src/ap.cpp ****     if( src->cnt )
3448:libs/alglib/src/ap.cpp ****         memmove(dst->x_ptr.p_ptr, src->ptr.p_ptr, (size_t)(src->cnt*ae_sizeof(src->datatype)));
3449:libs/alglib/src/ap.cpp **** }
