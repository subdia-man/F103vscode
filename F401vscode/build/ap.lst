8445:libs/alglib/src/ap.cpp ****                 state->replydj.ptr.p_double[qidx*state->queryvars+k] = 2*s*(1+k+sin(1+k));
8446:libs/alglib/src/ap.cpp ****         }
8447:libs/alglib/src/ap.cpp ****         return;
8448:libs/alglib/src/ap.cpp ****     }
8449:libs/alglib/src/ap.cpp ****     AE_CRITICAL_ASSERT(0);
8450:libs/alglib/src/ap.cpp **** }
