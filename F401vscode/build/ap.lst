18553:libs/alglib/src/ap.cpp ****         {
18554:libs/alglib/src/ap.cpp ****             for(k=0; k<offdiagsize; k++)
18555:libs/alglib/src/ap.cpp ****                 p_simd_buf[p_rowidx[k]*simdwidth] -= p_mat_row[k]*vx;
18556:libs/alglib/src/ap.cpp ****         }
18557:libs/alglib/src/ap.cpp ****         return;
18558:libs/alglib/src/ap.cpp ****     }
18559:libs/alglib/src/ap.cpp **** 
18560:libs/alglib/src/ap.cpp ****     /*
18561:libs/alglib/src/ap.cpp ****      * Generic C code for generic propagate
18562:libs/alglib/src/ap.cpp ****      */
18563:libs/alglib/src/ap.cpp ****     for(k=0; k<=offdiagsize-1; k++)
18564:libs/alglib/src/ap.cpp ****     {
18565:libs/alglib/src/ap.cpp ****         i = superrowidx->ptr.p_int[rbase+k];
18566:libs/alglib/src/ap.cpp ****         baseoffs = offss+(k+blocksize)*sstride;
18567:libs/alglib/src/ap.cpp ****         v = simdbuf->ptr.p_double[i*simdwidth];
