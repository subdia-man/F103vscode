3340:libs/alglib/src/ap.h **** /********************************************************************
3341:libs/alglib/src/ap.h **** CSV operations: reading CSV file to real matrix.
3342:libs/alglib/src/ap.h **** 
3343:libs/alglib/src/ap.h **** This function reads CSV  file  and  stores  its  contents  to  double
3344:libs/alglib/src/ap.h **** precision 2D array. Format of the data file must conform to RFC  4180
3345:libs/alglib/src/ap.h **** specification, with additional notes:
3346:libs/alglib/src/ap.h **** * file size should be less than 2GB
3347:libs/alglib/src/ap.h **** * ASCI encoding, UTF-8 without BOM (in header names) are supported
3348:libs/alglib/src/ap.h **** * any character (comma/tab/space) may be used as field separator,  as
3349:libs/alglib/src/ap.h ****   long as it is distinct from one used for decimal point
3350:libs/alglib/src/ap.h **** * multiple subsequent field separators (say, two  spaces) are treated
3351:libs/alglib/src/ap.h ****   as MULTIPLE separators, not one big separator
3352:libs/alglib/src/ap.h **** * both comma and full stop may be used as decimal point. Parser  will
3353:libs/alglib/src/ap.h ****   automatically determine specific character being used.  Both  fixed
3354:libs/alglib/src/ap.h ****   and exponential number formats are  allowed.   Thousand  separators
3355:libs/alglib/src/ap.h ****   are NOT allowed.
3356:libs/alglib/src/ap.h **** * line may end with \n (Unix style) or \r\n (Windows  style),  parser
3357:libs/alglib/src/ap.h ****   will automatically adapt to chosen convention
3358:libs/alglib/src/ap.h **** * escaped fields (ones in double quotes) are not supported
3359:libs/alglib/src/ap.h **** 
3360:libs/alglib/src/ap.h **** INPUT PARAMETERS:
3361:libs/alglib/src/ap.h ****     filename        relative/absolute path
3362:libs/alglib/src/ap.h ****     separator       character used to separate fields.  May  be  ' ',
3363:libs/alglib/src/ap.h ****                     ',', '\t'. Other separators are possible too.
3364:libs/alglib/src/ap.h ****     flags           several values combined with bitwise OR:
3365:libs/alglib/src/ap.h ****                     * alglib::CSV_SKIP_HEADERS -  if present, first row
3366:libs/alglib/src/ap.h ****                       contains headers  and  will  be  skipped.   Its
3367:libs/alglib/src/ap.h ****                       contents is used to determine fields count, and
3368:libs/alglib/src/ap.h ****                       that's all.
3369:libs/alglib/src/ap.h ****                     If no flags are specified, default value 0x0  (or
3370:libs/alglib/src/ap.h ****                     alglib::CSV_DEFAULT, which is same) should be used.
3371:libs/alglib/src/ap.h ****                     
3372:libs/alglib/src/ap.h **** OUTPUT PARAMETERS:
3373:libs/alglib/src/ap.h ****     out             2D matrix, CSV file parsed with atof()
3374:libs/alglib/src/ap.h ****     
3375:libs/alglib/src/ap.h **** HANDLING OF SPECIAL CASES:
3376:libs/alglib/src/ap.h **** * file does not exist - alglib::ap_error exception is thrown
3377:libs/alglib/src/ap.h **** * empty file - empty array is returned (no exception)
3378:libs/alglib/src/ap.h **** * skip_first_row=true, only one row in file - empty array is returned
3379:libs/alglib/src/ap.h **** * field contents is not recognized by atof() - field value is replaced
3380:libs/alglib/src/ap.h ****   by 0.0
3381:libs/alglib/src/ap.h **** ********************************************************************/
3382:libs/alglib/src/ap.h **** #if !defined(AE_NO_EXCEPTIONS)
3383:libs/alglib/src/ap.h **** void read_csv(const char *filename, char separator, int flags, alglib::real_2d_array &out);
3384:libs/alglib/src/ap.h **** #endif
3385:libs/alglib/src/ap.h **** 
3386:libs/alglib/src/ap.h **** 
3387:libs/alglib/src/ap.h **** /********************************************************************
3388:libs/alglib/src/ap.h **** This function activates trace output, with trace log being  saved  to
3389:libs/alglib/src/ap.h **** file (appended to the end).
3390:libs/alglib/src/ap.h **** 
3391:libs/alglib/src/ap.h **** Tracing allows us to study behavior of ALGLIB solvers  and  to  debug
3392:libs/alglib/src/ap.h **** their failures:
ARM GAS  C:\Users\subdia\AppData\Local\Temp\ccz6Svo7.s 			page 1654


3393:libs/alglib/src/ap.h **** * tracing is  limited  by one/several ALGLIB parts specified by means
3394:libs/alglib/src/ap.h ****   of trace tags, like "SLP" (for SLP solver) or "OPTGUARD"  (OptGuard
3395:libs/alglib/src/ap.h ****   integrity checker).
3396:libs/alglib/src/ap.h **** * some ALGLIB solvers support hierarchies of trace tags which activate
3397:libs/alglib/src/ap.h ****   different kinds of tracing. Say, "SLP" defines some basic  tracing,
3398:libs/alglib/src/ap.h ****   but "SLP.PROBING" defines more detailed and costly tracing.
3399:libs/alglib/src/ap.h **** * generally, "TRACETAG.SUBTAG"   also  implicitly  activates  logging
3400:libs/alglib/src/ap.h ****   which is activated by "TRACETAG"
3401:libs/alglib/src/ap.h **** * you may define multiple trace tags by separating them with  commas,
3402:libs/alglib/src/ap.h ****   like "SLP,OPTGUARD,SLP.PROBING"
3403:libs/alglib/src/ap.h **** * trace tags are case-insensitive
3404:libs/alglib/src/ap.h **** * spaces/tabs are NOT allowed in the tags string
3405:libs/alglib/src/ap.h **** 
3406:libs/alglib/src/ap.h **** Trace log is saved to file "filename", which is opened in the  append
3407:libs/alglib/src/ap.h **** mode. If no file with such name  can  be  opened,  tracing  won't  be
3408:libs/alglib/src/ap.h **** performed (but no exception will be generated).
3409:libs/alglib/src/ap.h **** ********************************************************************/
3410:libs/alglib/src/ap.h **** void trace_file(std::string tags, std::string filename);
3411:libs/alglib/src/ap.h **** 
3412:libs/alglib/src/ap.h **** 
3413:libs/alglib/src/ap.h **** /********************************************************************
3414:libs/alglib/src/ap.h **** This function disables tracing.
3415:libs/alglib/src/ap.h **** ********************************************************************/
3416:libs/alglib/src/ap.h **** void trace_disable();
3417:libs/alglib/src/ap.h **** 
3418:libs/alglib/src/ap.h **** 
