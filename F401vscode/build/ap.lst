14519:libs/alglib/src/ap.cpp ****     {
14520:libs/alglib/src/ap.cpp ****         /*
14521:libs/alglib/src/ap.cpp ****          * update by two
14522:libs/alglib/src/ap.cpp ****          */
14523:libs/alglib/src/ap.cpp ****         for(j=0,pv=vtmp, dst=arow; j<n2; j++, dst+=2, pv+=2)
14524:libs/alglib/src/ap.cpp ****         {
14525:libs/alglib/src/ap.cpp ****             double ux  = pu[0].x;
14526:libs/alglib/src/ap.cpp ****             double uy  = pu[0].y;
14527:libs/alglib/src/ap.cpp ****             double v0x = pv[0].x;
14528:libs/alglib/src/ap.cpp ****             double v0y = pv[0].y;
14529:libs/alglib/src/ap.cpp ****             double v1x = pv[1].x;
14530:libs/alglib/src/ap.cpp ****             double v1y = pv[1].y;
14531:libs/alglib/src/ap.cpp ****             dst[0].x += ux*v0x-uy*v0y;
14532:libs/alglib/src/ap.cpp ****             dst[0].y += ux*v0y+uy*v0x;
14533:libs/alglib/src/ap.cpp ****             dst[1].x += ux*v1x-uy*v1y;
14534:libs/alglib/src/ap.cpp ****             dst[1].y += ux*v1y+uy*v1x;
14535:libs/alglib/src/ap.cpp ****         }
14536:libs/alglib/src/ap.cpp **** 
14537:libs/alglib/src/ap.cpp ****         /*
14538:libs/alglib/src/ap.cpp ****          * final update
14539:libs/alglib/src/ap.cpp ****          */
14540:libs/alglib/src/ap.cpp ****         if( n%2!=0 )
14541:libs/alglib/src/ap.cpp ****         {
14542:libs/alglib/src/ap.cpp ****             double ux = pu[0].x;
14543:libs/alglib/src/ap.cpp ****             double uy = pu[0].y;
14544:libs/alglib/src/ap.cpp ****             double vx = pv[0].x;
14545:libs/alglib/src/ap.cpp ****             double vy = pv[0].y;
14546:libs/alglib/src/ap.cpp ****             dst[0].x += ux*vx-uy*vy;
14547:libs/alglib/src/ap.cpp ****             dst[0].y += ux*vy+uy*vx;
14548:libs/alglib/src/ap.cpp ****         }
14549:libs/alglib/src/ap.cpp ****     }
14550:libs/alglib/src/ap.cpp ****     return ae_true;
14551:libs/alglib/src/ap.cpp **** }
