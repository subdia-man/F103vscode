15149:libs/alglib/src/ap.cpp ****         b+=2;
15150:libs/alglib/src/ap.cpp ****     }
15151:libs/alglib/src/ap.cpp ****     if( store_mode==0 )
15152:libs/alglib/src/ap.cpp ****     {
15153:libs/alglib/src/ap.cpp ****         if( beta==0.0 )
15154:libs/alglib/src/ap.cpp ****         {
15155:libs/alglib/src/ap.cpp ****             r[0] = alpha*v00;
15156:libs/alglib/src/ap.cpp ****             r[1] = alpha*v01;
15157:libs/alglib/src/ap.cpp ****             r[stride+0] = alpha*v10;
15158:libs/alglib/src/ap.cpp ****             r[stride+1] = alpha*v11;
15159:libs/alglib/src/ap.cpp ****         }
15160:libs/alglib/src/ap.cpp ****         else
