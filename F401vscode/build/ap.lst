15115:libs/alglib/src/ap.cpp **** /********************************************************************
15116:libs/alglib/src/ap.cpp **** This function calculates R := alpha*A'*B+beta*R where A and B are Kx2 
15117:libs/alglib/src/ap.cpp **** matrices stored in contiguous row-by-row storage,  R  is  2x2  matrix
15118:libs/alglib/src/ap.cpp **** stored in non-contiguous row-by-row storage.
15119:libs/alglib/src/ap.cpp **** 
15120:libs/alglib/src/ap.cpp **** A and B must be aligned; R may be non-aligned.
15121:libs/alglib/src/ap.cpp **** 
15122:libs/alglib/src/ap.cpp **** If beta is zero, contents of R is ignored (not  multiplied  by zero -
15123:libs/alglib/src/ap.cpp **** just ignored).
15124:libs/alglib/src/ap.cpp **** 
15125:libs/alglib/src/ap.cpp **** However, when alpha is zero, we still calculate A'*B, which is 
15126:libs/alglib/src/ap.cpp **** multiplied by zero afterwards.
15127:libs/alglib/src/ap.cpp **** 
15128:libs/alglib/src/ap.cpp **** Function accepts additional parameter store_mode:
15129:libs/alglib/src/ap.cpp **** * if 0, full R is stored
15130:libs/alglib/src/ap.cpp **** * if 1, only first row of R is stored
15131:libs/alglib/src/ap.cpp **** * if 2, only first column of R is stored
15132:libs/alglib/src/ap.cpp **** * if 3, only top left element of R is stored
15133:libs/alglib/src/ap.cpp **** ********************************************************************/
15134:libs/alglib/src/ap.cpp **** void _ialglib_mm22(double alpha, const double *a, const double *b, ae_int_t k, double beta, double 
15135:libs/alglib/src/ap.cpp **** {
15136:libs/alglib/src/ap.cpp ****     double v00, v01, v10, v11;
15137:libs/alglib/src/ap.cpp ****     ae_int_t t;
15138:libs/alglib/src/ap.cpp ****     v00 = 0.0;
15139:libs/alglib/src/ap.cpp ****     v01 = 0.0;
15140:libs/alglib/src/ap.cpp ****     v10 = 0.0;
15141:libs/alglib/src/ap.cpp ****     v11 = 0.0;
15142:libs/alglib/src/ap.cpp ****     for(t=0; t<k; t++)
15143:libs/alglib/src/ap.cpp ****     {
15144:libs/alglib/src/ap.cpp ****         v00 += a[0]*b[0];
15145:libs/alglib/src/ap.cpp ****         v01 += a[0]*b[1];
