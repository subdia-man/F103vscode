2623:libs/alglib/src/ap.cpp **** ************************************************************************/
2624:libs/alglib/src/ap.cpp **** void ae_smart_ptr_init(ae_smart_ptr *dst, void **subscriber, ae_bool exclusive, ae_state *state, ae
2625:libs/alglib/src/ap.cpp **** {
