15212:libs/alglib/src/ap.cpp **** /********************************************************************
15213:libs/alglib/src/ap.cpp **** This function calculates R := alpha*A'*B+beta*R where A and B are Kx2 
15214:libs/alglib/src/ap.cpp **** matrices stored in contiguous row-by-row storage,  R  is  2x2  matrix
15215:libs/alglib/src/ap.cpp **** stored in non-contiguous row-by-row storage.
15216:libs/alglib/src/ap.cpp **** 
15217:libs/alglib/src/ap.cpp **** A and B must be aligned; R may be non-aligned.
15218:libs/alglib/src/ap.cpp **** 
15219:libs/alglib/src/ap.cpp **** If beta is zero, contents of R is ignored (not  multiplied  by zero -
15220:libs/alglib/src/ap.cpp **** just ignored).
15221:libs/alglib/src/ap.cpp **** 
15222:libs/alglib/src/ap.cpp **** However, when alpha is zero, we still calculate A'*B, which is 
15223:libs/alglib/src/ap.cpp **** multiplied by zero afterwards.
15224:libs/alglib/src/ap.cpp **** 
15225:libs/alglib/src/ap.cpp **** Function accepts additional parameter store_mode:
15226:libs/alglib/src/ap.cpp **** * if 0, full R is stored
15227:libs/alglib/src/ap.cpp **** * if 1, only first row of R is stored
15228:libs/alglib/src/ap.cpp **** * if 2, only first column of R is stored
15229:libs/alglib/src/ap.cpp **** * if 3, only top left element of R is stored
15230:libs/alglib/src/ap.cpp **** 
15231:libs/alglib/src/ap.cpp **** This function supports SSE2; it can be used when:
15232:libs/alglib/src/ap.cpp **** 1. AE_HAS_SSE2_INTRINSICS was defined (checked at compile-time)
15233:libs/alglib/src/ap.cpp **** 2. ae_cpuid() result contains CPU_SSE2 (checked at run-time)
15234:libs/alglib/src/ap.cpp **** 
15235:libs/alglib/src/ap.cpp **** If (1) is failed, this function will still be defined and callable, but it 
15236:libs/alglib/src/ap.cpp **** will do nothing.  If (2)  is  failed , call to this function will probably 
15237:libs/alglib/src/ap.cpp **** crash your system. 
15238:libs/alglib/src/ap.cpp **** 
15239:libs/alglib/src/ap.cpp **** If  you  want  to  know  whether  it  is safe to call it, you should check 
15240:libs/alglib/src/ap.cpp **** results  of  ae_cpuid(). If CPU_SSE2 bit is set, this function is callable 
15241:libs/alglib/src/ap.cpp **** and will do its work.
15242:libs/alglib/src/ap.cpp **** ********************************************************************/
15243:libs/alglib/src/ap.cpp **** #if defined(AE_HAS_SSE2_INTRINSICS)
15244:libs/alglib/src/ap.cpp **** void _ialglib_mm22_sse2(double alpha, const double *a, const double *b, ae_int_t k, double beta, do
15245:libs/alglib/src/ap.cpp **** {
15246:libs/alglib/src/ap.cpp ****     /*
15247:libs/alglib/src/ap.cpp ****      * We calculate product of two Kx2 matrices (result is 2x2). 
15248:libs/alglib/src/ap.cpp ****      * VA and VB store result as follows:
15249:libs/alglib/src/ap.cpp ****      *
15250:libs/alglib/src/ap.cpp ****      *        [ VD[0]  VE[0] ]
15251:libs/alglib/src/ap.cpp ****      * A'*B = [              ]
15252:libs/alglib/src/ap.cpp ****      *        [ VE[1]  VD[1] ]
15253:libs/alglib/src/ap.cpp ****      *
15254:libs/alglib/src/ap.cpp ****      */
15255:libs/alglib/src/ap.cpp ****     __m128d va, vb, vd, ve, vt, r0, r1, valpha, vbeta; 
15256:libs/alglib/src/ap.cpp ****     ae_int_t t, k2;
15257:libs/alglib/src/ap.cpp ****     
15258:libs/alglib/src/ap.cpp ****     /*
15259:libs/alglib/src/ap.cpp ****      * calculate product
ARM GAS  C:\Users\subdia\AppData\Local\Temp\ccz6Svo7.s 			page 287


15260:libs/alglib/src/ap.cpp ****      */
15261:libs/alglib/src/ap.cpp ****     k2 = k/2;
15262:libs/alglib/src/ap.cpp ****     vd = _mm_setzero_pd();
15263:libs/alglib/src/ap.cpp ****     ve = _mm_setzero_pd();
15264:libs/alglib/src/ap.cpp ****     for(t=0; t<k2; t++)
15265:libs/alglib/src/ap.cpp ****     {
15266:libs/alglib/src/ap.cpp ****         vb = _mm_load_pd(b);
15267:libs/alglib/src/ap.cpp ****         va = _mm_load_pd(a);
15268:libs/alglib/src/ap.cpp ****         vt = vb;
15269:libs/alglib/src/ap.cpp ****         vb = _mm_mul_pd(va,vb);
15270:libs/alglib/src/ap.cpp ****         vt = _mm_shuffle_pd(vt, vt, 1);
15271:libs/alglib/src/ap.cpp ****         vd = _mm_add_pd(vb,vd);        
15272:libs/alglib/src/ap.cpp ****         vt = _mm_mul_pd(va,vt);
15273:libs/alglib/src/ap.cpp ****         vb = _mm_load_pd(b+2);
15274:libs/alglib/src/ap.cpp ****         ve = _mm_add_pd(vt,ve);
15275:libs/alglib/src/ap.cpp ****         va = _mm_load_pd(a+2);
15276:libs/alglib/src/ap.cpp ****         vt = vb;
15277:libs/alglib/src/ap.cpp ****         vb = _mm_mul_pd(va,vb);
15278:libs/alglib/src/ap.cpp ****         vt = _mm_shuffle_pd(vt, vt, 1);
15279:libs/alglib/src/ap.cpp ****         vd = _mm_add_pd(vb,vd);
15280:libs/alglib/src/ap.cpp ****         vt = _mm_mul_pd(va,vt);
15281:libs/alglib/src/ap.cpp ****         ve = _mm_add_pd(vt,ve);
15282:libs/alglib/src/ap.cpp ****         a+=4;
15283:libs/alglib/src/ap.cpp ****         b+=4;
15284:libs/alglib/src/ap.cpp ****     }
15285:libs/alglib/src/ap.cpp ****     if( k%2 )
15286:libs/alglib/src/ap.cpp ****     {
15287:libs/alglib/src/ap.cpp ****         va = _mm_load_pd(a);
15288:libs/alglib/src/ap.cpp ****         vb = _mm_load_pd(b);
15289:libs/alglib/src/ap.cpp ****         vt = _mm_shuffle_pd(vb, vb, 1);
15290:libs/alglib/src/ap.cpp ****         vd = _mm_add_pd(_mm_mul_pd(va,vb),vd);
15291:libs/alglib/src/ap.cpp ****         ve = _mm_add_pd(_mm_mul_pd(va,vt),ve);
15292:libs/alglib/src/ap.cpp ****     }    
