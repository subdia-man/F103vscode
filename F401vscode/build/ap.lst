6325:libs/alglib/src/ap.cpp ****     {
6326:libs/alglib/src/ap.cpp ****         ae_smart_ptr_assign(pptr, NULL, ae_false, ae_false, 0, NULL, NULL);
6327:libs/alglib/src/ap.cpp ****         return;
