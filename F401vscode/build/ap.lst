12510:libs/alglib/src/ap.cpp ****     const double *pa0, *pa1, *pb;
12511:libs/alglib/src/ap.cpp **** 
12512:libs/alglib/src/ap.cpp ****     pa0 = a;
12513:libs/alglib/src/ap.cpp ****     pa1 = a+alglib_r_block;
12514:libs/alglib/src/ap.cpp ****     pb = x;
12515:libs/alglib/src/ap.cpp ****     for(i=0; i<16; i++)
12516:libs/alglib/src/ap.cpp ****     {
12517:libs/alglib/src/ap.cpp ****         double v0 = 0.0, v1 = 0.0;
12518:libs/alglib/src/ap.cpp ****         for(k=0; k<4; k++)
12519:libs/alglib/src/ap.cpp ****         {
12520:libs/alglib/src/ap.cpp ****             v0 += pa0[0]*pb[0];
12521:libs/alglib/src/ap.cpp ****             v1 += pa1[0]*pb[0];
12522:libs/alglib/src/ap.cpp ****             v0 += pa0[1]*pb[1];
