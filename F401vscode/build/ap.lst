8434:libs/alglib/src/ap.cpp **** void _rcomm_debugslantedsumhandlerdense(rcommstate* state, void *p0, void *p1, void *p2, void *p3, 
8435:libs/alglib/src/ap.cpp **** {
8436:libs/alglib/src/ap.cpp ****     if( state->requesttype==2 )
