1480:libs/alglib/src/ap.cpp **** /************************************************************************
1481:libs/alglib/src/ap.cpp **** Returns size of datatype.
1482:libs/alglib/src/ap.cpp **** Zero for dynamic types like strings or multiple precision types.
1483:libs/alglib/src/ap.cpp **** ************************************************************************/
1484:libs/alglib/src/ap.cpp **** ae_int_t ae_sizeof(ae_datatype datatype)
1485:libs/alglib/src/ap.cpp **** {
1486:libs/alglib/src/ap.cpp ****     switch(datatype)
1487:libs/alglib/src/ap.cpp ****     {
1488:libs/alglib/src/ap.cpp ****         case DT_BOOL:       return (ae_int_t)sizeof(ae_bool);
1489:libs/alglib/src/ap.cpp ****         case DT_INT:        return (ae_int_t)sizeof(ae_int_t);
1490:libs/alglib/src/ap.cpp ****         case DT_REAL:       return (ae_int_t)sizeof(double);
1491:libs/alglib/src/ap.cpp ****         case DT_COMPLEX:    return 2*(ae_int_t)sizeof(double);
1492:libs/alglib/src/ap.cpp ****         case DT_UINT8:      return 1;
1493:libs/alglib/src/ap.cpp ****         case DT_UINT16:     return 2;
1494:libs/alglib/src/ap.cpp ****         case DT_UINT32:     return 4;
1495:libs/alglib/src/ap.cpp ****         case DT_UINT64:     return (ae_int_t)sizeof(ae_uint64_t);
1496:libs/alglib/src/ap.cpp ****         default:            return 0;
1497:libs/alglib/src/ap.cpp ****     }
1498:libs/alglib/src/ap.cpp **** }
