 216:libs/alglib/src/ap.cpp **** /*
 217:libs/alglib/src/ap.cpp ****  * DESCRIPTION: recommended number of active workers:
 218:libs/alglib/src/ap.cpp ****  *              * positive value >=1 is used to specify exact number of active workers
 219:libs/alglib/src/ap.cpp ****  *              * 0 means that ALL available cores are used
 220:libs/alglib/src/ap.cpp ****  *              * negative value means that all cores EXCEPT for cores_to_use will be used
 221:libs/alglib/src/ap.cpp ****  *                (say, -1 means that all cores except for one will be used). At least one
 222:libs/alglib/src/ap.cpp ****  *                core will be used in this case, even if you assign -9999999 to this field.
 223:libs/alglib/src/ap.cpp ****  *
 224:libs/alglib/src/ap.cpp ****  *              Default value =  0 (fully parallel execution) when AE_NWORKERS is not defined
 225:libs/alglib/src/ap.cpp ****  *                            =  0 for manually defined number of cores (AE_NWORKERS is defined)
 226:libs/alglib/src/ap.cpp ****  * PROTECTION:  not needed; runtime modification is possible, but we do not need exact
 227:libs/alglib/src/ap.cpp ****  *              synchronization.
 228:libs/alglib/src/ap.cpp ****  */
 229:libs/alglib/src/ap.cpp **** #if defined(AE_NWORKERS) && (AE_NWORKERS<=0)
 230:libs/alglib/src/ap.cpp **** #error AE_NWORKERS must be positive number or not defined at all.
