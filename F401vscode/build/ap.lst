3899:libs/alglib/src/ap.cpp **** ae_bool ae_is_trace_enabled(const char *tag)
3900:libs/alglib/src/ap.cpp **** {
3901:libs/alglib/src/ap.cpp ****     char buf[ALGLIB_TRACE_BUFFER_LEN];
3902:libs/alglib/src/ap.cpp ****     
3903:libs/alglib/src/ap.cpp ****     /* check global trace status */
3904:libs/alglib/src/ap.cpp ****     if( alglib_trace_type==ALGLIB_TRACE_NONE || alglib_trace_file==NULL )
3905:libs/alglib/src/ap.cpp ****         return ae_false;
