1506:libs/alglib/src/ap.cpp **** ae_bool ae_check_zeros(const void *ptr, ae_int_t n)
1507:libs/alglib/src/ap.cpp **** {
1508:libs/alglib/src/ap.cpp ****     ae_int_t nu, nr, i;
1509:libs/alglib/src/ap.cpp ****     unsigned long long c = (unsigned long long)0x0;
1510:libs/alglib/src/ap.cpp ****     
1511:libs/alglib/src/ap.cpp ****     /*
ARM GAS  C:\Users\subdia\AppData\Local\Temp\ccz6Svo7.s 			page 28


1512:libs/alglib/src/ap.cpp ****      * determine leading and trailing lengths
1513:libs/alglib/src/ap.cpp ****      */
1514:libs/alglib/src/ap.cpp ****     nu = n/(ae_int_t)sizeof(unsigned long long);
1515:libs/alglib/src/ap.cpp ****     nr = n%(ae_int_t)sizeof(unsigned long long);
1516:libs/alglib/src/ap.cpp ****     
1517:libs/alglib/src/ap.cpp ****     /*
1518:libs/alglib/src/ap.cpp ****      * handle leading nu long long elements
1519:libs/alglib/src/ap.cpp ****      */
1520:libs/alglib/src/ap.cpp ****     if( nu>0 )
1521:libs/alglib/src/ap.cpp ****     {
1522:libs/alglib/src/ap.cpp ****         const unsigned long long *p_ull;
1523:libs/alglib/src/ap.cpp ****         p_ull = (const unsigned long long *)ptr;
1524:libs/alglib/src/ap.cpp ****         for(i=0; i<nu; i++)
1525:libs/alglib/src/ap.cpp ****             c |= p_ull[i];
1526:libs/alglib/src/ap.cpp ****     }
1527:libs/alglib/src/ap.cpp ****     
1528:libs/alglib/src/ap.cpp ****     /*
1529:libs/alglib/src/ap.cpp ****      * handle trailing nr char elements
1530:libs/alglib/src/ap.cpp ****      */
1531:libs/alglib/src/ap.cpp ****     if( nr>0 )
1532:libs/alglib/src/ap.cpp ****     {
1533:libs/alglib/src/ap.cpp ****         const unsigned char *p_uc;
1534:libs/alglib/src/ap.cpp ****         p_uc  = ((const unsigned char *)ptr)+nu*(ae_int_t)sizeof(unsigned long long);
1535:libs/alglib/src/ap.cpp ****         for(i=0; i<nr; i++)
1536:libs/alglib/src/ap.cpp ****             c |= p_uc[i];
1537:libs/alglib/src/ap.cpp ****     }
1538:libs/alglib/src/ap.cpp ****     
1539:libs/alglib/src/ap.cpp ****     /*
1540:libs/alglib/src/ap.cpp ****      * done
1541:libs/alglib/src/ap.cpp ****      */
1542:libs/alglib/src/ap.cpp ****     return c==0x0;
1543:libs/alglib/src/ap.cpp **** }
1544:libs/alglib/src/ap.cpp **** 
