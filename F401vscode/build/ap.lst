15358:libs/alglib/src/ap.cpp **** /*************************************************************************
15359:libs/alglib/src/ap.cpp **** This function calculates R := alpha*A'*(B0|B1)+beta*R where A, B0  and  B1 
15360:libs/alglib/src/ap.cpp **** are Kx2 matrices stored in contiguous row-by-row storage, R is 2x4  matrix 
15361:libs/alglib/src/ap.cpp **** stored in non-contiguous row-by-row storage.
15362:libs/alglib/src/ap.cpp **** 
15363:libs/alglib/src/ap.cpp **** A, B0 and B1 must be aligned; R may be non-aligned.
15364:libs/alglib/src/ap.cpp **** 
15365:libs/alglib/src/ap.cpp **** Note  that  B0  and  B1  are  two  separate  matrices  stored in different 
15366:libs/alglib/src/ap.cpp **** locations.
15367:libs/alglib/src/ap.cpp **** 
15368:libs/alglib/src/ap.cpp **** If beta is zero, contents of R is ignored (not  multiplied  by zero - just 
15369:libs/alglib/src/ap.cpp **** ignored).
15370:libs/alglib/src/ap.cpp **** 
15371:libs/alglib/src/ap.cpp **** However,  when  alpha  is  zero , we still calculate MM product,  which is 
15372:libs/alglib/src/ap.cpp **** multiplied by zero afterwards.
15373:libs/alglib/src/ap.cpp **** 
ARM GAS  C:\Users\subdia\AppData\Local\Temp\ccz6Svo7.s 			page 289


15374:libs/alglib/src/ap.cpp **** Unlike mm22 functions, this function does NOT support partial  output of R 
15375:libs/alglib/src/ap.cpp **** - we always store full 2x4 matrix.
15376:libs/alglib/src/ap.cpp **** *************************************************************************/
15377:libs/alglib/src/ap.cpp **** void _ialglib_mm22x2(double alpha, const double *a, const double *b0, const double *b1, ae_int_t k,
15378:libs/alglib/src/ap.cpp **** {
15379:libs/alglib/src/ap.cpp ****     _ialglib_mm22(alpha, a, b0, k, beta, r, stride, 0);
15380:libs/alglib/src/ap.cpp ****     _ialglib_mm22(alpha, a, b1, k, beta, r+2, stride, 0);
15381:libs/alglib/src/ap.cpp **** }
15382:libs/alglib/src/ap.cpp **** 
15383:libs/alglib/src/ap.cpp **** /*************************************************************************
15384:libs/alglib/src/ap.cpp **** This function calculates R := alpha*A'*(B0|B1)+beta*R where A, B0  and  B1 
15385:libs/alglib/src/ap.cpp **** are Kx2 matrices stored in contiguous row-by-row storage, R is 2x4  matrix 
15386:libs/alglib/src/ap.cpp **** stored in non-contiguous row-by-row storage.
15387:libs/alglib/src/ap.cpp **** 
15388:libs/alglib/src/ap.cpp **** A, B0 and B1 must be aligned; R may be non-aligned.
15389:libs/alglib/src/ap.cpp **** 
15390:libs/alglib/src/ap.cpp **** Note  that  B0  and  B1  are  two  separate  matrices  stored in different 
15391:libs/alglib/src/ap.cpp **** locations.
15392:libs/alglib/src/ap.cpp **** 
15393:libs/alglib/src/ap.cpp **** If beta is zero, contents of R is ignored (not  multiplied  by zero - just 
15394:libs/alglib/src/ap.cpp **** ignored).
15395:libs/alglib/src/ap.cpp **** 
15396:libs/alglib/src/ap.cpp **** However,  when  alpha  is  zero , we still calculate MM product,  which is 
15397:libs/alglib/src/ap.cpp **** multiplied by zero afterwards.
15398:libs/alglib/src/ap.cpp **** 
15399:libs/alglib/src/ap.cpp **** Unlike mm22 functions, this function does NOT support partial  output of R 
15400:libs/alglib/src/ap.cpp **** - we always store full 2x4 matrix.
15401:libs/alglib/src/ap.cpp **** 
15402:libs/alglib/src/ap.cpp **** This function supports SSE2; it can be used when:
15403:libs/alglib/src/ap.cpp **** 1. AE_HAS_SSE2_INTRINSICS was defined (checked at compile-time)
