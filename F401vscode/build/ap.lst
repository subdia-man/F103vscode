19919:libs/alglib/src/ap.cpp ****     
19920:libs/alglib/src/ap.cpp ****     /*
19921:libs/alglib/src/ap.cpp ****      * General case, N>1: sort, update B
19922:libs/alglib/src/ap.cpp ****      */
19923:libs/alglib/src/ap.cpp ****     for(i=2; i<=n; i++)
19924:libs/alglib/src/ap.cpp ****     {
