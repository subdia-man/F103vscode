8723:libs/alglib/src/ap.cpp **** std::string alglib::complex::tostring(int _dps) const
8724:libs/alglib/src/ap.cpp **** {
8725:libs/alglib/src/ap.cpp ****     char mask[32];
8726:libs/alglib/src/ap.cpp ****     char buf_x[32];
8727:libs/alglib/src/ap.cpp ****     char buf_y[32];
8728:libs/alglib/src/ap.cpp ****     char buf_zero[32];
8729:libs/alglib/src/ap.cpp ****     int dps = _dps>=0 ? _dps : -_dps;
8730:libs/alglib/src/ap.cpp ****     if( dps<=0 || dps>=20 )
8731:libs/alglib/src/ap.cpp ****         _ALGLIB_CPP_EXCEPTION("complex::tostring(): incorrect dps");
8732:libs/alglib/src/ap.cpp **** 
8733:libs/alglib/src/ap.cpp ****     // handle IEEE special quantities
8734:libs/alglib/src/ap.cpp ****     if( fp_isnan(x) || fp_isnan(y) )
8735:libs/alglib/src/ap.cpp ****         return "NAN";
8736:libs/alglib/src/ap.cpp ****     if( fp_isinf(x) || fp_isinf(y) )
8737:libs/alglib/src/ap.cpp ****         return "INF";
8738:libs/alglib/src/ap.cpp **** 
8739:libs/alglib/src/ap.cpp ****     // generate mask
8740:libs/alglib/src/ap.cpp ****     if( sprintf(mask, "%%.%d%s", dps, _dps>=0 ? "f" : "e")>=(int)sizeof(mask) )
8741:libs/alglib/src/ap.cpp ****         _ALGLIB_CPP_EXCEPTION("complex::tostring(): buffer overflow");
8742:libs/alglib/src/ap.cpp **** 
8743:libs/alglib/src/ap.cpp ****     // print |x|, |y| and zero with same mask and compare
8744:libs/alglib/src/ap.cpp ****     if( sprintf(buf_x, mask, (double)(fabs(x)))>=(int)sizeof(buf_x) )
8745:libs/alglib/src/ap.cpp ****         _ALGLIB_CPP_EXCEPTION("complex::tostring(): buffer overflow");
8746:libs/alglib/src/ap.cpp ****     if( sprintf(buf_y, mask, (double)(fabs(y)))>=(int)sizeof(buf_y) )
8747:libs/alglib/src/ap.cpp ****         _ALGLIB_CPP_EXCEPTION("complex::tostring(): buffer overflow");
8748:libs/alglib/src/ap.cpp ****     if( sprintf(buf_zero, mask, (double)0)>=(int)sizeof(buf_zero) )
8749:libs/alglib/src/ap.cpp ****         _ALGLIB_CPP_EXCEPTION("complex::tostring(): buffer overflow");
8750:libs/alglib/src/ap.cpp **** 
8751:libs/alglib/src/ap.cpp ****     // different zero/nonzero patterns
8752:libs/alglib/src/ap.cpp ****     if( strcmp(buf_x,buf_zero)!=0 && strcmp(buf_y,buf_zero)!=0 )
8753:libs/alglib/src/ap.cpp ****         return std::string(x>0.0 ? "" : "-")+buf_x+(y>0.0 ? "+" : "-")+buf_y+"i";
