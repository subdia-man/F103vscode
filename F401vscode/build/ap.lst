3323:libs/alglib/src/ap.cpp ****     ae_assert(ptr->ptr==NULL || ptr->is_dynamic, "ae_obj_array_append_transfer: ptr does not point 
3324:libs/alglib/src/ap.cpp ****     
3325:libs/alglib/src/ap.cpp ****     /* get the primary lock */
3326:libs/alglib/src/ap.cpp ****     ae_acquire_lock(&arr->array_lock);
3327:libs/alglib/src/ap.cpp ****     
