5003:libs/alglib/src/ap.cpp **** ************************************************************************/
5004:libs/alglib/src/ap.cpp **** void ae_foursixbits2threebytes(const ae_int_t *src, unsigned char *dst)
5005:libs/alglib/src/ap.cpp **** {
5006:libs/alglib/src/ap.cpp ****     dst[0] = (unsigned char)(     src[0] | ((src[1]&0x03)<<6));
5007:libs/alglib/src/ap.cpp ****     dst[1] = (unsigned char)((src[1]>>2) | ((src[2]&0x0F)<<4));
5008:libs/alglib/src/ap.cpp ****     dst[2] = (unsigned char)((src[2]>>4) | (src[3]<<2));
5009:libs/alglib/src/ap.cpp **** }
