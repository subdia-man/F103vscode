14490:libs/alglib/src/ap.cpp **** ae_bool _ialglib_cmatrixrank1(ae_int_t m,
14491:libs/alglib/src/ap.cpp ****      ae_int_t n,
14492:libs/alglib/src/ap.cpp ****      ae_complex *_a,
14493:libs/alglib/src/ap.cpp ****      ae_int_t _a_stride,
14494:libs/alglib/src/ap.cpp ****      const ae_complex *_u,
14495:libs/alglib/src/ap.cpp ****      const ae_complex *_v)
14496:libs/alglib/src/ap.cpp **** {
14497:libs/alglib/src/ap.cpp ****     /*
14498:libs/alglib/src/ap.cpp ****      * Locals
14499:libs/alglib/src/ap.cpp ****      */
14500:libs/alglib/src/ap.cpp ****     ae_complex *arow, *dst;
14501:libs/alglib/src/ap.cpp ****     const ae_complex *pu, *pv, *vtmp;
14502:libs/alglib/src/ap.cpp ****     ae_int_t n2 = n/2;
14503:libs/alglib/src/ap.cpp ****     ae_int_t i, j;
14504:libs/alglib/src/ap.cpp ****     
14505:libs/alglib/src/ap.cpp ****     /*
14506:libs/alglib/src/ap.cpp ****      * Quick exit
14507:libs/alglib/src/ap.cpp ****      */
14508:libs/alglib/src/ap.cpp ****     if( m<=0 || n<=0 )
