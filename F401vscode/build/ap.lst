15164:libs/alglib/src/ap.cpp ****             r[stride+0] = beta*r[stride+0] + alpha*v10;
15165:libs/alglib/src/ap.cpp ****             r[stride+1] = beta*r[stride+1] + alpha*v11;
15166:libs/alglib/src/ap.cpp ****         }
15167:libs/alglib/src/ap.cpp ****         return;
15168:libs/alglib/src/ap.cpp ****     }
15169:libs/alglib/src/ap.cpp ****     if( store_mode==1 )
15170:libs/alglib/src/ap.cpp ****     {
15171:libs/alglib/src/ap.cpp ****         if( beta==0.0 )
15172:libs/alglib/src/ap.cpp ****         {
15173:libs/alglib/src/ap.cpp ****             r[0] = alpha*v00;
15174:libs/alglib/src/ap.cpp ****             r[1] = alpha*v01;
15175:libs/alglib/src/ap.cpp ****         }
15176:libs/alglib/src/ap.cpp ****         else
15177:libs/alglib/src/ap.cpp ****         {
15178:libs/alglib/src/ap.cpp ****             r[0] = beta*r[0] + alpha*v00;
15179:libs/alglib/src/ap.cpp ****             r[1] = beta*r[1] + alpha*v01;
15180:libs/alglib/src/ap.cpp ****         }
15181:libs/alglib/src/ap.cpp ****         return;
