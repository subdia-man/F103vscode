1433:libs/alglib/src/ap.cpp **** 
1434:libs/alglib/src/ap.cpp **** Returns NULL when zero size is specified.
1435:libs/alglib/src/ap.cpp **** 
1436:libs/alglib/src/ap.cpp **** Error handling:
1437:libs/alglib/src/ap.cpp **** * if state is NULL, returns NULL on allocation error
1438:libs/alglib/src/ap.cpp **** * if state is not NULL, calls ae_break() on allocation error
1439:libs/alglib/src/ap.cpp **** ************************************************************************/
1440:libs/alglib/src/ap.cpp **** void* ae_malloc_zero(size_t size, ae_state *state)
1441:libs/alglib/src/ap.cpp **** {
