6339:libs/alglib/src/ap.cpp ****     
6340:libs/alglib/src/ap.cpp ****     /* assign object to smart pointer */
6341:libs/alglib/src/ap.cpp ****     ae_smart_ptr_assign(pptr, pool->enumeration_counter->obj, ae_false, ae_false, 0, NULL, NULL);
