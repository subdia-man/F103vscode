20122:libs/alglib/src/ap.cpp **** /*************************************************************************
20123:libs/alglib/src/ap.cpp **** This function creates an EMPTY sparse matrix stored in the CRS format.
20124:libs/alglib/src/ap.cpp **** 
20125:libs/alglib/src/ap.cpp **** The empty matrix is a degenerate 0*N-dimensional matrix which can be used
20126:libs/alglib/src/ap.cpp **** ONLY for:
20127:libs/alglib/src/ap.cpp **** * appending rows with sparseappendcompressedrow()
20128:libs/alglib/src/ap.cpp **** * appending non-degenerate CRS matrices with sparseappendmatrix()
20129:libs/alglib/src/ap.cpp **** Before the first row is appended, the matrix is in a special intermediate
20130:libs/alglib/src/ap.cpp **** state. After the first append it becomes a standard CRS matrix.
20131:libs/alglib/src/ap.cpp **** 
20132:libs/alglib/src/ap.cpp **** The main purpose of this function is to simplify step-by-step initialization
20133:libs/alglib/src/ap.cpp **** of CRS matrices.
20134:libs/alglib/src/ap.cpp **** 
20135:libs/alglib/src/ap.cpp **** INPUT PARAMETERS
20136:libs/alglib/src/ap.cpp ****     N           -   number of columns in a matrix, N>=1
20137:libs/alglib/src/ap.cpp **** 
20138:libs/alglib/src/ap.cpp **** OUTPUT PARAMETERS
20139:libs/alglib/src/ap.cpp ****     S           -   sparse 0*N matrix in a partially initialized state
20140:libs/alglib/src/ap.cpp ****                     
20141:libs/alglib/src/ap.cpp **** NOTE: this function completely  overwrites  S  with  new  sparse  matrix.
20142:libs/alglib/src/ap.cpp ****       Previously allocated storage is NOT reused. If you  want  to  reuse
20143:libs/alglib/src/ap.cpp ****       already allocated memory, call SparseCreateCRSEmptyBuf function.
20144:libs/alglib/src/ap.cpp **** 
20145:libs/alglib/src/ap.cpp ****   -- ALGLIB PROJECT --
20146:libs/alglib/src/ap.cpp ****      Copyright 20.02.2024 by Bochkanov Sergey
20147:libs/alglib/src/ap.cpp **** *************************************************************************/
20148:libs/alglib/src/ap.cpp **** void sparsecreatecrsempty(ae_int_t n, sparsematrix* s, ae_state *_state)
20149:libs/alglib/src/ap.cpp **** {
20150:libs/alglib/src/ap.cpp **** 
20151:libs/alglib/src/ap.cpp ****     _sparsematrix_clear(s);
20152:libs/alglib/src/ap.cpp **** 
20153:libs/alglib/src/ap.cpp ****     ae_assert(n>0, "SparseCreateCRSEmpty: N<=0", _state);
20154:libs/alglib/src/ap.cpp ****     sparsecreatecrsemptybuf(n, s, _state);
20155:libs/alglib/src/ap.cpp **** }
20156:libs/alglib/src/ap.cpp **** 
