6374:libs/alglib/src/ap.cpp **** /************************************************************************
6375:libs/alglib/src/ap.cpp **** This function initializes nx-pool:
6376:libs/alglib/src/ap.cpp **** 
6377:libs/alglib/src/ap.cpp **** dst                 destination shared pool, must be zero-filled
6378:libs/alglib/src/ap.cpp ****                     already allocated, but not initialized.
6379:libs/alglib/src/ap.cpp **** datatype            is a type of array elements
6380:libs/alglib/src/ap.cpp **** state               pointer to current state structure. Can not be NULL.
6381:libs/alglib/src/ap.cpp ****                     used for exception handling (say, allocation error results
6382:libs/alglib/src/ap.cpp ****                     in longjmp call).
6383:libs/alglib/src/ap.cpp **** make_automatic      if true, vector will be registered in the current frame
6384:libs/alglib/src/ap.cpp ****                     of the state structure;
6385:libs/alglib/src/ap.cpp ****                     
6386:libs/alglib/src/ap.cpp **** The newly initialized pool has N set to zero.
6387:libs/alglib/src/ap.cpp ****                       
6388:libs/alglib/src/ap.cpp **** Error handling:
6389:libs/alglib/src/ap.cpp **** * on failure calls ae_break() with NULL state pointer. Usually it  results
6390:libs/alglib/src/ap.cpp ****   in abort() call.
6391:libs/alglib/src/ap.cpp **** ************************************************************************/
6392:libs/alglib/src/ap.cpp **** void ae_nxpool_init(ae_nxpool *dst, ae_datatype datatype, ae_state *state, ae_bool make_automatic)
6393:libs/alglib/src/ap.cpp **** {
6394:libs/alglib/src/ap.cpp ****     AE_CRITICAL_ASSERT(state!=NULL);
6395:libs/alglib/src/ap.cpp ****     AE_CRITICAL_ASSERT(ae_check_zeros(dst,(ae_int_t)sizeof(*dst)));
6396:libs/alglib/src/ap.cpp ****     
6397:libs/alglib/src/ap.cpp ****     /* attach to frame first, just to be sure that if we fail within malloc, we will be able to cle
6398:libs/alglib/src/ap.cpp ****     dst->frame_entry.deallocator = (ae_destructor)ae_nxpool_destroy;
6399:libs/alglib/src/ap.cpp ****     dst->frame_entry.ptr = dst;
6400:libs/alglib/src/ap.cpp ****     if( make_automatic )
6401:libs/alglib/src/ap.cpp ****         ae_db_attach(&dst->frame_entry, state);
6402:libs/alglib/src/ap.cpp ****     
6403:libs/alglib/src/ap.cpp ****     /* init */
6404:libs/alglib/src/ap.cpp ****     ae_db_init(&dst->storage, 0, state, ae_false);
6405:libs/alglib/src/ap.cpp ****     dst->datatype = datatype;
6406:libs/alglib/src/ap.cpp ****     dst->array_size = 0;
6407:libs/alglib/src/ap.cpp ****     dst->capacity = 0;
6408:libs/alglib/src/ap.cpp ****     dst->nstored = 0;
6409:libs/alglib/src/ap.cpp ****     ae_init_lock(&dst->pool_lock, state, ae_false);
6410:libs/alglib/src/ap.cpp **** }
6411:libs/alglib/src/ap.cpp **** 
6412:libs/alglib/src/ap.cpp **** 
6413:libs/alglib/src/ap.cpp **** /************************************************************************
6414:libs/alglib/src/ap.cpp **** This function creates copy of ae_nxpool.
6415:libs/alglib/src/ap.cpp **** 
