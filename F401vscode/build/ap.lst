3283:libs/alglib/src/ap.h ****     // This function attaches array to memory pointed by pContent:
3284:libs/alglib/src/ap.h ****     // * only minor amount of own memory is allocated - O(irows) bytes to
3285:libs/alglib/src/ap.h ****     //   store precomputed pointers; but no costly copying of O(rows*cols)
3286:libs/alglib/src/ap.h ****     //   data is performed.
3287:libs/alglib/src/ap.h ****     // * pContent pointer should be valid as long as we work with array
3288:libs/alglib/src/ap.h ****     //
3289:libs/alglib/src/ap.h ****     // After you attach array object to external memory, it becomes
3290:libs/alglib/src/ap.h ****     // "frozen": it is possible to read/write array elements, but
3291:libs/alglib/src/ap.h ****     // it is not allowed to resize it (no setlength() calls).
3292:libs/alglib/src/ap.h ****     //
3293:libs/alglib/src/ap.h ****     void attach_to_ptr(ae_int_t irows, ae_int_t icols, double *pContent);
