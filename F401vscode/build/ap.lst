2645:libs/alglib/src/ap.cpp **** /************************************************************************
2646:libs/alglib/src/ap.cpp **** This function clears smart pointer structure.
2647:libs/alglib/src/ap.cpp **** 
2648:libs/alglib/src/ap.cpp **** dst                 destination smart pointer.
2649:libs/alglib/src/ap.cpp **** 
2650:libs/alglib/src/ap.cpp **** After call to this function smart pointer contains NULL reference,  which
2651:libs/alglib/src/ap.cpp **** is  propagated  to  its  subscriber  (in  cases  non-NULL  subscruber was
ARM GAS  C:\Users\subdia\AppData\Local\Temp\ccz6Svo7.s 			page 48


2652:libs/alglib/src/ap.cpp **** specified during pointer creation).
2653:libs/alglib/src/ap.cpp **** ************************************************************************/
2654:libs/alglib/src/ap.cpp **** void ae_smart_ptr_clear(void *_dst)
2655:libs/alglib/src/ap.cpp **** {
2656:libs/alglib/src/ap.cpp ****     ae_smart_ptr *dst = (ae_smart_ptr*)_dst;
2657:libs/alglib/src/ap.cpp ****     if( dst->is_owner && dst->ptr!=NULL )
2658:libs/alglib/src/ap.cpp ****     {
2659:libs/alglib/src/ap.cpp ****         dst->destructor(dst->ptr);
2660:libs/alglib/src/ap.cpp ****         if( dst->is_dynamic )
2661:libs/alglib/src/ap.cpp ****             ae_free(dst->ptr);
2662:libs/alglib/src/ap.cpp ****     }
2663:libs/alglib/src/ap.cpp ****     dst->is_owner = ae_false;
2664:libs/alglib/src/ap.cpp ****     dst->is_dynamic = ae_false;
2665:libs/alglib/src/ap.cpp ****     dst->ptr = NULL;
2666:libs/alglib/src/ap.cpp ****     dst->size_of_object = 0;
2667:libs/alglib/src/ap.cpp ****     dst->copy_constructor = NULL;
2668:libs/alglib/src/ap.cpp ****     dst->destructor = NULL;
2669:libs/alglib/src/ap.cpp ****     if( dst->subscriber!=NULL )
2670:libs/alglib/src/ap.cpp ****         *(dst->subscriber) = NULL;
2671:libs/alglib/src/ap.cpp **** }
