 675:libs/alglib/src/ap.cpp **** /************************************************************************
 676:libs/alglib/src/ap.cpp **** This function maps nworkers  number  (which  can  be  positive,  zero  or
 677:libs/alglib/src/ap.cpp **** negative with 0 meaning "all cores", -1 meaning "all cores -1" and so on)
 678:libs/alglib/src/ap.cpp **** to "effective", strictly positive workers count.
 679:libs/alglib/src/ap.cpp **** 
 680:libs/alglib/src/ap.cpp **** This  function  is  intended  to  be used by debugging/testing code which
 681:libs/alglib/src/ap.cpp **** tests different number of worker threads. It is NOT aligned  in  any  way
 682:libs/alglib/src/ap.cpp **** with ALGLIB multithreading framework (i.e. it can return  non-zero worker
 683:libs/alglib/src/ap.cpp **** count even for single-threaded GPLed ALGLIB).
 684:libs/alglib/src/ap.cpp **** ************************************************************************/
 685:libs/alglib/src/ap.cpp **** ae_int_t ae_get_effective_workers(ae_int_t nworkers)
 686:libs/alglib/src/ap.cpp **** {
 687:libs/alglib/src/ap.cpp ****     ae_int_t ncores;
 688:libs/alglib/src/ap.cpp ****     
 689:libs/alglib/src/ap.cpp ****     /* determine cores count */
 690:libs/alglib/src/ap.cpp **** #if defined(AE_NWORKERS)
 691:libs/alglib/src/ap.cpp ****     ncores = AE_NWORKERS;
 692:libs/alglib/src/ap.cpp **** #else
 693:libs/alglib/src/ap.cpp ****     ncores = get_nprocessors_cached();
 694:libs/alglib/src/ap.cpp **** #endif
 695:libs/alglib/src/ap.cpp ****     AE_CRITICAL_ASSERT(ncores>=1);
 696:libs/alglib/src/ap.cpp **** 
 697:libs/alglib/src/ap.cpp ****     /* map nworkers to its effective value */
 698:libs/alglib/src/ap.cpp ****     if( nworkers>=1 )
 699:libs/alglib/src/ap.cpp ****         return nworkers>ncores ? ncores : nworkers;
 700:libs/alglib/src/ap.cpp ****     return ncores+nworkers>=1 ? ncores+nworkers : 1;
 701:libs/alglib/src/ap.cpp **** }
