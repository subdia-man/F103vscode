2805:libs/alglib/src/ap.h **** protected:
2806:libs/alglib/src/ap.h **** #if !defined(AE_NO_EXCEPTIONS)
2807:libs/alglib/src/ap.h ****     //
2808:libs/alglib/src/ap.h ****     // Copies array given by string into current object. Additional
2809:libs/alglib/src/ap.h ****     // parameter DATATYPE contains information about type of the data
2810:libs/alglib/src/ap.h ****     // in S and type of the array to create.
2811:libs/alglib/src/ap.h ****     //
2812:libs/alglib/src/ap.h ****     // NOTE: this function is not supported in exception-free mode.
2813:libs/alglib/src/ap.h ****     //
2814:libs/alglib/src/ap.h ****     ae_vector_wrapper(const char *s, alglib_impl::ae_datatype datatype);
2815:libs/alglib/src/ap.h **** #endif
2816:libs/alglib/src/ap.h **** 
2817:libs/alglib/src/ap.h ****     //
2818:libs/alglib/src/ap.h ****     // This function attaches wrapper object to external x_vector structure;
2819:libs/alglib/src/ap.h ****     // "frozen proxy" mode is activated (you can read/write, but can not reallocate
2820:libs/alglib/src/ap.h ****     // and do not own memory of the vector).
2821:libs/alglib/src/ap.h ****     //
2822:libs/alglib/src/ap.h ****     // NOTE: initial state of wrapper object is assumed to be initialized;
ARM GAS  C:\Users\subdia\AppData\Local\Temp\ccz6Svo7.s 			page 1644


2823:libs/alglib/src/ap.h ****     //       all previously allocated memory is properly deallocated.
2824:libs/alglib/src/ap.h ****     //
2825:libs/alglib/src/ap.h ****     // NOTE: x_vector structure pointed by new_ptr is used only once; after
2826:libs/alglib/src/ap.h ****     //       we fetch pointer to memory and its size, this structure is ignored
2827:libs/alglib/src/ap.h ****     //       and not referenced anymore. So, you can pass pointers to temporary
2828:libs/alglib/src/ap.h ****     //       x-structures which are deallocated immediately after you call attach_to()
2829:libs/alglib/src/ap.h ****     //
2830:libs/alglib/src/ap.h ****     // NOTE: state structure is used for error reporting purposes (longjmp on errors).
2831:libs/alglib/src/ap.h ****     //
2832:libs/alglib/src/ap.h ****     void attach_to(alglib_impl::x_vector *new_ptr, alglib_impl::ae_state *_state);
2833:libs/alglib/src/ap.h **** 
2834:libs/alglib/src/ap.h ****     //
2835:libs/alglib/src/ap.h ****     // Assigns RHS to current object. Returns *this.
2836:libs/alglib/src/ap.h ****     //
2837:libs/alglib/src/ap.h ****     // It has several branches depending on target object status:
2838:libs/alglib/src/ap.h ****     // * in case it is proxy object, data are copied into memory pointed by
2839:libs/alglib/src/ap.h ****     //   proxy. Function checks that source has exactly same size as target
2840:libs/alglib/src/ap.h ****     //   (exception is thrown on failure).
2841:libs/alglib/src/ap.h ****     // * in case it is non-proxy object, data allocated by object are cleared
2842:libs/alglib/src/ap.h ****     //   and a copy of RHS is created in target.
2843:libs/alglib/src/ap.h ****     //
2844:libs/alglib/src/ap.h ****     // NOTE: this function correctly handles assignments of the object to itself.
2845:libs/alglib/src/ap.h ****     //
2846:libs/alglib/src/ap.h ****     const ae_vector_wrapper& assign(const ae_vector_wrapper &rhs);
2847:libs/alglib/src/ap.h ****     
2848:libs/alglib/src/ap.h ****     //
2849:libs/alglib/src/ap.h ****     // Pointer to ae_vector structure:
2850:libs/alglib/src/ap.h ****     // * ptr==&inner_vec means that wrapper object owns ae_vector structure and
2851:libs/alglib/src/ap.h ****     //   is responsible for proper deallocation of its memory
2852:libs/alglib/src/ap.h ****     // * ptr!=&inner_vec means that wrapper object works with someone's other
2853:libs/alglib/src/ap.h ****     //   ae_vector record and is not responsible for its memory; in this case
2854:libs/alglib/src/ap.h ****     //   inner_vec is assumed to be uninitialized.
2855:libs/alglib/src/ap.h ****     //
2856:libs/alglib/src/ap.h ****     alglib_impl::ae_vector *ptr;
2857:libs/alglib/src/ap.h ****     
2858:libs/alglib/src/ap.h ****     //
2859:libs/alglib/src/ap.h ****     // Inner ae_vector record.
2860:libs/alglib/src/ap.h ****     // Ignored for ptr!=&inner_rec.
2861:libs/alglib/src/ap.h ****     //
2862:libs/alglib/src/ap.h ****     alglib_impl::ae_vector inner_vec;
2863:libs/alglib/src/ap.h ****     
2864:libs/alglib/src/ap.h ****     //
2865:libs/alglib/src/ap.h ****     // Whether this wrapper object is frozen proxy (you may read array, may
2866:libs/alglib/src/ap.h ****     // modify its value, but can not deallocate its memory or resize it) or not.
2867:libs/alglib/src/ap.h ****     //
2868:libs/alglib/src/ap.h ****     // If is_frozen_proxy==true and if:
