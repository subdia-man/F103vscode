2438:libs/alglib/src/ap.cpp ****     
2439:libs/alglib/src/ap.cpp ****     rows = (ae_int_t)src->rows;
2440:libs/alglib/src/ap.cpp ****     cols = (ae_int_t)src->cols;
2441:libs/alglib/src/ap.cpp ****     
2442:libs/alglib/src/ap.cpp ****     /* check that X-source is densely packed */
2443:libs/alglib/src/ap.cpp ****     ae_assert(src->cols==src->stride, "ae_matrix_init_attach_to_x(): unsupported stride", state);
2444:libs/alglib/src/ap.cpp ****     
2445:libs/alglib/src/ap.cpp ****     /* ensure that size is correct */
