12603:libs/alglib/src/ap.cpp ****     
12604:libs/alglib/src/ap.cpp ****     /*
12605:libs/alglib/src/ap.cpp ****      * Handle general case: nonzero alpha, n and m
12606:libs/alglib/src/ap.cpp ****      *
12607:libs/alglib/src/ap.cpp ****      */
12608:libs/alglib/src/ap.cpp ****     if( m==32 && n==32 )
