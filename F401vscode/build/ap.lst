13097:libs/alglib/src/ap.cpp ****         for(j=0; j<n; j++)
13098:libs/alglib/src/ap.cpp ****         {
13099:libs/alglib/src/ap.cpp ****             v0 += pa[0]*pb[0];
13100:libs/alglib/src/ap.cpp ****             v1 += pa[0]*pb[1];
13101:libs/alglib/src/ap.cpp ****             v0 -= pa[1]*pb[1];
13102:libs/alglib/src/ap.cpp ****             v1 += pa[1]*pb[0];
