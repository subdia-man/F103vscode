14954:libs/alglib/src/ap.cpp ****     ae_int_t src_stride,
14955:libs/alglib/src/ap.cpp ****     double *dst)
14956:libs/alglib/src/ap.cpp **** {
14957:libs/alglib/src/ap.cpp ****     ae_int_t n2, j, stride2;
14958:libs/alglib/src/ap.cpp ****     
14959:libs/alglib/src/ap.cpp ****     /*
14960:libs/alglib/src/ap.cpp ****      * handle special case
14961:libs/alglib/src/ap.cpp ****      */
14962:libs/alglib/src/ap.cpp ****     if( col1==NULL )
14963:libs/alglib/src/ap.cpp ****     {
14964:libs/alglib/src/ap.cpp ****         for(j=0; j<n; j++)
14965:libs/alglib/src/ap.cpp ****         {
14966:libs/alglib/src/ap.cpp ****             dst[0] = *col0;
14967:libs/alglib/src/ap.cpp ****             dst[1] = 0.0;
14968:libs/alglib/src/ap.cpp ****             col0 += src_stride;
14969:libs/alglib/src/ap.cpp ****             dst  += 2;
14970:libs/alglib/src/ap.cpp ****         }
14971:libs/alglib/src/ap.cpp ****         return;
14972:libs/alglib/src/ap.cpp ****     }
14973:libs/alglib/src/ap.cpp **** 
14974:libs/alglib/src/ap.cpp ****     /*
ARM GAS  C:\Users\subdia\AppData\Local\Temp\ccz6Svo7.s 			page 282


14975:libs/alglib/src/ap.cpp ****      * handle general case
14976:libs/alglib/src/ap.cpp ****      */
14977:libs/alglib/src/ap.cpp ****     n2 = n/2;
14978:libs/alglib/src/ap.cpp ****     stride2 = src_stride*2;
14979:libs/alglib/src/ap.cpp ****     for(j=0; j<n2; j++)
14980:libs/alglib/src/ap.cpp ****     {
