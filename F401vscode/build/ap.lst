4982:libs/alglib/src/ap.cpp **** /************************************************************************
4983:libs/alglib/src/ap.cpp **** This function converts three bytes (24 bits) to four six-bit values 
4984:libs/alglib/src/ap.cpp **** (24 bits again).
4985:libs/alglib/src/ap.cpp **** 
4986:libs/alglib/src/ap.cpp **** src     pointer to three bytes
4987:libs/alglib/src/ap.cpp **** dst     pointer to four ints
4988:libs/alglib/src/ap.cpp **** ************************************************************************/
4989:libs/alglib/src/ap.cpp **** void ae_threebytes2foursixbits(const unsigned char *src, ae_int_t *dst)
4990:libs/alglib/src/ap.cpp **** {
4991:libs/alglib/src/ap.cpp ****     dst[0] = src[0] & 0x3F;
4992:libs/alglib/src/ap.cpp ****     dst[1] = (src[0]>>6) | ((src[1]&0x0F)<<2);
4993:libs/alglib/src/ap.cpp ****     dst[2] = (src[1]>>4) | ((src[2]&0x03)<<4);
4994:libs/alglib/src/ap.cpp ****     dst[3] = src[2]>>2;
4995:libs/alglib/src/ap.cpp **** }
4996:libs/alglib/src/ap.cpp **** 
4997:libs/alglib/src/ap.cpp **** /************************************************************************
4998:libs/alglib/src/ap.cpp **** This function converts four six-bit values (24 bits) to three bytes
4999:libs/alglib/src/ap.cpp **** (24 bits again).
