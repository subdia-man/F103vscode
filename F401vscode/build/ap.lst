5570:libs/alglib/src/ap.cpp ****     /* very unlikely because no one will wait for such amount of cycles */
5571:libs/alglib/src/ap.cpp ****     if( cnt>0x12345678 )
5572:libs/alglib/src/ap.cpp ****         ae_never_change_it = cnt%10;
5573:libs/alglib/src/ap.cpp ****     
5574:libs/alglib/src/ap.cpp ****     /* spin wait, test condition which will never be true */
