15412:libs/alglib/src/ap.cpp **** and will do its work.
15413:libs/alglib/src/ap.cpp **** *************************************************************************/
15414:libs/alglib/src/ap.cpp **** #if defined(AE_HAS_SSE2_INTRINSICS)
15415:libs/alglib/src/ap.cpp **** void _ialglib_mm22x2_sse2(double alpha, const double *a, const double *b0, const double *b1, ae_int
