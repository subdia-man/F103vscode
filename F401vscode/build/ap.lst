1832:libs/alglib/src/ap.cpp ****         ((ae_destructor)block->deallocator)(block->ptr);
1833:libs/alglib/src/ap.cpp ****     block->ptr = NULL;
1834:libs/alglib/src/ap.cpp ****     block->valgrind_hint = NULL;
1835:libs/alglib/src/ap.cpp ****     block->deallocator = ae_free;
1836:libs/alglib/src/ap.cpp **** }
