2792:libs/alglib/src/ap.h ****     //
2793:libs/alglib/src/ap.h ****     ae_int_t length() const;
2794:libs/alglib/src/ap.h ****     
2795:libs/alglib/src/ap.h ****     //
2796:libs/alglib/src/ap.h ****     // Access to internal C-structure used by C-core.
2797:libs/alglib/src/ap.h ****     // Not intended for external use.
2798:libs/alglib/src/ap.h ****     //
2799:libs/alglib/src/ap.h ****     const alglib_impl::ae_vector* c_ptr() const;
2800:libs/alglib/src/ap.h ****     alglib_impl::ae_vector* c_ptr();
2801:libs/alglib/src/ap.h **** private:
