 168:libs/etl/ipool.h ****       typedef ETL_OR_STD::forward_iterator_tag                                      iterator_catego
 169:libs/etl/ipool.h ****       typedef typename etl::conditional<is_const, const void*, void*>::type         void_type;
 170:libs/etl/ipool.h ****       typedef typename etl::conditional<is_const, const ipool, ipool>::type         pool_type;
 171:libs/etl/ipool.h ****       typedef typename etl::conditional<is_const, const char* const*, char**>::type pointer_type;
