2080:libs/etl/map.h ****     //*************************************************************************
2081:libs/etl/map.h ****     /// Find the parent node that contains the node provided in its left or
2082:libs/etl/map.h ****     /// right tree
2083:libs/etl/map.h ****     //*************************************************************************
2084:libs/etl/map.h ****     const Node* find_parent_node(const Node* position, const Node* node) const
2085:libs/etl/map.h ****     {
2086:libs/etl/map.h ****       // Default to no parent node found
2087:libs/etl/map.h ****       const Node* found = ETL_NULLPTR;
2088:libs/etl/map.h **** 
2089:libs/etl/map.h ****       // If the position provided is the same as the node then there is no
2090:libs/etl/map.h ****       // parent
2091:libs/etl/map.h ****       if (position && node && position != node)
2092:libs/etl/map.h ****       {
2093:libs/etl/map.h ****         while (position)
2094:libs/etl/map.h ****         {
2095:libs/etl/map.h ****           // Is this position not the parent of the node we are looking for?
2096:libs/etl/map.h ****           if (position->children[kLeft] != node && position->children[kRight] != node)
2097:libs/etl/map.h ****           {
2098:libs/etl/map.h ****             // Downcast node and position to Data_Node references for key
2099:libs/etl/map.h ****             // comparisons
2100:libs/etl/map.h ****             const Data_Node& node_data_node     = imap::data_cast(*node);
2101:libs/etl/map.h ****             const Data_Node& position_data_node = imap::data_cast(*position);
2102:libs/etl/map.h ****             // Compare the node value to the current position value
2103:libs/etl/map.h ****             if (node_comp(node_data_node, position_data_node))
2104:libs/etl/map.h ****             {
ARM GAS  C:\Users\subdia\AppData\Local\Temp\ccpTTeXz.s 			page 243


2105:libs/etl/map.h ****               // Keep looking for parent on the left
2106:libs/etl/map.h ****               position = position->children[kLeft];
2107:libs/etl/map.h ****             }
2108:libs/etl/map.h ****             else if (node_comp(position_data_node, node_data_node))
2109:libs/etl/map.h ****             {
2110:libs/etl/map.h ****               // Keep looking for parent on the right
2111:libs/etl/map.h ****               position = position->children[kRight];
2112:libs/etl/map.h ****             }
2113:libs/etl/map.h ****           }
2114:libs/etl/map.h ****           else
2115:libs/etl/map.h ****           {
2116:libs/etl/map.h ****             // Return the current position as the parent node found
2117:libs/etl/map.h ****             found = position;
2118:libs/etl/map.h **** 
2119:libs/etl/map.h ****             // Parent node found, exit loop
2120:libs/etl/map.h ****             break;
2121:libs/etl/map.h ****           }
2122:libs/etl/map.h ****         }
2123:libs/etl/map.h ****       }
2124:libs/etl/map.h **** 
2125:libs/etl/map.h ****       // Return the parent node found (might be ETL_NULLPTR)
2126:libs/etl/map.h ****       return found;
2127:libs/etl/map.h ****     }
