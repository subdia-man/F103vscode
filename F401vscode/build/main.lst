 117:libs/etl/queue.h ****     }
 118:libs/etl/queue.h **** 
 119:libs/etl/queue.h ****     //*************************************************************************
 120:libs/etl/queue.h ****     /// Returns the maximum number of items that can be queued.
 121:libs/etl/queue.h ****     //*************************************************************************
 122:libs/etl/queue.h ****     size_type max_size() const
 123:libs/etl/queue.h ****     {
ARM GAS  C:\Users\subdia\AppData\Local\Temp\ccpTTeXz.s 			page 15


 124:libs/etl/queue.h ****       return CAPACITY;
 125:libs/etl/queue.h ****     }
 126:libs/etl/queue.h **** 
 127:libs/etl/queue.h ****     //*************************************************************************
 128:libs/etl/queue.h ****     /// Returns the maximum number of items that can be queued.
 129:libs/etl/queue.h ****     //*************************************************************************
 130:libs/etl/queue.h ****     size_type capacity() const
 131:libs/etl/queue.h ****     {
 132:libs/etl/queue.h ****       return CAPACITY;
 133:libs/etl/queue.h ****     }
 134:libs/etl/queue.h **** 
 135:libs/etl/queue.h ****     //*************************************************************************
 136:libs/etl/queue.h ****     /// Checks to see if the queue is empty.
 137:libs/etl/queue.h ****     /// \return <b>true</b> if the queue is empty, otherwise <b>false</b>
 138:libs/etl/queue.h ****     //*************************************************************************
 139:libs/etl/queue.h ****     bool empty() const
 140:libs/etl/queue.h ****     {
 141:libs/etl/queue.h ****       return current_size == 0;
