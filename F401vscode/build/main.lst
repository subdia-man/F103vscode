 154:libs/etl/queue.h ****     /// Returns the remaining capacity.
 155:libs/etl/queue.h ****     ///\return The remaining capacity.
 156:libs/etl/queue.h ****     //*************************************************************************
 157:libs/etl/queue.h ****     size_type available() const
