2129:libs/etl/map.h ****     //*************************************************************************
2130:libs/etl/map.h ****     /// Find the node whose key is not considered to go before the key provided
2131:libs/etl/map.h ****     //*************************************************************************
2132:libs/etl/map.h ****     Node* find_lower_node(Node* position, const_key_reference key) const
2133:libs/etl/map.h ****     {
2134:libs/etl/map.h ****       // Something at this position? keep going
2135:libs/etl/map.h ****       Node* lower_node = ETL_NULLPTR;
2136:libs/etl/map.h ****       while (position)
2137:libs/etl/map.h ****       {
2138:libs/etl/map.h ****         // Downcast lower node to Data_Node reference for key comparisons
2139:libs/etl/map.h ****         Data_Node& data_node = imap::data_cast(*position);
2140:libs/etl/map.h ****         // Compare the key value to the current lower node key value
2141:libs/etl/map.h ****         if (node_comp(key, data_node))
2142:libs/etl/map.h ****         {
2143:libs/etl/map.h ****           lower_node = position;
2144:libs/etl/map.h ****           if (position->children[kLeft])
2145:libs/etl/map.h ****           {
