 438:libs/etl/ipool.h ****     //*************************************************************************
 439:libs/etl/ipool.h ****     /// Destroys the object.
 440:libs/etl/ipool.h ****     /// Undefined behaviour if the pool does not contain a 'T'.
 441:libs/etl/ipool.h ****     /// \param p_object A pointer to the object to be destroyed.
 442:libs/etl/ipool.h ****     //*************************************************************************
 443:libs/etl/ipool.h ****     template <typename T>
 444:libs/etl/ipool.h ****     void destroy(const T* const p_object)
 445:libs/etl/ipool.h ****     {
 446:libs/etl/ipool.h ****       if (sizeof(T) > Item_Size)
 447:libs/etl/ipool.h ****       {
 448:libs/etl/ipool.h ****         ETL_ASSERT(false, ETL_ERROR(etl::pool_element_size));
 449:libs/etl/ipool.h ****       }
 450:libs/etl/ipool.h **** 
 451:libs/etl/ipool.h ****       p_object->~T();
 452:libs/etl/ipool.h ****       release(p_object);
 453:libs/etl/ipool.h ****     }
 454:libs/etl/ipool.h **** 
 455:libs/etl/ipool.h ****     //*************************************************************************
 456:libs/etl/ipool.h ****     /// Release an object in the pool.
 457:libs/etl/ipool.h ****     /// If asserts or exceptions are enabled and the object does not belong to
 458:libs/etl/ipool.h ****     /// this pool then an etl::pool_object_not_in_pool is thrown. \param
 459:libs/etl/ipool.h ****     /// p_object A pointer to the object to be released.
 460:libs/etl/ipool.h ****     //*************************************************************************
 461:libs/etl/ipool.h ****     void release(const void* const p_object)
 462:libs/etl/ipool.h ****     {
 463:libs/etl/ipool.h ****       const uintptr_t p = uintptr_t(p_object);
 464:libs/etl/ipool.h ****       release_item((char*)p);
 465:libs/etl/ipool.h ****     }
 466:libs/etl/ipool.h **** 
 467:libs/etl/ipool.h ****     //*************************************************************************
 468:libs/etl/ipool.h ****     /// Release all objects in the pool.
 469:libs/etl/ipool.h ****     //*************************************************************************
 470:libs/etl/ipool.h ****     void release_all()
 471:libs/etl/ipool.h ****     {
 472:libs/etl/ipool.h ****       items_allocated   = 0;
 473:libs/etl/ipool.h ****       items_initialised = 0;
 474:libs/etl/ipool.h ****       p_next            = p_buffer;
 475:libs/etl/ipool.h ****     }
 476:libs/etl/ipool.h **** 
 477:libs/etl/ipool.h ****     //*************************************************************************
 478:libs/etl/ipool.h ****     /// Check to see if the object belongs to the pool.
ARM GAS  C:\Users\subdia\AppData\Local\Temp\ccpTTeXz.s 			page 52


 479:libs/etl/ipool.h ****     /// \param p_object A pointer to the object to be checked.
 480:libs/etl/ipool.h ****     /// \return <b>true<\b> if it does, otherwise <b>false</b>
 481:libs/etl/ipool.h ****     //*************************************************************************
 482:libs/etl/ipool.h ****     bool is_in_pool(const void* const p_object) const
 483:libs/etl/ipool.h ****     {
 484:libs/etl/ipool.h ****       const uintptr_t p = uintptr_t(p_object);
 485:libs/etl/ipool.h ****       return is_item_in_pool((const char*)p);
 486:libs/etl/ipool.h ****     }
