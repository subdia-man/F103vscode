 124:libs/etl/ipool.h ****     }
 125:libs/etl/ipool.h **** 
 126:libs/etl/ipool.h ****     //***************************************************************************
 127:libs/etl/ipool.h ****     /// Optimization: a candidate for being in free list, but no guarantee
 128:libs/etl/ipool.h ****     /// if false, cannot be part of free list, and therefore is allocated
 129:libs/etl/ipool.h ****     /// if true, possibly in free list, but still needs to be checked via free
 130:libs/etl/ipool.h ****     /// list
 131:libs/etl/ipool.h ****     //***************************************************************************
 132:libs/etl/ipool.h ****     bool is_pointing_into_pool_or_end_or_nullptr(const char* address) const
 133:libs/etl/ipool.h ****     {
 134:libs/etl/ipool.h ****       return address == ETL_NULLPTR || (p_buffer <= address && address <= buffer_end());
 135:libs/etl/ipool.h ****     }
 136:libs/etl/ipool.h **** 
ARM GAS  C:\Users\subdia\AppData\Local\Temp\ccpTTeXz.s 			page 46


 137:libs/etl/ipool.h ****     //***************************************************************************
 138:libs/etl/ipool.h ****     /// Iterate free list to confirm specified address is included or not
 139:libs/etl/ipool.h ****     //***************************************************************************
 140:libs/etl/ipool.h ****     bool is_in_free_list(const char* address) const
 141:libs/etl/ipool.h ****     {
 142:libs/etl/ipool.h ****       const char* i = p_next;
 143:libs/etl/ipool.h ****       while (i != ETL_NULLPTR)
 144:libs/etl/ipool.h ****       {
 145:libs/etl/ipool.h ****         if (address == i)
 146:libs/etl/ipool.h ****         {
 147:libs/etl/ipool.h ****           return true;
 148:libs/etl/ipool.h ****         }
 149:libs/etl/ipool.h ****         i = *reinterpret_cast<const char* const*>(i);
 150:libs/etl/ipool.h ****       }
 151:libs/etl/ipool.h ****       return false;
 152:libs/etl/ipool.h ****     }
