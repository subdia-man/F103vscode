 104:libs/etl/queue.h ****   class queue_base
 105:libs/etl/queue.h ****   {
 106:libs/etl/queue.h ****   public:
 107:libs/etl/queue.h **** 
 108:libs/etl/queue.h ****     /// The type used for determining the size of queue.
 109:libs/etl/queue.h ****     typedef typename etl::size_type_lookup<MEMORY_MODEL>::type size_type;
 110:libs/etl/queue.h **** 
