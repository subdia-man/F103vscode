 243:libs/etl/ipool.h ****           {
 244:libs/etl/ipool.h ****             return;
 245:libs/etl/ipool.h ****           }
 246:libs/etl/ipool.h ****           if (!p_pool->is_in_free_list(p_current))
 247:libs/etl/ipool.h ****           {
 248:libs/etl/ipool.h ****             return;
 249:libs/etl/ipool.h ****           }
 250:libs/etl/ipool.h ****           p_current += p_pool->Item_Size;
ARM GAS  C:\Users\subdia\AppData\Local\Temp\ccpTTeXz.s 			page 48


 251:libs/etl/ipool.h ****         }
 252:libs/etl/ipool.h ****       }
