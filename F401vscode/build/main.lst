 233:libs/etl/ipool.h ****       //***************************************************************************
 234:libs/etl/ipool.h ****       /// Find allocated item by increasing p_current, starting at p_current.
 235:libs/etl/ipool.h ****       /// Leave p_current at buffer_end() if no further allocated item found.
 236:libs/etl/ipool.h ****       //***************************************************************************
 237:libs/etl/ipool.h ****       void find_allocated()
 238:libs/etl/ipool.h ****       {
 239:libs/etl/ipool.h ****         while (p_current < p_pool->buffer_end())
 240:libs/etl/ipool.h ****         {
 241:libs/etl/ipool.h ****           value_type value = *reinterpret_cast<pointer_type>(p_current);
