 918:libs/etl/map.h ****     //*********************************************************************
 919:libs/etl/map.h ****     mapped_reference operator[](rvalue_key_reference key)
 920:libs/etl/map.h ****     {
 921:libs/etl/map.h ****       iterator i_element = find(etl::move(key));
