 476:libs/etl/map.h ****     typedef size_t            size_type;
 477:libs/etl/map.h **** 
 478:libs/etl/map.h ****     /// Defines the parameter types
 479:libs/etl/map.h ****     typedef const key_type& const_key_reference;
 480:libs/etl/map.h **** #if ETL_USING_CPP11
 481:libs/etl/map.h ****     typedef key_type&& rvalue_key_reference;
 482:libs/etl/map.h **** #endif
 483:libs/etl/map.h ****     typedef mapped_type&       mapped_reference;
 484:libs/etl/map.h ****     typedef const mapped_type& const_mapped_reference;
 485:libs/etl/map.h **** 
 486:libs/etl/map.h ****     class value_compare
 487:libs/etl/map.h ****     {
 488:libs/etl/map.h ****     public:
 489:libs/etl/map.h **** 
 490:libs/etl/map.h ****       bool operator()(const_reference lhs, const_reference rhs) const
 491:libs/etl/map.h ****       {
 492:libs/etl/map.h ****         return (kcompare(lhs.first, rhs.first));
 493:libs/etl/map.h ****       }
 494:libs/etl/map.h **** 
