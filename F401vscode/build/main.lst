 457:libs/etl/map.h ****   /// A templated base for all etl::map types.
 458:libs/etl/map.h ****   ///\ingroup map
 459:libs/etl/map.h ****   //***************************************************************************
 460:libs/etl/map.h ****   template <typename TKey, typename TMapped, typename TKeyCompare = etl::less<TKey> >
 461:libs/etl/map.h ****   class imap : public etl::map_base
 462:libs/etl/map.h ****   {
 463:libs/etl/map.h ****   public:
 464:libs/etl/map.h **** 
 465:libs/etl/map.h ****     typedef TKey                                  key_type;
 466:libs/etl/map.h ****     typedef ETL_OR_STD::pair<const TKey, TMapped> value_type;
 467:libs/etl/map.h ****     typedef TMapped                               mapped_type;
 468:libs/etl/map.h ****     typedef TKeyCompare                           key_compare;
 469:libs/etl/map.h ****     typedef value_type&                           reference;
 470:libs/etl/map.h ****     typedef const value_type&                     const_reference;
 471:libs/etl/map.h **** #if ETL_USING_CPP11
 472:libs/etl/map.h ****     typedef value_type&& rvalue_reference;
