 241:libs/etl/map.h ****     void balance_node(Node*& critical_node)
 242:libs/etl/map.h ****     {
 243:libs/etl/map.h ****       // Step 1: Update weights for all children of the critical node up to the
 244:libs/etl/map.h ****       // newly inserted node. This step is costly (in terms of traversing nodes
 245:libs/etl/map.h ****       // multiple times during insertion) but doesn't require as much recursion
 246:libs/etl/map.h ****       Node* weight_node = critical_node->children[critical_node->dir];
 247:libs/etl/map.h ****       while (weight_node)
 248:libs/etl/map.h ****       {
 249:libs/etl/map.h ****         // Keep going until we reach a terminal node (dir == kNeither)
 250:libs/etl/map.h ****         if (uint_least8_t(kNeither) != weight_node->dir)
 251:libs/etl/map.h ****         {
 252:libs/etl/map.h ****           // Does this insert balance the previous weight factor value?
 253:libs/etl/map.h ****           if (weight_node->weight == 1 - weight_node->dir)
 254:libs/etl/map.h ****           {
 255:libs/etl/map.h ****             weight_node->weight = uint_least8_t(kNeither);
 256:libs/etl/map.h ****           }
 257:libs/etl/map.h ****           else
 258:libs/etl/map.h ****           {
 259:libs/etl/map.h ****             weight_node->weight = weight_node->dir;
 260:libs/etl/map.h ****           }
 261:libs/etl/map.h **** 
 262:libs/etl/map.h ****           // Update weight factor node to point to next node
 263:libs/etl/map.h ****           weight_node = weight_node->children[weight_node->dir];
 264:libs/etl/map.h ****         }
 265:libs/etl/map.h ****         else
 266:libs/etl/map.h ****         {
 267:libs/etl/map.h ****           // Stop loop, terminal node found
 268:libs/etl/map.h ****           break;
 269:libs/etl/map.h ****         }
 270:libs/etl/map.h ****       } // while(weight_node)
 271:libs/etl/map.h **** 
 272:libs/etl/map.h ****       // Step 2: Update weight for critical_node or rotate tree to balance node
 273:libs/etl/map.h ****       if (uint_least8_t(kNeither) == critical_node->weight)
 274:libs/etl/map.h ****       {
 275:libs/etl/map.h ****         critical_node->weight = critical_node->dir;
 276:libs/etl/map.h ****       }
