 389:libs/etl/utility.h ****   //***************************************************************************
 390:libs/etl/utility.h ****   ///\brief pair holds two objects of arbitrary type
 391:libs/etl/utility.h ****   ///
 392:libs/etl/utility.h ****   ///\tparam T1, T2 The types of the elements that the pair stores
 393:libs/etl/utility.h ****   //***************************************************************************
 394:libs/etl/utility.h ****   template <typename T1, typename T2>
 395:libs/etl/utility.h ****   struct pair
 396:libs/etl/utility.h ****   {
 397:libs/etl/utility.h ****     typedef T1 first_type;  ///< @c first_type is the first bound type
 398:libs/etl/utility.h ****     typedef T2 second_type; ///< @c second_type is the second bound type
 399:libs/etl/utility.h **** 
 400:libs/etl/utility.h ****     T1 first;  ///< @c first is a copy of the first object
 401:libs/etl/utility.h ****     T2 second; ///< @c second is a copy of the second object
 402:libs/etl/utility.h **** 
 403:libs/etl/utility.h ****     //***************************************************************************
 404:libs/etl/utility.h ****     ///\brief Default constructor
 405:libs/etl/utility.h ****     ///
 406:libs/etl/utility.h ****     /// The default constructor creates @c first and @c second using their
 407:libs/etl/utility.h ****     /// respective default constructors.
 408:libs/etl/utility.h ****     //***************************************************************************
 409:libs/etl/utility.h ****     ETL_CONSTEXPR pair()
 410:libs/etl/utility.h ****       : first(T1())
 411:libs/etl/utility.h ****       , second(T2())
 412:libs/etl/utility.h ****     {
 413:libs/etl/utility.h ****     }
 414:libs/etl/utility.h **** 
 415:libs/etl/utility.h ****     //***************************************************************************
 416:libs/etl/utility.h ****     ///\brief Constructor from parameters
 417:libs/etl/utility.h ****     ///
 418:libs/etl/utility.h ****     /// Two objects may be passed to a @c pair constructor to be copied.
 419:libs/etl/utility.h ****     //***************************************************************************
 420:libs/etl/utility.h ****     ETL_CONSTEXPR14 pair(const T1& a, const T2& b)
 421:libs/etl/utility.h ****       : first(a)
 422:libs/etl/utility.h ****       , second(b)
 423:libs/etl/utility.h ****     {
 424:libs/etl/utility.h ****     }
 425:libs/etl/utility.h **** 
 426:libs/etl/utility.h **** #if ETL_USING_CPP11
 427:libs/etl/utility.h ****     //***************************************************************************
 428:libs/etl/utility.h ****     ///\brief Move constructor from parameters.
 429:libs/etl/utility.h ****     //***************************************************************************
 430:libs/etl/utility.h ****     template <typename U1, typename U2>
 431:libs/etl/utility.h ****     ETL_CONSTEXPR14 pair(U1&& a, U2&& b)
 432:libs/etl/utility.h ****       : first(etl::forward<U1>(a))
 433:libs/etl/utility.h ****       , second(etl::forward<U2>(b))
