1304:libs/etl/map.h ****     //*********************************************************************
1305:libs/etl/map.h ****     /// Inserts a range of values to the map.
1306:libs/etl/map.h ****     /// If asserts or exceptions are enabled, emits map_full if the map does not
1307:libs/etl/map.h ****     /// have enough free space.
1308:libs/etl/map.h ****     ///\param position The position to insert at.
1309:libs/etl/map.h ****     ///\param first    The first element to add.
1310:libs/etl/map.h ****     ///\param last     The last + 1 element to add.
1311:libs/etl/map.h ****     //*********************************************************************
1312:libs/etl/map.h ****     template <class TIterator>
1313:libs/etl/map.h ****     void insert(TIterator first, TIterator last)
1314:libs/etl/map.h ****     {
1315:libs/etl/map.h ****       while (first != last)
1316:libs/etl/map.h ****       {
1317:libs/etl/map.h ****         insert(*first);
1318:libs/etl/map.h ****         ++first;
1319:libs/etl/map.h ****       }
1320:libs/etl/map.h ****     }
1321:libs/etl/map.h **** 
1322:libs/etl/map.h **** #if ETL_USING_CPP11 && ETL_NOT_USING_STLPORT
1323:libs/etl/map.h ****     //*********************************************************************
1324:libs/etl/map.h ****     /// Emplaces a value to the map.
1325:libs/etl/map.h ****     /// Constructs the value_type in place from the given arguments.
1326:libs/etl/map.h ****     //*********************************************************************
1327:libs/etl/map.h ****     template <typename... Args>
1328:libs/etl/map.h ****     ETL_OR_STD::pair<iterator, bool> emplace(Args&&... args)
1329:libs/etl/map.h ****     {
1330:libs/etl/map.h ****       ETL_ASSERT(!full(), ETL_ERROR(map_full));
1331:libs/etl/map.h **** 
1332:libs/etl/map.h ****       // Get next available free node
1333:libs/etl/map.h ****       Data_Node& node = allocate_data_node_from_args(etl::forward<Args>(args)...);
1334:libs/etl/map.h **** 
1335:libs/etl/map.h ****       // Obtain the inserted node (might be ETL_NULLPTR if node was a duplicate)
1336:libs/etl/map.h ****       Node* inserted_node = insert_node(root_node, node);
1337:libs/etl/map.h ****       bool  inserted      = inserted_node == &node;
1338:libs/etl/map.h **** 
1339:libs/etl/map.h ****       // Insert node into tree and return iterator to new node location in tree
1340:libs/etl/map.h ****       return ETL_OR_STD::make_pair(iterator(*this, inserted_node), inserted);
1341:libs/etl/map.h ****     }
