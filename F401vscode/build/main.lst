 328:libs/etl/ipool.h ****     //*************************************************************************
 329:libs/etl/ipool.h ****     /// Allocate storage for an object from the pool.
 330:libs/etl/ipool.h ****     /// If asserts or exceptions are enabled and there are no more free items an
 331:libs/etl/ipool.h ****     /// etl::pool_no_allocation if thrown, otherwise a null pointer is returned.
 332:libs/etl/ipool.h ****     //*************************************************************************
 333:libs/etl/ipool.h ****     template <typename T>
 334:libs/etl/ipool.h ****     T* allocate()
 335:libs/etl/ipool.h ****     {
 336:libs/etl/ipool.h ****       if (sizeof(T) > Item_Size)
 337:libs/etl/ipool.h ****       {
 338:libs/etl/ipool.h ****         ETL_ASSERT(false, ETL_ERROR(etl::pool_element_size));
 339:libs/etl/ipool.h ****       }
 340:libs/etl/ipool.h **** 
 341:libs/etl/ipool.h ****       return reinterpret_cast<T*>(allocate_item());
 342:libs/etl/ipool.h ****     }
 343:libs/etl/ipool.h **** 
 344:libs/etl/ipool.h **** #if ETL_CPP11_NOT_SUPPORTED || ETL_POOL_CPP03_CODE || ETL_USING_STLPORT
 345:libs/etl/ipool.h ****     //*************************************************************************
 346:libs/etl/ipool.h ****     /// Allocate storage for an object from the pool and create default.
 347:libs/etl/ipool.h ****     /// If asserts or exceptions are enabled and there are no more free items an
 348:libs/etl/ipool.h ****     /// etl::pool_no_allocation if thrown, otherwise a null pointer is returned.
 349:libs/etl/ipool.h ****     //*************************************************************************
 350:libs/etl/ipool.h ****     template <typename T>
 351:libs/etl/ipool.h ****     T* create()
 352:libs/etl/ipool.h ****     {
 353:libs/etl/ipool.h ****       T* p = allocate<T>();
 354:libs/etl/ipool.h **** 
 355:libs/etl/ipool.h ****       if (p)
 356:libs/etl/ipool.h ****       {
 357:libs/etl/ipool.h ****         ::new (p) T();
 358:libs/etl/ipool.h ****       }
 359:libs/etl/ipool.h **** 
 360:libs/etl/ipool.h ****       return p;
 361:libs/etl/ipool.h ****     }
 362:libs/etl/ipool.h **** 
 363:libs/etl/ipool.h ****     //*************************************************************************
 364:libs/etl/ipool.h ****     /// Allocate storage for an object from the pool and create with 1
ARM GAS  C:\Users\subdia\AppData\Local\Temp\ccpTTeXz.s 			page 50


 365:libs/etl/ipool.h ****     /// parameter. If asserts or exceptions are enabled and there are no more
 366:libs/etl/ipool.h ****     /// free items an etl::pool_no_allocation if thrown, otherwise a null
 367:libs/etl/ipool.h ****     /// pointer is returned.
 368:libs/etl/ipool.h ****     //*************************************************************************
 369:libs/etl/ipool.h ****     template <typename T, typename T1>
 370:libs/etl/ipool.h ****     T* create(const T1& value1)
 371:libs/etl/ipool.h ****     {
 372:libs/etl/ipool.h ****       T* p = allocate<T>();
 373:libs/etl/ipool.h **** 
 374:libs/etl/ipool.h ****       if (p)
 375:libs/etl/ipool.h ****       {
 376:libs/etl/ipool.h ****         ::new (p) T(value1);
 377:libs/etl/ipool.h ****       }
 378:libs/etl/ipool.h **** 
 379:libs/etl/ipool.h ****       return p;
 380:libs/etl/ipool.h ****     }
 381:libs/etl/ipool.h **** 
 382:libs/etl/ipool.h ****     template <typename T, typename T1, typename T2>
 383:libs/etl/ipool.h ****     T* create(const T1& value1, const T2& value2)
 384:libs/etl/ipool.h ****     {
 385:libs/etl/ipool.h ****       T* p = allocate<T>();
 386:libs/etl/ipool.h **** 
 387:libs/etl/ipool.h ****       if (p)
 388:libs/etl/ipool.h ****       {
 389:libs/etl/ipool.h ****         ::new (p) T(value1, value2);
 390:libs/etl/ipool.h ****       }
 391:libs/etl/ipool.h **** 
 392:libs/etl/ipool.h ****       return p;
 393:libs/etl/ipool.h ****     }
 394:libs/etl/ipool.h **** 
 395:libs/etl/ipool.h ****     template <typename T, typename T1, typename T2, typename T3>
 396:libs/etl/ipool.h ****     T* create(const T1& value1, const T2& value2, const T3& value3)
 397:libs/etl/ipool.h ****     {
