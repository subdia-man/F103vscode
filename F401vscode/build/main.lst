2435:libs/etl/map.h ****     //*************************************************************************
2436:libs/etl/map.h ****     /// Find the next node in sequence from the node provided
2437:libs/etl/map.h ****     //*************************************************************************
2438:libs/etl/map.h ****     void next_node(const Node*& position) const
2439:libs/etl/map.h ****     {
2440:libs/etl/map.h ****       if (position)
2441:libs/etl/map.h ****       {
2442:libs/etl/map.h ****         // Is there a tree on the right? then find the minimum of that tree
2443:libs/etl/map.h ****         if (position->children[kRight])
2444:libs/etl/map.h ****         {
2445:libs/etl/map.h ****           // Return minimum node found
2446:libs/etl/map.h ****           position = find_limit_node(position->children[kRight], kLeft);
2447:libs/etl/map.h ****         }
2448:libs/etl/map.h ****         // Otherwise find the parent of this node
2449:libs/etl/map.h ****         else
2450:libs/etl/map.h ****         {
2451:libs/etl/map.h ****           // Start with current position as parent
2452:libs/etl/map.h ****           const Node* parent = position;
2453:libs/etl/map.h ****           do {
2454:libs/etl/map.h ****             // Update current position as previous parent
2455:libs/etl/map.h ****             position = parent;
2456:libs/etl/map.h ****             // Find parent of current position
2457:libs/etl/map.h ****             parent = find_parent_node(root_node, position);
2458:libs/etl/map.h ****             // Repeat while previous position was on right side of parent tree
2459:libs/etl/map.h ****           } while (parent && parent->children[kRight] == position);
2460:libs/etl/map.h **** 
2461:libs/etl/map.h ****           // Set parent node as the next position
2462:libs/etl/map.h ****           position = parent;
2463:libs/etl/map.h ****         }
2464:libs/etl/map.h ****       }
2465:libs/etl/map.h ****     }
