2290:libs/etl/map.h ****     /// Insert a node.
2291:libs/etl/map.h ****     //*************************************************************************
2292:libs/etl/map.h ****     Node* insert_node(Node*& position, Data_Node& node)
2293:libs/etl/map.h ****     {
2294:libs/etl/map.h ****       // Find the location where the node belongs
2295:libs/etl/map.h ****       Node* found = position;
2296:libs/etl/map.h **** 
2297:libs/etl/map.h ****       // Was position provided not empty? then find where the node belongs
2298:libs/etl/map.h ****       if (position)
2299:libs/etl/map.h ****       {
2300:libs/etl/map.h ****         // Find the critical parent node (default to ETL_NULLPTR)
2301:libs/etl/map.h ****         Node* critical_parent_node = ETL_NULLPTR;
2302:libs/etl/map.h ****         Node* critical_node        = root_node;
2303:libs/etl/map.h **** 
2304:libs/etl/map.h ****         while (found)
2305:libs/etl/map.h ****         {
2306:libs/etl/map.h ****           // Search for critical weight node (all nodes whose weight factor
2307:libs/etl/map.h ****           // is set to kNeither (balanced)
2308:libs/etl/map.h ****           if (kNeither != found->weight)
2309:libs/etl/map.h ****           {
2310:libs/etl/map.h ****             critical_node = found;
2311:libs/etl/map.h ****           }
2312:libs/etl/map.h **** 
2313:libs/etl/map.h ****           // Downcast found to Data_Node class for comparison and other
