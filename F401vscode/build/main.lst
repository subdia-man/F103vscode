 181:libs/etl/queue.h ****     /// Increments (and wraps) the 'in' index value to record a queue addition.
 182:libs/etl/queue.h ****     //*************************************************************************
 183:libs/etl/queue.h ****     void add_in()
 184:libs/etl/queue.h ****     {
 185:libs/etl/queue.h ****       if (++in == CAPACITY) ETL_UNLIKELY
 186:libs/etl/queue.h ****       {
 187:libs/etl/queue.h ****         in = 0;
 188:libs/etl/queue.h ****       }
 189:libs/etl/queue.h **** 
 190:libs/etl/queue.h ****       ++current_size;
 191:libs/etl/queue.h ****       ETL_INCREMENT_DEBUG_COUNT;
 192:libs/etl/queue.h ****     }
 193:libs/etl/queue.h **** 
 194:libs/etl/queue.h ****     //*************************************************************************
 195:libs/etl/queue.h ****     /// Increments (and wraps) the 'out' index value to record a queue deletion.
 196:libs/etl/queue.h ****     //*************************************************************************
 197:libs/etl/queue.h ****     void del_out()
 198:libs/etl/queue.h ****     {
 199:libs/etl/queue.h ****       if (++out == CAPACITY) ETL_UNLIKELY
 200:libs/etl/queue.h ****       {
 201:libs/etl/queue.h ****         out = 0;
 202:libs/etl/queue.h ****       }
 203:libs/etl/queue.h ****       --current_size;
 204:libs/etl/queue.h ****       ETL_DECREMENT_DEBUG_COUNT;
 205:libs/etl/queue.h ****     }
 206:libs/etl/queue.h **** 
 207:libs/etl/queue.h ****     //*************************************************************************
 208:libs/etl/queue.h ****     /// Clears the indexes.
 209:libs/etl/queue.h ****     //*************************************************************************
 210:libs/etl/queue.h ****     void index_clear()
 211:libs/etl/queue.h ****     {
 212:libs/etl/queue.h ****       in           = 0;
 213:libs/etl/queue.h ****       out          = 0;
 214:libs/etl/queue.h ****       current_size = 0;
 215:libs/etl/queue.h ****       ETL_RESET_DEBUG_COUNT;
 216:libs/etl/queue.h ****     }
 217:libs/etl/queue.h **** 
 218:libs/etl/queue.h ****     size_type       in;           ///< Where to input new data.
 219:libs/etl/queue.h ****     size_type       out;          ///< Where to get the oldest data.
 220:libs/etl/queue.h ****     size_type       current_size; ///< The number of items in the queue.
 221:libs/etl/queue.h ****     const size_type CAPACITY;     ///< The maximum number of items in the queue.
 222:libs/etl/queue.h ****     ETL_DECLARE_DEBUG_COUNT;      ///< For internal debugging purposes.
 223:libs/etl/queue.h ****   };
 224:libs/etl/queue.h **** 
 225:libs/etl/queue.h ****   //***************************************************************************
 226:libs/etl/queue.h ****   ///\ingroup queue
 227:libs/etl/queue.h ****   ///\brief This is the base for all queues that contain a particular type.
 228:libs/etl/queue.h ****   ///\details Normally a reference to this type will be taken from a derived
 229:libs/etl/queue.h ****   /// queue. \code
 230:libs/etl/queue.h ****   /// etl::queue<int, 10> myQueue;
 231:libs/etl/queue.h ****   /// etl::iqueue<int>& iQueue = myQueue;
 232:libs/etl/queue.h ****   ///\endcode
 233:libs/etl/queue.h ****   /// \warning This queue cannot be used for concurrent access from multiple
 234:libs/etl/queue.h ****   /// threads. \tparam T The type of value that the queue holds.
 235:libs/etl/queue.h ****   //***************************************************************************
 236:libs/etl/queue.h ****   template <typename T, const size_t MEMORY_MODEL = etl::memory_model::MEMORY_MODEL_LARGE>
