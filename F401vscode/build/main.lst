2758:libs/etl/map.h ****         {
2759:libs/etl/map.h ****           // Update the direction to the target/replace node
2760:libs/etl/map.h ****           replace->dir = kLeft;
2761:libs/etl/map.h ****         }
2762:libs/etl/map.h ****         else if (node_comp(replace_data_node, key))
2763:libs/etl/map.h ****         {
