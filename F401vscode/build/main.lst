2148:libs/etl/map.h ****           else
2149:libs/etl/map.h ****           {
2150:libs/etl/map.h ****             // Found lowest node
2151:libs/etl/map.h ****             break;
2152:libs/etl/map.h ****           }
2153:libs/etl/map.h ****         }
2154:libs/etl/map.h ****         else if (node_comp(data_node, key))
2155:libs/etl/map.h ****         {
2156:libs/etl/map.h ****           position = position->children[kRight];
2157:libs/etl/map.h ****         }
2158:libs/etl/map.h ****         else
2159:libs/etl/map.h ****         {
2160:libs/etl/map.h ****           // Make note of current position, but keep looking to left for more
2161:libs/etl/map.h ****           lower_node = position;
ARM GAS  C:\Users\subdia\AppData\Local\Temp\ccpTTeXz.s 			page 244


2162:libs/etl/map.h ****           position   = position->children[kLeft];
2163:libs/etl/map.h ****         }
2164:libs/etl/map.h ****       }
2165:libs/etl/map.h **** 
2166:libs/etl/map.h ****       // Return the lower_node position found
2167:libs/etl/map.h ****       return lower_node;
2168:libs/etl/map.h ****     }
