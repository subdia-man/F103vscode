2902:libs/etl/map.h ****           if (replace_parent)
2903:libs/etl/map.h ****           {
2904:libs/etl/map.h ****             detach_node(root_node, replace_parent->children[replace_parent->dir]);
2905:libs/etl/map.h ****           }
2906:libs/etl/map.h ****           else
2907:libs/etl/map.h ****           {
2908:libs/etl/map.h ****             // Target node and replacement node are both root node
2909:libs/etl/map.h ****             detach_node(root_node, root_node);
2910:libs/etl/map.h ****           }
2911:libs/etl/map.h ****         }
