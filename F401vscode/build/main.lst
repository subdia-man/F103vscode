1600:libs/etl/map.h ****     /// Move assignment operator.
1601:libs/etl/map.h ****     //*************************************************************************
1602:libs/etl/map.h ****     imap& operator=(imap&& rhs)
1603:libs/etl/map.h ****     {
1604:libs/etl/map.h ****       // Skip if doing self assignment
1605:libs/etl/map.h ****       if (this != &rhs)
1606:libs/etl/map.h ****       {
1607:libs/etl/map.h ****         this->clear();
1608:libs/etl/map.h **** 
1609:libs/etl/map.h ****         typename etl::imap<TKey, TMapped, TKeyCompare>::iterator from = rhs.begin();
1610:libs/etl/map.h **** 
1611:libs/etl/map.h ****         while (from != rhs.end())
1612:libs/etl/map.h ****         {
1613:libs/etl/map.h ****           this->insert(etl::move(*from));
1614:libs/etl/map.h ****           ++from;
1615:libs/etl/map.h ****         }
1616:libs/etl/map.h ****       }
1617:libs/etl/map.h **** 
1618:libs/etl/map.h ****       return *this;
1619:libs/etl/map.h ****     }
