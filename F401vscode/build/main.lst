2765:libs/etl/map.h ****           replace->dir = kRight;
2766:libs/etl/map.h ****         }
2767:libs/etl/map.h ****         else
2768:libs/etl/map.h ****         {
2769:libs/etl/map.h ****           // Update the direction to the replace node (target node found here)
2770:libs/etl/map.h ****           replace->dir = replace->children[kLeft] ? kLeft : kRight;
2771:libs/etl/map.h **** 
2772:libs/etl/map.h ****           // Note the target node was found (and its parent)
